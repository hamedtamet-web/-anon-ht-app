      <div class="article-icon">${i.icon}</div>
      <div class="article-body">
        <div class="article-cat">${esc(i.cat)}${i.isNew?' 🆕':''}</div>
        <div class="article-title">${esc(i.title)}</div>
        <div class="article-meta"><span>📅 ${esc(i.date)}</span><span>👁️ ${esc(i.views)}</span></div>
      </div>
      <span class="article-arrow">›</span>
    </a>`).join('');
}

