        <input type="text" class="field-input" id="completeName"
          placeholder="الاسم الكامل" maxlength="60" autocomplete="name">
      </div>
      <div class="input-group hidden" id="completePhoneGroup">
        <div class="phone-group">
          <div class="country-selector">
            <div class="country-btn" id="countryBtn2">
              <span class="cflag" id="selectedFlag2">🇪🇬</span>
              <span class="ccode" id="selectedCode2">+20</span>
              <span class="carrow">▾</span>
            </div>
            <div class="country-dropdown" id="countryDropdown2">
              <input class="country-search" id="countrySearch2" type="text" placeholder="ابحث عن دولة...">
              <div id="countryList2"></div>
            </div>
          </div>
          <input type="tel" class="field-input" id="completePhone"
            placeholder="رقم الهاتف" maxlength="15" pattern="[0-9]*" autocomplete="tel">
        </div>
      </div>
      <button class="btn-primary" id="completeBtn" onclick="handleComplete()">حفظ والمتابعة</button>
    </div>

    <!-- إنشاء حساب -->
    <div id="signup-section" class="hidden">
      <div class="card-title">حساب جديد</div>
