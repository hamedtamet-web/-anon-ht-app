      <!-- Privacy -->
      <div class="privacy-wrap" id="privacyWrap" onclick="togglePrivacyCheck()"
        role="checkbox" aria-checked="false" tabindex="0">
        <div class="custom-cb" id="privacyCb"><span class="cb-check">✓</span></div>
        <div class="privacy-text">
          أوافق على <a href="#" onclick="openPrivacyModal(event)">سياسة الخصوصية والشروط</a>
          وأقر بأن بياناتي صحيحة وأنني أعمر 13 سنة أو أكثر
        </div>
      </div>

      <button class="btn-primary" id="signupBtn" onclick="handleSignup()" disabled>إنشاء الحساب</button>
      <div class="switch-area">
        لديك حساب؟ <b onclick="toggleAuth()">سجل دخولك</b>
      </div>
    </div>

    <!-- انتظار التفعيل -->
    <div id="verify-waiting" class="hidden">
