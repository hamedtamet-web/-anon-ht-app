      <div class="input-group">
        <input type="text" class="field-input" id="regName"
          placeholder="الاسم الكامل" required maxlength="60" autocomplete="name">
      </div>
      <div class="input-group">
        <input type="text" class="field-input" id="regUser"
          placeholder="اسم المستخدم (4+ حروف)" required maxlength="30" autocomplete="username">
      </div>
      <div class="input-group">
        <input type="email" class="field-input" id="emailInput"
          placeholder="البريد الإلكتروني" required maxlength="254" autocomplete="email">
      </div>
      <div class="input-group">
        <input type="password" class="field-input" id="regPass"
          placeholder="كلمة المرور (8+ حروف)" required maxlength="128" autocomplete="new-password">
        <div class="strength-bar" aria-hidden="true">
          <span id="sb1"></span><span id="sb2"></span><span id="sb3"></span><span id="sb4"></span>
        </div>
        <div class="strength-label" id="strengthLabel" aria-live="polite"></div>
      </div>
      <div class="input-group">
        <div class="phone-group">
          <div class="country-selector">
            <div class="country-btn" id="countryBtn">
              <span class="cflag" id="selectedFlag">🇪🇬</span>
              <span class="ccode" id="selectedCode">+20</span>
              <span class="carrow">▾</span>
            </div>
            <div class="country-dropdown" id="countryDropdown">
              <input class="country-search" id="countrySearch" type="text" placeholder="ابحث عن دولة...">
              <div id="countryList"></div>
            </div>
          </div>
          <input type="tel" class="field-input" id="regPhone"
            placeholder="رقم الهاتف (إجباري)" maxlength="15" pattern="[0-9]*" required autocomplete="tel">
        </div>
      </div>

      <!-- OTP Section -->
      <div id="otpSection" class="hidden">
        <div style="text-align:center;margin-bottom:13px;">
          <div style="font-size:12.5px;color:#888;margin-bottom:9px;">
            📱 أُرسل كود التحقق إلى <span id="otpPhoneDisplay" style="color:#fff;font-weight:700;"></span>
          </div>
        </div>
        <div class="input-group">
          <input type="text" class="field-input" id="otpInput"
            placeholder="الكود المكوّن من 6 أرقام"
            maxlength="6" pattern="[0-9]*" inputmode="numeric"
            style="text-align:center;letter-spacing:7px;font-size:20px;font-weight:800;">
        </div>
        <div style="text-align:center;margin-bottom:13px;">
          <span style="font-size:11px;color:#444;" id="otpTimer"></span>
          <span id="resendLink" class="hidden"
            style="font-size:11px;color:var(--primary);cursor:pointer;font-weight:700;"
            onclick="resendOTP()">إعادة الإرسال</span>
        </div>
        <button class="btn-primary" id="verifyOtpBtn" onclick="verifyOTP()">تحقق ✅</button>
        <button onclick="cancelOTP()"
          style="width:100%;margin-top:9px;padding:11px;background:none;
          border:1px solid var(--border);border-radius:var(--radius-btn);color:#555;
          font-family:'Cairo',sans-serif;font-size:12.5px;cursor:pointer;transition:var(--tr);"
          onmouseover="this.style.borderColor='rgba(255,255,255,0.14)';this.style.color='#aaa';"
          onmouseout="this.style.borderColor='var(--border)';this.style.color='#555';">
          ← رجوع وتعديل الرقم
        </button>
      </div>
      <div id="recaptcha-container"></div>

      <!-- Birthdate -->
      <div class="input-group">
        <div class="birthdate-picker" id="birthdatePicker">
          <span style="font-size:16px;">🎂</span>
          <div class="bd-col">
            <div class="bd-arrow" onclick="bdChange('day',1)">▲</div>
            <div class="bd-val" id="bdDay">01</div>
            <div class="bd-arrow" onclick="bdChange('day',-1)">▼</div>
          </div>
          <span class="bd-sep">/</span>
          <div class="bd-col">
            <div class="bd-arrow" onclick="bdChange('month',1)">▲</div>
            <div class="bd-val" id="bdMonth">01</div>
            <div class="bd-arrow" onclick="bdChange('month',-1)">▼</div>
          </div>
          <span class="bd-sep">/</span>
          <div class="bd-col year-col">
            <div class="bd-arrow" onclick="bdChange('year',1)">▲</div>
            <div class="bd-val year-val" id="bdYear">2000</div>
            <div class="bd-arrow" onclick="bdChange('year',-1)">▼</div>
          </div>
        </div>
        <div class="bd-age-label" id="bdAgeLabel" aria-live="polite"></div>
      </div>

      <!-- Gender -->
      <div class="input-group">
        <div class="select-wrap">
          <select id="regGender" class="field-select" required>
            <option value="" disabled selected>الجنس</option>
            <option value="male">ذكر</option>
            <option value="female">أنثى</option>
            <option value="other">أفضل عدم الإفصاح</option>
          </select>
        </div>
      </div>

      <!-- Language -->
      <div class="input-group">
        <div class="select-wrap">
          <select id="regLang" class="field-select">
            <option value="ar">🇸🇦 العربية</option>
            <option value="en">🇬🇧 English</option>
            <option value="fr">🇫🇷 Français</option>
            <option value="es">🇪🇸 Español</option>
            <option value="tr">🇹🇷 Türkçe</option>
