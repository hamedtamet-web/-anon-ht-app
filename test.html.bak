<!-- Firebase (placeholder — replace with your config) -->
<script>
/* ══════════════════════════════════════
   FIREBASE PLACEHOLDER
   Replace APP_CONFIG with your actual config
══════════════════════════════════════ */
if (typeof APP_CONFIG === 'undefined') {
  window.APP_CONFIG = {
    firebase: {
      apiKey: "YOUR_API_KEY",
      authDomain: "YOUR_AUTH_DOMAIN",
      projectId: "YOUR_PROJECT_ID",
      storageBucket: "YOUR_STORAGE_BUCKET",
      messagingSenderId: "YOUR_SENDER_ID",
      appId: "YOUR_APP_ID"
    }
  };
}
</script>

<script>
'use strict';

/* ══════════════════════════════════════
   HELPERS
══════════════════════════════════════ */
const cleanInput = v => typeof v !== 'string' ? '' : v.trim().slice(0,200).replace(/[<>'"\\\/\x00-\x1F\x7F]/g,'');
const esc = s => String(s||'').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;').replace(/'/g,'&#039;');
const pad2 = n => String(n).padStart(2,'0');
const fmtTime = d => d ? d.toLocaleTimeString('ar',{hour:'2-digit',minute:'2-digit'}) : '';

const BLOCKED_DOMAINS = new Set(['mailinator.com','guerrillamail.com','trashmail.com','tempmail.com','temp-mail.org','yopmail.com','fakeinbox.com','mailsac.com','10minutemail.com','throwaway.email','discard.email']);
const ALLOWED_DOMAINS = new Set(['gmail.com','googlemail.com','outlook.com','outlook.sa','outlook.ae','hotmail.com','hotmail.co.uk','hotmail.fr','live.com','yahoo.com','yahoo.co.uk','yahoo.fr','icloud.com','me.com','mac.com','proton.me','protonmail.com','pm.me','zoho.com','mail.ru','yandex.ru','yandex.com','gmx.com','gmx.net','aol.com','qq.com','163.com','126.com','naver.com','tutanota.com','fastmail.com','maktoob.com']);

function isValidEmail(e) {
  if (!e || e.length > 254) return false;
  if (!/^[^\s@]{1,64}@[^\s@]{1,253}\.[^\s@]{2,}$/.test(e)) return false;
  const domain = e.split('@')[1]?.toLowerCase();
  if (!domain) return false;
  if (BLOCKED_DOMAINS.has(domain)) return false;
  if (!ALLOWED_DOMAINS.has(domain)) return false;
  return true;
}

function genderEmoji(g) {
  if (!g) return '👤';
  if (g==='ذكر'||g==='male') return '👦';
  if (g==='أنثى'||g==='female') return '👧';
  return '🌀';
}
function genderClass(g) {
  if (!g) return 'other';
  if (g==='ذكر'||g==='male') return 'male';
  if (g==='أنثى'||g==='female') return 'female';
  return 'other';
}

/* ══ TOAST ══ */
let _toastTimer = null;
function showToast(msg, type='error', duration=3200) {
  const icons  = {error:'⛔',success:'✅',info:'💡'};
  const colors = {error:'#f80566',success:'#4ade80',info:'#60a5fa'};
  const toast  = document.getElementById('toast');
  toast.className = `show t-${type}`;
  document.getElementById('toastText').textContent = msg;
  document.querySelector('#toast .t-icon').textContent = icons[type]||'ℹ️';
  const bar = document.getElementById('toastBar');
  bar.style.background = colors[type]||'#f80566';
  bar.style.animation  = 'none'; bar.offsetHeight;
  bar.style.animation  = `shrink ${duration/1000}s linear forwards`;
  if (_toastTimer) clearTimeout(_toastTimer);
  _toastTimer = setTimeout(()=>toast.classList.remove('show'), duration);
}

/* ══ PRIVACY MODAL ══ */
let _privacyAccepted = false;
function openPrivacyModal(e) {
  if(e) e.preventDefault();
  document.getElementById('privacyModal').classList.add('open');
  document.body.style.overflow = 'hidden';
}
function closePrivacyModal() {
  document.getElementById('privacyModal').classList.remove('open');
  document.body.style.overflow = '';
}
function acceptPrivacy() {
  _privacyAccepted = true;
  document.getElementById('privacyCb').classList.add('checked');
  document.getElementById('privacyWrap').classList.add('checked');
  document.getElementById('privacyWrap').setAttribute('aria-checked','true');
  const btn = document.getElementById('signupBtn');
  if(btn) btn.disabled = false;
  closePrivacyModal();
  showToast('تم القبول ✅','success',2000);
}
function togglePrivacyCheck() {
  if(!_privacyAccepted){ openPrivacyModal(null); return; }
  _privacyAccepted = !_privacyAccepted;
  document.getElementById('privacyCb').classList.toggle('checked',_privacyAccepted);
  document.getElementById('privacyWrap').classList.toggle('checked',_privacyAccepted);
  document.getElementById('privacyWrap').setAttribute('aria-checked',String(_privacyAccepted));
  document.getElementById('signupBtn').disabled = !_privacyAccepted;
}
document.getElementById('privacyModal').addEventListener('click',e=>{if(e.target===e.currentTarget)closePrivacyModal();});
document.getElementById('privacyWrap').addEventListener('keydown',e=>{if(e.key===' '||e.key==='Enter'){e.preventDefault();togglePrivacyCheck();}});

/* ══ LANG SWITCHER ══ */
function toggleLangMenu() {
  const menu=document.getElementById('langMenu');
  const btn=document.getElementById('langActiveBtn');
  const open=menu.classList.contains('open');
  menu.classList.toggle('open',!open);
  btn.classList.toggle('open',!open);
}
function selectLang(lang) {
  document.getElementById('langMenu')?.classList.remove('open');
  document.getElementById('langActiveBtn')?.classList.remove('open');
  const labels={ar:'AR',en:'EN',fr:'FR',es:'ES',tr:'TR',de:'DE',ru:'RU',zh:'ZH',hi:'HI',pt:'PT'};
  document.getElementById('langCurrentLabel').textContent = labels[lang]||lang.toUpperCase();
  document.querySelectorAll('[id^="check-"]').forEach(el=>el.textContent='');
  const chk=document.getElementById('check-'+lang);
  if(chk) chk.textContent='✓';
  const isRtl=['ar'].includes(lang);
  document.getElementById('htmlTag').dir=isRtl?'rtl':'ltr';
  document.getElementById('htmlTag').lang=lang;
  localStorage.setItem('anon_lang',lang);
}
document.addEventListener('click',e=>{
  if(!e.target.closest('#langSwitcher')){
    document.getElementById('langMenu')?.classList.remove('open');
    document.getElementById('langActiveBtn')?.classList.remove('open');
  }
});

/* ══ RATE LIMIT ══ */
const RATE_LIMIT = {
  maxAttempts:5, windowMs:15*60*1000,
  check(a){
    const key='rl_'+a;
    let d=JSON.parse(localStorage.getItem(key)||'{"count":0,"resetAt":0}');
    const now=Date.now();
    if(now>d.resetAt) d={count:0,resetAt:now+this.windowMs};
    if(d.count>=this.maxAttempts) return{allowed:false,mins:Math.ceil((d.resetAt-now)/60000)};
    return{allowed:true};
  },
  increment(a){
    const key='rl_'+a;
    let d=JSON.parse(localStorage.getItem(key)||'{"count":0,"resetAt":0}');
    const now=Date.now();
    if(now>d.resetAt) d={count:0,resetAt:now+this.windowMs};
    d.count++; localStorage.setItem(key,JSON.stringify(d));
  },
  reset:a=>localStorage.removeItem('rl_'+a)
};

/* ══ COUNTRIES ══ */
const COUNTRIES=[
  {name:"مصر",flag:"🇪🇬",code:"+20"},{name:"السعودية",flag:"🇸🇦",code:"+966"},
  {name:"الإمارات",flag:"🇦🇪",code:"+971"},{name:"الكويت",flag:"🇰🇼",code:"+965"},
  {name:"قطر",flag:"🇶🇦",code:"+974"},{name:"البحرين",flag:"🇧🇭",code:"+973"},
  {name:"عمان",flag:"🇴🇲",code:"+968"},{name:"الأردن",flag:"🇯🇴",code:"+962"},
  {name:"لبنان",flag:"🇱🇧",code:"+961"},{name:"العراق",flag:"🇮🇶",code:"+964"},
  {name:"سوريا",flag:"🇸🇾",code:"+963"},{name:"فلسطين",flag:"🇵🇸",code:"+970"},
  {name:"اليمن",flag:"🇾🇪",code:"+967"},{name:"ليبيا",flag:"🇱🇾",code:"+218"},
  {name:"تونس",flag:"🇹🇳",code:"+216"},{name:"الجزائر",flag:"🇩🇿",code:"+213"},
  {name:"المغرب",flag:"🇲🇦",code:"+212"},{name:"السودان",flag:"🇸🇩",code:"+249"},
  {name:"تركيا",flag:"🇹🇷",code:"+90"},{name:"باكستان",flag:"🇵🇰",code:"+92"},
  {name:"الهند",flag:"🇮🇳",code:"+91"},{name:"المملكة المتحدة",flag:"🇬🇧",code:"+44"},
  {name:"الولايات المتحدة",flag:"🇺🇸",code:"+1"},{name:"فرنسا",flag:"🇫🇷",code:"+33"},
  {name:"المانيا",flag:"🇩🇪",code:"+49"},{name:"روسيا",flag:"🇷🇺",code:"+7"},
  {name:"الصين",flag:"🇨🇳",code:"+86"},{name:"اليابان",flag:"🇯🇵",code:"+81"},
  {name:"البرازيل",flag:"🇧🇷",code:"+55"},{name:"إيران",flag:"🇮🇷",code:"+98"},
];
let selectedDial='+20', selectedDial2='+20';

function renderCountries(list,containerId){
  document.getElementById(containerId).innerHTML=list.map(c=>
    `<div class="country-item" data-flag="${esc(c.flag)}" data-code="${esc(c.code)}">
      <span class="ci-flag">${esc(c.flag)}</span>
      <span class="ci-name">${esc(c.name)}</span>
      <span class="ci-dial" dir="ltr">${esc(c.code)}</span>
    </div>`
  ).join('');
}

function setupCountrySelector(btnId,ddId,searchId,listId,flagId,codeId,isPrimary){
  const btn=document.getElementById(btnId);
  const dd=document.getElementById(ddId);
  btn.addEventListener('click',e=>{
    e.stopPropagation();
    const open=dd.classList.contains('open');
    document.querySelectorAll('.country-dropdown').forEach(el=>el.classList.remove('open'));
    document.querySelectorAll('.country-btn').forEach(el=>el.classList.remove('open'));
    if(!open){
      dd.classList.add('open'); btn.classList.add('open');
      document.getElementById(searchId).value='';
      renderCountries(COUNTRIES,listId);
      setTimeout(()=>document.getElementById(searchId).focus(),70);
    }
  });
  document.getElementById(searchId).addEventListener('input',function(){
    const q=this.value.trim().toLowerCase();
    renderCountries(q?COUNTRIES.filter(c=>c.name.includes(q)||c.code.includes(q)):COUNTRIES,listId);
  });
  document.getElementById(listId).addEventListener('click',e=>{
    const item=e.target.closest('.country-item');
    if(!item) return;
    const code=item.dataset.code, flag=item.dataset.flag;
    if(isPrimary) selectedDial=code; else selectedDial2=code;
    document.getElementById(flagId).textContent=flag;
    document.getElementById(codeId).textContent=code;
    dd.classList.remove('open'); btn.classList.remove('open');
  });
}
document.addEventListener('click',e=>{
  if(!e.target.closest('.country-selector')){
    document.querySelectorAll('.country-dropdown').forEach(el=>el.classList.remove('open'));
    document.querySelectorAll('.country-btn').forEach(el=>el.classList.remove('open'));
  }
});
setupCountrySelector('countryBtn','countryDropdown','countrySearch','countryList','selectedFlag','selectedCode',true);
setupCountrySelector('countryBtn2','countryDropdown2','countrySearch2','countryList2','selectedFlag2','selectedCode2',false);
renderCountries(COUNTRIES,'countryList');
renderCountries(COUNTRIES,'countryList2');

/* ══ PASSWORD STRENGTH ══ */
let _lastPassVal='';
function updateStrengthLabel(){
  const val=_lastPassVal;
  if(!val){document.getElementById('strengthLabel').textContent='';return;}
  let s=0;
  if(val.length>=8)s++; if(/[A-Z]/.test(val))s++; if(/[0-9]/.test(val))s++; if(/[^A-Za-z0-9]/.test(val))s++;
  const labels=['ضعيفة جداً','ضعيفة','متوسطة','قوية'];
  document.getElementById('strengthLabel').textContent='قوة كلمة المرور: '+(labels[s-1]||labels[0]);
}
document.getElementById('regPass').addEventListener('input',function(){
  _lastPassVal=this.value;
  let s=0;
  if(this.value.length>=8)s++; if(/[A-Z]/.test(this.value))s++; if(/[0-9]/.test(this.value))s++; if(/[^A-Za-z0-9]/.test(this.value))s++;
  const colors=['#f80566','#ff6b35','#ffd166','#4ade80'];
  for(let i=1;i<=4;i++) document.getElementById('sb'+i).style.background=i<=s?colors[s-1]:'rgba(255,255,255,0.07)';
  updateStrengthLabel();
});

/* ══ BIRTHDATE PICKER ══ */
let _bdDay=1,_bdMonth=1,_bdYear=2000;
function bdDaysInMonth(m,y){return new Date(y,m,0).getDate();}
function bdChange(field,delta){
  const maxYear=new Date().getFullYear()-13;
  if(field==='day'){
    const maxDay=bdDaysInMonth(_bdMonth,_bdYear);
    _bdDay+=delta;
    if(_bdDay<1)_bdDay=maxDay; if(_bdDay>maxDay)_bdDay=1;
  } else if(field==='month'){
    _bdMonth+=delta;
    if(_bdMonth<1)_bdMonth=12; if(_bdMonth>12)_bdMonth=1;
    const maxDay=bdDaysInMonth(_bdMonth,_bdYear);
    if(_bdDay>maxDay)_bdDay=maxDay;
  } else if(field==='year'){
    _bdYear+=delta;
    if(_bdYear<1950)_bdYear=1950; if(_bdYear>maxYear)_bdYear=maxYear;
  }
  document.getElementById('bdDay').textContent=pad2(_bdDay);
  document.getElementById('bdMonth').textContent=pad2(_bdMonth);
  document.getElementById('bdYear').textContent=_bdYear;
  updateBdAgeLabel();
}
function getBdAge(){
  const today=new Date();
  let age=today.getFullYear()-_bdYear;
  const m=today.getMonth()+1-_bdMonth;
  if(m<0||(m===0&&today.getDate()<_bdDay)) age--;
  return age;
}
function getBirthdateString(){return `${_bdYear}-${pad2(_bdMonth)}-${pad2(_bdDay)}`;}
function updateBdAgeLabel(){
  const age=getBdAge();
  const el=document.getElementById('bdAgeLabel');
  if(!el) return;
  if(age<13){el.textContent='⚠️ يجب أن تكون 13 سنة أو أكثر';el.style.color='#f80566';}
  else{el.textContent=`✅ عمرك ${age} سنة`;el.style.color='#4ade80';}
}

