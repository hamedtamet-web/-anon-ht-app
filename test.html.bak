  const rankIcons=['🥇','🥈','🥉'];
  feed.innerHTML=demos.map((d,i)=>`
    <div class="answer-card" onclick="showToast('سجل دخولك للتفاعل 🔐','info',2500)">
      <div class="answer-top">
        <div class="answer-rank ${i===0?'r1':i===1?'r2':'r3'}">${rankIcons[i]}</div>
        <div class="answer-avatar">${genderEmoji(d.gender)}</div>
        <div class="answer-user-info">
          <div class="answer-username">${esc(d.name)}</div>
          <div class="answer-time">@${esc(d.uname)} · ${esc(d.ago)}</div>
        </div>
        <div class="answer-likes-big">❤️ ${d.likes}<span>إعجاب</span></div>
      </div>
      <div class="answer-question">${esc(d.q)}</div>
      <div class="answer-text">${esc(d.a)}</div>
      <div class="answer-footer">
        <span style="font-size:10.5px;color:#444;">🔥 الأكثر تفاعلاً</span>
        <div class="answer-join">✨ انضم وتفاعل</div>
      </div>
    </div>`).join('');
}

/* ══ KEYBOARD ══ */
document.getElementById('loginPass').addEventListener('keydown',e=>{if(e.key==='Enter')handleLogin();});
document.getElementById('loginEmail').addEventListener('keydown',e=>{if(e.key==='Enter')document.getElementById('loginPass').focus();});

/* ══ OTP STUBS ══ */
let _otpTimer=null,_otpSeconds=60;
function setupRecaptcha(){ /* wire to firebase.auth.RecaptchaVerifier */ }
async function sendOTP(){showToast('ربط Firebase مطلوب لإرسال OTP','info');}
function startOtpTimer(){
  _otpSeconds=60;
  if(_otpTimer) clearInterval(_otpTimer);
  document.getElementById('resendLink').classList.add('hidden');
  _otpTimer=setInterval(()=>{
    _otpSeconds--;
    const el=document.getElementById('otpTimer');
    if(el) el.textContent=`إعادة الإرسال بعد ${_otpSeconds} ثانية`;
    if(_otpSeconds<=0){clearInterval(_otpTimer);if(el)el.textContent='';document.getElementById('resendLink').classList.remove('hidden');}
  },1000);
}
async function resendOTP(){document.getElementById('resendLink').classList.add('hidden'); await sendOTP();}
async function verifyOTP(){showToast('ربط Firebase مطلوب للتحقق','info');}
function cancelOTP(){
  if(_otpTimer) clearInterval(_otpTimer);
  document.getElementById('otpSection').classList.add('hidden');
  document.querySelectorAll('#signup-section .input-group:not(#otpSection .input-group),#signup-section .privacy-wrap').forEach(el=>el.classList.remove('hidden'));
  const btn=document.getElementById('signupBtn');
  btn.classList.remove('hidden'); btn.disabled=!_privacyAccepted; btn.textContent='إنشاء الحساب';
  document.querySelector('#signup-section .switch-area')?.classList.remove('hidden');
}

/* ══ INIT ══ */
window.addEventListener('load',()=>{
  updateBdAgeLabel();
  loadArticles();
  loadLiveAnswers();
  const savedLang=localStorage.getItem('anon_lang')||'ar';
  if(savedLang!=='ar') selectLang(savedLang);
  else selectLang('ar');

  // Simulate online count
  let baseOnline = 127 + Math.floor(Math.random()*40);
  document.getElementById('onlineCount').textContent = baseOnline;
  setInterval(()=>{
    baseOnline += Math.random()>0.5 ? Math.floor(Math.random()*3)+1 : -(Math.floor(Math.random()*2)+1);
    baseOnline = Math.max(80, Math.min(300, baseOnline));
    document.getElementById('onlineCount').textContent = baseOnline;
  }, 4000);

  // Wire to Firebase if available:
  // if (typeof firebase !== 'undefined' && typeof APP_CONFIG !== 'undefined') {
  //   firebase.initializeApp(APP_CONFIG.firebase);
  //   const db   = firebase.firestore();
  //   const auth = firebase.auth();
  //   // ... your existing firebase logic
  // }
});
</script>
</body>
</html>