/* ══ MAINTENANCE ══ */
let _maintInterval=null,_maintEndTime=null,_maintStart=null;
function applyMaintenanceMode(data){
  const durationMin=data.maintenanceDuration||60;
  const startedAt=data.maintenanceStartedAt;
  if(startedAt?.toDate){_maintStart=startedAt.toDate().getTime();_maintEndTime=_maintStart+durationMin*60*1000;}
  else{_maintEndTime=Date.now()+durationMin*60*1000;_maintStart=Date.now();}
  document.getElementById('maintTitle').textContent=data.maintenanceTitle||'الموقع في وضع الصيانة';
  document.getElementById('maintMsg').textContent=data.maintenanceMsg||'نعمل على تحسين تجربتك. سنعود قريباً!';
  document.getElementById('maintenanceBanner').classList.remove('hidden');
  document.getElementById('authCard').style.display='none';
  startMaintCountdown();
}
function startMaintCountdown(){
  if(_maintInterval) clearInterval(_maintInterval);
  function tick(){
    const now=Date.now(), left=Math.max(0,_maintEndTime-now), total=Math.max(1,_maintEndTime-_maintStart);
    document.getElementById('maintProgressFill').style.width=Math.min(100,((total-left)/total)*100)+'%';
    document.getElementById('maintHH').textContent=String(Math.floor(left/3600000)).padStart(2,'0');
    document.getElementById('maintMM').textContent=String(Math.floor((left%3600000)/60000)).padStart(2,'0');
    document.getElementById('maintSS').textContent=String(Math.floor((left%60000)/1000)).padStart(2,'0');
    if(left<=0){clearInterval(_maintInterval);setTimeout(()=>location.reload(),3000);}
  }
  tick(); _maintInterval=setInterval(tick,1000);
}
function showAdminLoginFromMaint(){
  document.getElementById('maintenanceBanner').classList.add('hidden');
  document.getElementById('authCard').style.display='';
  document.getElementById('signin-section').classList.remove('hidden');
  showToast('دخول المشرف','info');
}

/* ══ CHAT INTERFACE (UI Only - wire up to your Firebase) ══ */
let _chatPeer = {nick:'', age:'', gender:''};
let _typingTimer = null;
const BANNED_WORDS = ['سكس','جنس','نيك','زب','كس','شرموطة','sex','porn','fuck','shit','bitch'];
function hasBannedWord(txt){
  const clean=txt.toLowerCase().replace(/\s+/g,'');
  return BANNED_WORDS.some(w=>clean.includes(w.replace(/\s+/g,'')));
}

function openChat(peerNick, peerAge, peerGender) {
  _chatPeer = {nick:peerNick||'مجهول', age:peerAge||'', gender:peerGender||''};
  const avWrap = document.getElementById('chatAvWrap');
  const avEmoji = document.getElementById('chatAvEmoji');
  const gClass  = peerGender==='female'?'female':peerGender==='male'?'male':'other';
  avWrap.className = `chat-av-wrap ${gClass}`;
  avEmoji.textContent = genderEmoji(peerGender);
  document.getElementById('chatPeerName').textContent = peerNick||'مجهول';
  document.getElementById('chatPeerMeta').textContent = [peerAge,peerGender].filter(Boolean).join(' • ');
  const area = document.getElementById('msgsArea');
  area.innerHTML = `
    <div class="msg-sys">🔒 محادثة مجهولة آمنة — هويتك محمية بالكامل</div>
    <div class="typing-bubble" id="typingBubble">
      <div class="typing-dots"><span></span><span></span><span></span></div>
    </div>`;
  document.getElementById('discBanner').style.display='none';
  document.getElementById('chatInput').disabled=false;
  document.getElementById('chatOverlay').classList.add('open');
  document.body.style.overflow='hidden';
  document.getElementById('chatInput').focus();
}

function leaveChat(){
  document.getElementById('chatOverlay').classList.remove('open');
  document.body.style.overflow='';
  showToast('غادرت المحادثة','info',2000);
}

function addBubble(text,type,date){
  const area=document.getElementById('msgsArea');
  const tb=document.getElementById('typingBubble');
  const div=document.createElement('div');
  div.className=`bubble ${type}`;
  div.innerHTML=`${esc(text)}<div class="bubble-time">${fmtTime(date||new Date())}</div>`;
  if(tb) area.insertBefore(div,tb); else area.appendChild(div);
  scrollMsgs();
}
function addSysMsg(text){
  const area=document.getElementById('msgsArea');
  const tb=document.getElementById('typingBubble');
  const div=document.createElement('div');
  div.className='msg-sys'; div.textContent=text;
  if(tb) area.insertBefore(div,tb); else area.appendChild(div);
  scrollMsgs();
}
function scrollMsgs(){
  const a=document.getElementById('msgsArea');
  if(a) setTimeout(()=>{a.scrollTop=a.scrollHeight;},40);
}

function sendMsg(){
  const inp=document.getElementById('chatInput');
  const text=inp.value.trim();
  if(!text) return;
  if(hasBannedWord(text)){
    addSysMsg('⚠️ رسالتك تحتوي على محتوى مخالف');
    inp.value=''; return;
  }
  addBubble(text,'mine',new Date());
  inp.value=''; inp.style.height='auto';
  // wire to your firebase: db.collection('randomChats').doc(chatId).collection('messages').add(...)
}

function onTyping(){
  const inp=document.getElementById('chatInput');
  inp.style.height='auto';
  inp.style.height=Math.min(inp.scrollHeight,90)+'px';
  clearTimeout(_typingTimer);
  _typingTimer=setTimeout(()=>{},2000);
}

function onChatKey(e){
  if(e.key==='Enter'&&!e.shiftKey){e.preventDefault();sendMsg();}
}

function openChatReport(){showToast('تم تسجيل البلاغ 🚩','success',2500);}
function openChatBlock(){
  if(confirm('هل تريد حظر هذا المستخدم؟')){
    showToast('🚫 تم الحظر بنجاح','success',2500);
    setTimeout(()=>leaveChat(),800);
  }
}

