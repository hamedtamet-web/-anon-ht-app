#!/usr/bin/env python3
import os, shutil, datetime

FILENAME = "thread.html"   # غيّر ده لاسم الملف الفعلي عندك

path = FILENAME
if not os.path.exists(path):
    print(f"❌ الملف {path} غير موجود — تأكد من المسار/الاسم")
    raise SystemExit(1)

backup = f"{path}.bak.{datetime.datetime.now().strftime('%Y%m%d_%H%M%S')}"
shutil.copy(path, backup)
print(f"✅ نسخة احتياطية: {backup}")

with open(path, "r", encoding="utf-8") as f:
    content = f.read()

edits = []

# ============================================================
# 1) CSS: استبدال فقاعات q-bubble / a-bubble بفقاعات الشات الجديدة
# ============================================================
old1 = """        .q-bubble {
            background: rgba(255,255,255,0.04); border-radius: 14px;
            padding: 14px 16px; margin-bottom: 14px; border: 1px solid var(--border);
        }
        .q-label {
            font-size: 9px; font-weight: 800; color: var(--text-muted);
            letter-spacing: 1.2px; text-transform: uppercase; margin-bottom: 7px;
            display: flex; align-items: center; gap: 5px;
        }
        .q-label::before { content:''; width:3px; height:3px; border-radius:50%; background:var(--text-muted); }
        .question-text { font-size: 15px; font-weight: 600; line-height: 1.8; color: var(--text); }
        .a-bubble {
            background: var(--primary-dim); border: 1px solid var(--primary-glow);
            border-radius: 14px; padding: 14px 16px; margin-bottom: 14px;
        }
        .a-label {
            font-size: 9px; font-weight: 800; color: var(--primary);
            letter-spacing: 1.2px; text-transform: uppercase; margin-bottom: 7px;
            display: flex; align-items: center; gap: 5px;
        }
        .answer-text { font-size: 15px; font-weight: 600; line-height: 1.8; color: var(--text); }"""

new1 = """        .msg-time {
            font-size: 10px; color: var(--text-muted); margin-bottom: 6px;
        }
        .msg-row {
            display: flex; padding: 0 14px; margin-top: 14px;
            animation: fadeUp 0.22s ease;
        }
        .msg-row.self  { justify-content: flex-start; }
        .msg-row.other { justify-content: flex-end; }
        .msg-group { max-width: 78%; display: flex; flex-direction: column; }
        .msg-head { display: flex; align-items: center; gap: 7px; margin-bottom: 6px; }
        .msg-avatar {
            width: 26px; height: 26px; border-radius: 50%; flex-shrink: 0; overflow: hidden;
            background: var(--surface2); border: 1px solid var(--border-strong);
            display: flex; align-items: center; justify-content: center;
            font-size: 10px; font-weight: 700; color: var(--text-sub);
        }
        .msg-avatar img { width:100%; height:100%; object-fit:cover; border-radius:50%; }
        .msg-uname { font-size: 11px; font-weight: 700; color: var(--text-sub); display:flex; align-items:center; gap:4px; }
        .msg-bubble {
            padding: 11px 15px; font-size: 14px; font-weight: 600;
            line-height: 1.75; word-wrap: break-word;
        }
        .msg-bubble.self {
            background: var(--primary); color: #fff;
            border-radius: 16px 16px 4px 16px;
        }
        .msg-bubble.other {
            background: var(--surface2); border: 1px solid var(--border-strong);
            color: var(--text); border-radius: 16px 16px 16px 4px;
        }
        .msg-foot { display: flex; align-items: center; gap: 12px; margin-top: 6px; }"""

edits.append(("CSS فقاعات السؤال/الإجابة", old1, new1))

