    <style>
        :root {
            --primary:#f80566; --bg:#050505; --card:#0d0d0d;
            --border:rgba(255,255,255,0.06); --admin-red:#ff002b;
            --verify-blue:#00bfff; --text-gray:#888; --max-width:700px;
        }
        *{box-sizing:border-box;-webkit-tap-highlight-color:transparent;outline:none;}
        body{background:var(--bg);color:white;font-family:'Cairo',sans-serif;margin:0;padding-bottom:100px;overflow-x:hidden;position:relative;}

        /* Modal */
        .modal-overlay{position:fixed;inset:0;background:rgba(0,0,0,0.85);backdrop-filter:blur(10px);display:none;align-items:center;justify-content:center;z-index:10000;padding:20px;}
        .custom-modal{background:var(--card);border:1px solid var(--border);border-radius:24px;width:100%;max-width:380px;padding:30px;text-align:center;animation:modalPop 0.3s cubic-bezier(0.175,0.885,0.32,1.275);}
        .modal-title{font-size:15px;font-weight:800;margin-bottom:20px;color:#fff;}
        .modal-input{width:100%;background:rgba(255,255,255,0.05);border:1px solid var(--border);border-radius:12px;padding:12px;color:white;font-family:'Cairo';margin-bottom:20px;text-align:center;}
        .modal-btns{display:flex;gap:12px;}
        .m-btn{flex:1;padding:12px;border-radius:12px;border:none;font-family:'Cairo';font-weight:700;cursor:pointer;font-size:13px;}
        .m-confirm{background:var(--primary);color:white;}
        .m-cancel{background:rgba(255,255,255,0.08);color:#888;}

        /* PWA Banner */
        #pwa-install-banner{position:fixed;bottom:80px;left:50%;transform:translateX(-50%);width:calc(100% - 30px);max-width:420px;background:linear-gradient(135deg,#1a1a1a,#111);border:1px solid rgba(248,5,102,0.4);border-radius:22px;padding:16px 18px;display:none;align-items:center;gap:14px;z-index:9998;box-shadow:0 8px 30px rgba(248,5,102,0.2);animation:slideUpBanner 0.4s cubic-bezier(0.175,0.885,0.32,1.275);}
        #pwa-install-banner .pwa-logo{width:48px;height:48px;border-radius:14px;flex-shrink:0;border:2px solid rgba(248,5,102,0.3);}
        #pwa-install-banner .pwa-text{flex:1;}
        #pwa-install-banner .pwa-text strong{display:block;font-size:13px;font-weight:800;color:#fff;margin-bottom:3px;}
        #pwa-install-banner .pwa-text span{font-size:11px;color:#888;}
        #pwa-install-banner .pwa-actions{display:flex;flex-direction:column;gap:7px;flex-shrink:0;}
        #pwa-install-btn{background:var(--primary);color:white;border:none;border-radius:12px;padding:9px 16px;font-family:'Cairo';font-size:12px;font-weight:800;cursor:pointer;white-space:nowrap;}
        #pwa-dismiss-btn{background:rgba(255,255,255,0.06);color:#666;border:none;border-radius:10px;padding:7px 12px;font-family:'Cairo';font-size:11px;font-weight:700;cursor:pointer;}

        /* iOS Banner */
        #ios-install-banner{position:fixed;bottom:80px;left:50%;transform:translateX(-50%);width:calc(100% - 30px);max-width:420px;background:linear-gradient(135deg,#1a1a1a,#111);border:1px solid rgba(248,5,102,0.4);border-radius:22px;padding:18px;display:none;flex-direction:column;gap:10px;z-index:9998;box-shadow:0 8px 30px rgba(248,5,102,0.2);animation:slideUpBanner 0.4s cubic-bezier(0.175,0.885,0.32,1.275);text-align:center;}
        #ios-install-banner .ios-title{font-size:13px;font-weight:800;color:#fff;}
        #ios-install-banner .ios-steps{font-size:12px;color:#aaa;line-height:1.8;}
        #ios-install-banner .ios-steps i{color:var(--primary);}
        #ios-dismiss-btn{background:rgba(255,255,255,0.06);color:#666;border:none;border-radius:10px;padding:8px;font-family:'Cairo';font-size:12px;font-weight:700;cursor:pointer;width:100%;}

        @keyframes slideUpBanner{from{opacity:0;transform:translateX(-50%) translateY(20px);}to{opacity:1;transform:translateX(-50%) translateY(0);}}

        /* Header */
        header{padding:12px 4%;display:flex;align-items:center;gap:12px;position:sticky;top:0;z-index:1000;background:rgba(5,5,5,0.85);backdrop-filter:blur(25px);border-bottom:1px solid var(--border);}
        .header-content{max-width:var(--max-width);margin:0 auto;width:100%;display:flex;align-items:center;gap:12px;position:relative;}

        /* Lang Select */
        .lang-select-global{background:rgba(255,255,255,0.05);border:1px solid var(--border);color:white;padding:5px 10px;border-radius:50px;font-size:11px;font-weight:700;cursor:pointer;font-family:'Cairo';}

        /* Search */
        .search-container{flex:1;position:relative;display:flex;align-items:center;}
        .search-input{width:100%;background:rgba(255,255,255,0.05);border:1px solid var(--border);border-radius:15px;padding:10px 35px 10px 12px;color:white;font-family:'Cairo';font-size:13px;transition:0.3s;}
        .search-input:focus{border-color:var(--primary);background:rgba(255,255,255,0.08);}
        .search-icon{position:absolute;right:12px;color:var(--text-gray);font-size:13px;}

        /* Notif */
        .notif-dropdown{position:absolute;top:55px;left:0;width:280px;background:var(--card);border:1px solid var(--border);border-radius:20px;display:none;flex-direction:column;box-shadow:0 15px 35px rgba(0,0,0,0.5);z-index:2000;overflow:hidden;animation:modalPop 0.2s ease;}
        .notif-item{padding:12px 15px;border-bottom:1px solid var(--border);display:flex;align-items:center;gap:10px;cursor:pointer;transition:0.2s;}
        .notif-item:hover{background:rgba(255,255,255,0.03);}
        .notif-item .n-icon{width:35px;height:35px;border-radius:50%;background:rgba(248,5,102,0.1);color:var(--primary);display:flex;align-items:center;justify-content:center;font-size:14px;flex-shrink:0;}
        .notif-item .n-icon.follow-icon{background:rgba(0,191,255,0.1);color:var(--verify-blue);}
        .notif-text{font-size:11px;color:#ccc;line-height:1.4;overflow:hidden;text-overflow:ellipsis;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;}
        .notif-more{padding:12px;text-align:center;font-size:12px;font-weight:700;color:var(--primary);background:rgba(255,255,255,0.02);text-decoration:none;display:block;}

        /* Feed */
        .feed-container{max-width:var(--max-width);margin:20px auto;padding:0 15px;position:relative;z-index:5;}
        .ans-card{background:linear-gradient(145deg,rgba(248,5,102,0.04),rgba(13,13,13,0.9));border-radius:24px;padding:22px;margin-bottom:20px;border:1px solid rgba(248,5,102,0.15);animation:slideIn 0.4s ease;position:relative;overflow:visible;box-shadow:0 4px 20px rgba(248,5,102,0.06);transition:all 0.3s cubic-bezier(0.4,0,0.2,1);}
.ans-card:hover{border-color:rgba(248,5,102,0.35);box-shadow:0 8px 30px rgba(248,5,102,0.18);transform:translateY(-2px);}
        .ans-card.dev-glow{border-color:rgba(255,0,43,0.3);box-shadow:0 0 20px rgba(255,0,43,0.15);}
        .ans-card.user-glow{border-color:rgba(0,191,255,0.3);box-shadow:0 0 20px rgba(0,191,255,0.15);}
        .ans-header{display:flex;align-items:center;gap:12px;margin-bottom:15px;}
        .user-info-text{display:flex;flex-direction:column;flex:1;cursor:pointer;}

        /* ═══════════════════════════════════════
           علامات التوثيق — أكبر وأقرب للاسم
        ═══════════════════════════════════════ */
        .name-badge-row{
            display:inline-flex;
            align-items:center;
            gap:3px;          /* مسافة ضيقة جداً بين الاسم والشارة */
        }
        .ans-display-name{
            font-weight:800;font-size:14px;color:#fff;
            line-height:1.2;white-space:nowrap;
        }
        .badge-feed{
            width:20px;height:20px;   /* أكبر: كان 16px */
            object-fit:contain;
            flex-shrink:0;
            display:inline-block;
            vertical-align:middle;
            position:relative;top:-1px;
        }
        .badge-feed.admin-badge{
            border-radius:50%;
            filter:drop-shadow(0 0 5px rgba(255,0,43,0.7));
            animation:admin-badge-pulse 2s infinite ease-in-out;
        }
        .badge-feed.user-badge{
            border-radius:50%;
            filter:drop-shadow(0 0 5px rgba(0,191,255,0.6));
            animation:user-badge-pulse 2s infinite ease-in-out;
        }
        .dev-badge-label{
            font-size:9px;background:var(--admin-red);
            padding:1px 6px;border-radius:5px;
            color:white;font-weight:800;
            flex-shrink:0;white-space:nowrap;
        }
        @keyframes admin-badge-pulse{
            0%,100%{transform:scale(1);  filter:drop-shadow(0 0 5px  rgba(255,0,43,0.7));opacity:0.9;}
            50%    {transform:scale(1.12);filter:drop-shadow(0 0 12px rgba(255,0,43,1));  opacity:1;  }
        }
        @keyframes user-badge-pulse{
            0%,100%{transform:scale(1);  filter:drop-shadow(0 0 5px  rgba(0,191,255,0.6));opacity:0.8;}
            50%    {transform:scale(1.12);filter:drop-shadow(0 0 12px rgba(0,191,255,0.9));opacity:1;  }
        }
        /* ═══════════════════════════════════════ */

        .ans-user-name{font-weight:400;font-size:11px;color:var(--text-gray);}
        .avatar-frame{width:45px;height:45px;border-radius:50%;position:relative;cursor:pointer;}
        .avatar-img{width:100%;height:100%;border-radius:50%;object-fit:cover;border:2px solid var(--bg);}
        .avatar-frame.admin-glow::after{content:'';position:absolute;inset:-2px;border-radius:50%;background:var(--admin-red);filter:blur(6px);opacity:0.5;z-index:-1;}
        .avatar-frame.verify-glow::after{content:'';position:absolute;inset:-2px;border-radius:50%;background:var(--verify-blue);filter:blur(6px);opacity:0.5;z-index:-1;}
        .online-dot{position:absolute;bottom:1px;right:1px;width:11px;height:11px;background:#4ade80;border-radius:50%;border:2px solid var(--bg);display:none;z-index:10;}
        .online-dot{position:absolute;bottom:1px;right:1px;width:11px;height:11px;background:#4ade80;border-radius:50%;border:2px solid var(--bg);display:none;z-index:10;}
        .ans-q{font-size:13px;color:#aaa;margin-bottom:12px;line-height:1.6;}
        .ans-a{font-size:15px;font-weight:700;color:#fff;background:rgba(255,255,255,0.02);padding:15px;border-radius:15px;border-right:4px solid var(--primary);word-break:break-word;}
        .ans-footer{display:flex;justify-content:space-between;align-items:center;margin-top:18px;}
        .ans-actions{display:flex;gap:20px;}
        .action-btn{background:none;border:none;color:#666;font-size:13px;font-weight:700;cursor:pointer;display:flex;align-items:center;gap:7px;transition:0.2s;font-family:'Cairo';}
        .action-btn.liked{color:var(--primary);}
        .report-btn,.delete-btn{color:#333;font-size:13px;cursor:pointer;transition:0.3s;}
        .ans-time-container{text-align:left;line-height:1.3;}
        .ans-time{display:block;font-size:10px;color:var(--primary);font-weight:900;}
        .ans-date{display:block;font-size:9px;color:#666;font-weight:600;}

        /* Search Result */
        #searchResultContainer{position:absolute;top:55px;left:0;width:100%;background:var(--card);border:1px solid var(--border);border-radius:20px;display:none;flex-direction:column;z-index:2000;box-shadow:0 10px 30px rgba(0,0,0,0.5);overflow:hidden;}
        .search-res-title{padding:12px 15px;font-size:11px;color:var(--primary);font-weight:800;border-bottom:1px solid var(--border);display:flex;justify-content:space-between;}
        .user-res-item{padding:10px 15px;display:flex;align-items:center;gap:12px;cursor:pointer;border-bottom:1px solid rgba(255,255,255,0.02);transition:0.2s;}
        .user-res-item:hover{background:rgba(255,255,255,0.03);}

        /* Toast */
        #toast{position:fixed;bottom:90px;left:50%;transform:translateX(-50%);background:rgba(248,5,102,0.9);color:white;padding:8px 18px;border-radius:12px;font-size:11px;font-weight:700;z-index:9999;display:none;backdrop-filter:blur(10px);}

        /* Butterflies */
        .butterfly{position:fixed;pointer-events:none;z-index:1;width:25px;height:25px;transform-style:preserve-3d;}
        .butterfly .wing{position:absolute;width:16px;height:24px;top:0;border-radius:50% 50% 40% 60%;background:linear-gradient(135deg,var(--primary),#ff99bb);opacity:0.8;}
        .butterfly .left-wing{right:12px;transform-origin:right center;animation:flap-left 0.2s infinite ease-in-out alternate;}
        .butterfly .right-wing{left:12px;transform-origin:left center;animation:flap-right 0.2s infinite ease-in-out alternate;}
        @keyframes flap-left{from{transform:rotateY(0deg);}to{transform:rotateY(65deg);}}
        @keyframes flap-right{from{transform:rotateY(0deg);}to{transform:rotateY(-65deg);}}

        /* Bottom Nav */
        .bottom-nav{position:fixed;bottom:0;left:0;width:100%;background:rgba(10,10,10,0.96);backdrop-filter:blur(20px);-webkit-backdrop-filter:blur(20px);display:flex;justify-content:space-around;padding:12px 0;border-top:1px solid var(--border);z-index:1000;}
.nav-item{text-decoration:none;display:flex;flex-direction:column;align-items:center;color:#555;font-size:10px;font-weight:700;gap:3px;transition:color 0.2s;position:relative;padding:4px 8px;}
.nav-item i{font-size:20px;margin-bottom:4px;}
.nav-item.active{color:var(--primary);}
.nav-item:hover{color:#888;}
.badge-nav{position:absolute;top:-5px;right:-5px;background:var(--primary);color:white;font-size:9px;min-width:16px;height:16px;border-radius:50%;display:flex;align-items:center;justify-content:center;border:2px solid #000;font-weight:900;}

        @keyframes modalPop{from{opacity:0;transform:scale(0.95);}to{opacity:1;transform:scale(1);}}
        @keyframes slideIn{from{opacity:0;transform:translateY(10px);}to{opacity:1;transform:translateY(0);}}

        @media(max-width:600px){
            .feed-container{padding:0 10px;margin:10px auto;}
            .ans-card{padding:15px;border-radius:20px;}
            .ans-a{font-size:14px;padding:12px;}
        }
  /* Leaderboard */
.leader-card{
    background:var(--card);border-radius:24px;padding:20px;
    margin-bottom:15px;border:1px solid var(--border);
    display:flex;align-items:center;gap:15px;
    cursor:pointer;transition:border-color 0.2s;
}
.leader-card:hover{border-color:rgba(248,5,102,0.35);box-shadow:0 8px 24px rgba(248,5,102,0.12);transform:translateY(-2px);}
.leader-card{transition:all 0.3s cubic-bezier(0.4,0,0.2,1);}
.leader-rank{
    font-size:22px;font-weight:900;min-width:35px;
    text-align:center;
}
.rank-1{color:#FFD700;}
.rank-2{color:#C0C0C0;}
.rank-3{color:#CD7F32;}
.rank-other{color:#555;}
.leader-avatar{
    width:52px;height:52px;border-radius:50%;
    object-fit:cover;border:2px solid var(--border);
    flex-shrink:0;
}
.leader-info{flex:1;}
.leader-name{font-size:14px;font-weight:800;color:#fff;}
.leader-username{font-size:11px;color:#666;margin-top:2px;}
.leader-likes{
    display:flex;flex-direction:column;
    align-items:flex-end;gap:4px;
}
.leader-likes-count{
    font-size:15px;font-weight:900;color:var(--primary);
}
.leader-likes-label{font-size:10px;color:#555;font-weight:700;}
.leader-coins-badge{
    background:rgba(255,204,0,0.1);border:1px solid rgba(255,204,0,0.25);
    border-radius:20px;padding:3px 10px;
    font-size:11px;font-weight:800;color:#ffcc00;
    display:flex;align-items:center;gap:4px;
}
.week-header{
    text-align:center;margin-bottom:20px;
}
.week-header h3{
    font-size:16px;font-weight:900;color:#fff;margin:0 0 5px;
}
.week-header p{font-size:11px;color:#555;margin:0;}
.my-rank-bar{
    background:rgba(248,5,102,0.08);border:1px solid rgba(248,5,102,0.2);
    border-radius:18px;padding:14px 18px;margin-bottom:20px;
    display:flex;align-items:center;justify-content:space-between;
}
.my-rank-bar .my-rank-label{font-size:12px;font-weight:800;color:#fff;}
.my-rank-bar .my-rank-likes{font-size:12px;color:var(--primary);font-weight:800;}
  /* ══ TAB SWITCHER ══ */
.tab-switcher{
    position:relative;display:grid;
    grid-template-columns:2fr 2fr 1fr;
    background:rgba(255,255,255,0.03);
    border:1px solid var(--border);
    border-radius:18px;padding:5px;
    margin-bottom:22px;gap:4px;
}
.tab-btn{
    position:relative;z-index:1;
    display:flex;align-items:center;justify-content:center;gap:5px;
    padding:10px 6px;border-radius:13px;border:none;
    background:transparent;color:#444;
    font-family:'Cairo',sans-serif;font-weight:800;font-size:12px;
    cursor:pointer;transition:color 0.3s;white-space:nowrap;user-select:none;
}
.tab-btn.active{color:#fff;}
  .tab-btn#tabFeed.active{
    background:linear-gradient(135deg,#f80566,#b8003f);
    box-shadow:0 4px 18px rgba(248,5,102,0.35);
}
.tab-btn#tabLeader.active{
    background:linear-gradient(135deg,#ffcc00,#ff8800);
    box-shadow:0 4px 18px rgba(255,180,0,0.35);
}
.tab-btn#tabVip.active{
    background:linear-gradient(135deg,#c084fc,#818cf8);
    box-shadow:0 4px 18px rgba(192,132,252,0.35);
}
.tab-btn i{font-size:12px;transition:transform 0.3s;}
.tab-btn.active i{transform:scale(1.2);}
.live-dot{
    width:5px;height:5px;border-radius:50%;
    background:#fff;opacity:0;
}
.tab-btn.active .live-dot{
    opacity:1;animation:blink-dot 1.4s infinite;
}
@keyframes blink-dot{
    0%,100%{opacity:1;transform:scale(1);}
    50%{opacity:0.4;transform:scale(0.6);}
}

/* ══ VIP SECTION ══ */
.vip-hero{
    position:relative;
    background:linear-gradient(135deg,rgba(192,132,252,0.1),rgba(129,140,248,0.07));
    border:1px solid rgba(192,132,252,0.2);
    border-radius:22px;padding:22px 18px;
    margin-bottom:18px;text-align:center;overflow:hidden;
}
.vip-hero::before{
    content:'';position:absolute;inset:0;
    background:radial-gradient(ellipse at 50% -20%,rgba(192,132,252,0.15),transparent 70%);
    pointer-events:none;
}
.vip-crown-icon{
    font-size:38px;display:block;margin-bottom:10px;
    filter:drop-shadow(0 0 14px rgba(192,132,252,0.7));
    animation:float-crown 3s ease-in-out infinite;
}
@keyframes float-crown{
    0%,100%{transform:translateY(0);}
    50%{transform:translateY(-7px);}
}
.vip-hero h2{font-size:15px;font-weight:900;color:#fff;margin-bottom:5px;}
.vip-hero p{font-size:11px;color:#888;line-height:1.6;}
.vip-reward{
    display:inline-flex;align-items:center;gap:7px;
    background:rgba(255,204,0,0.1);border:1px solid rgba(255,204,0,0.25);
    border-radius:50px;padding:7px 18px;margin-top:12px;
    font-size:13px;font-weight:900;color:var(--gold);
}
.vip-reward img{width:18px;height:18px;border-radius:50%;}

/* مهام */
.mission-card{
    background:var(--card);border:1px solid var(--border);
    border-radius:18px;padding:16px 18px;margin-bottom:12px;
    display:flex;align-items:center;gap:14px;
    transition:border-color 0.2s;
}
.mission-card.done{border-color:rgba(0,230,118,0.3);background:rgba(0,230,118,0.03);}
.mission-icon{
    width:44px;height:44px;border-radius:14px;
    display:flex;align-items:center;justify-content:center;
    font-size:18px;flex-shrink:0;
}
.mission-info{flex:1;}
.mission-title{font-size:13px;font-weight:800;color:#fff;margin-bottom:4px;}
.mission-progress-bar{
    height:5px;background:rgba(255,255,255,0.07);
    border-radius:10px;overflow:hidden;margin-top:6px;
}
.mission-progress-fill{
    height:100%;border-radius:10px;
    background:linear-gradient(90deg,#c084fc,#818cf8);
    transition:width 0.5s ease;
}
.mission-card.done .mission-progress-fill{background:linear-gradient(90deg,#00e676,#00b8d9);}
.mission-reward{
    display:flex;flex-direction:column;align-items:flex-end;gap:4px;flex-shrink:0;
}
.mission-coins{
    display:flex;align-items:center;gap:4px;
    font-size:12px;font-weight:900;color:var(--gold);
}
.mission-coins img{width:14px;height:14px;border-radius:50%;}
.mission-done-badge{
    font-size:10px;font-weight:800;color:#00e676;
    background:rgba(0,230,118,0.1);border-radius:20px;
    padding:2px 8px;
}
  /* ══ VIP WEEKLY TRACKER ══ */
.weekly-tracker-card {
    background: linear-gradient(135deg, rgba(192,132,252,0.08), rgba(129,140,248,0.05));
    border: 1px solid rgba(192,132,252,0.25);
    border-radius: 20px;
    padding: 18px;
    margin-bottom: 16px;
}
.weekly-tracker-card.vip-member {
    border-color: rgba(255,204,0,0.35);
    background: linear-gradient(135deg, rgba(255,204,0,0.06), rgba(192,132,252,0.06));
}
.tracker-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 12px;
}
.tracker-title {
    font-size: 13px;
    font-weight: 800;
    color: #fff;
    display: flex;
    align-items: center;
    gap: 7px;
}
.tracker-count {
    font-size: 12px;
    font-weight: 900;
    color: #c084fc;
}
.tracker-count.done { color: #00e676; }
.tracker-bar-bg {
    height: 8px;
    background: rgba(255,255,255,0.07);
    border-radius: 20px;
    overflow: hidden;
    margin-bottom: 10px;
}
.tracker-bar-fill {
    height: 100%;
    border-radius: 20px;
    background: linear-gradient(90deg, #c084fc, #818cf8);
    transition: width 0.6s cubic-bezier(0.4,0,0.2,1);
    position: relative;
}
.tracker-bar-fill.done {
    background: linear-gradient(90deg, #00e676, #00b8d9);
}
.tracker-bar-fill::after {
    content: '';
    position: absolute;
    top: 0; right: 0; bottom: 0;
    width: 40%;
    background: linear-gradient(90deg, transparent, rgba(255,255,255,0.25));
    border-radius: 20px;
    animation: shimmer-bar 2s infinite;
}
@keyframes shimmer-bar {
    0%   { opacity: 0; transform: translateX(100%); }
    50%  { opacity: 1; }
    100% { opacity: 0; transform: translateX(-200%); }
}
.tracker-dots {
    display: flex;
    gap: 4px;
    flex-wrap: wrap;
    margin-bottom: 10px;
}
.tracker-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: rgba(255,255,255,0.07);
    border: 1px solid rgba(255,255,255,0.1);
    transition: all 0.3s ease;
    flex-shrink: 0;
}
.tracker-dot.filled {
    background: linear-gradient(135deg, #c084fc, #818cf8);
    border-color: transparent;
    box-shadow: 0 0 6px rgba(192,132,252,0.5);
}
.tracker-dot.filled.done-dot {
    background: linear-gradient(135deg, #00e676, #00b8d9);
    box-shadow: 0 0 6px rgba(0,230,118,0.5);
}
.tracker-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: 10px;
    color: #555;
    font-weight: 700;
}

/* ══ VIP BADGE BANNER ══ */
.vip-coins-banner {
    background: linear-gradient(135deg, rgba(255,204,0,0.08), rgba(192,132,252,0.08));
    border: 1px solid rgba(255,204,0,0.3);
    border-radius: 16px;
    padding: 14px 16px;
    margin-bottom: 14px;
    display: flex;
    align-items: center;
    gap: 12px;
    position: relative;
    overflow: hidden;
}
.vip-coins-banner::before {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, transparent 0%, rgba(255,204,0,0.04) 50%, transparent 100%);
    animation: sweep-banner 3s infinite;
}
@keyframes sweep-banner {
    0%   { transform: translateX(-100%); }
    100% { transform: translateX(100%); }
}
.vip-coins-banner .banner-icon {
    font-size: 26px;
    filter: drop-shadow(0 0 10px rgba(255,204,0,0.6));
    animation: float-crown 3s ease-in-out infinite;
    flex-shrink: 0;
}
.vip-coins-banner .banner-text { flex: 1; }
.vip-coins-banner .banner-text strong {
    display: block;
    font-size: 12px;
    font-weight: 900;
    color: #fff;
    margin-bottom: 3px;
}
.vip-coins-banner .banner-text span {
    font-size: 11px;
    color: #888;
    line-height: 1.4;
}
.vip-badge-inline {
    display: inline-flex;
    align-items: center;
    gap: 3px;
    background: rgba(0,191,255,0.1);
    border: 1px solid rgba(0,191,255,0.3);
    border-radius: 50px;
    padding: 2px 8px;
    font-size: 10px;
    font-weight: 800;
    color: var(--verify-blue);
    animation: badge-glow-inline 2s infinite;
}
.vip-badge-inline img {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    filter: drop-shadow(0 0 3px rgba(0,191,255,0.8));
}
@keyframes badge-glow-inline {
    0%,100% { box-shadow: 0 0 5px rgba(0,191,255,0.2); }
    50%      { box-shadow: 0 0 12px rgba(0,191,255,0.5); }
}
.vip-multiplier-tag {
    background: linear-gradient(135deg, #ffd700, #ff8c00);
    color: #000;
    font-size: 11px;
    font-weight: 900;
    padding: 4px 10px;
    border-radius: 50px;
    flex-shrink: 0;
    box-shadow: 0 2px 10px rgba(255,204,0,0.4);
    animation: pulse-tag 2s infinite;
}
@keyframes pulse-tag {
    0%,100% { transform: scale(1); }
    50%      { transform: scale(1.06); }
}

/* ══ VIP CTA BUTTON ══ */
.vip-cta-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    width: 100%;
    padding: 16px;
    margin-top: 18px;
    background: linear-gradient(135deg, #c084fc, #818cf8);
    border: none;
    border-radius: 18px;
    color: #fff;
    font-family: 'Cairo', sans-serif;
    font-size: 14px;
    font-weight: 900;
    cursor: pointer;
    text-decoration: none;
    transition: transform 0.2s, box-shadow 0.2s;
    box-shadow: 0 4px 20px rgba(192,132,252,0.35);
    position: relative;
    overflow: hidden;
}
.vip-cta-btn::before {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, transparent, rgba(255,255,255,0.1), transparent);
    transform: translateX(-100%);
    animation: cta-shine 3s infinite;
}
@keyframes cta-shine {
    0%   { transform: translateX(-100%); }
    60%  { transform: translateX(100%); }
    100% { transform: translateX(100%); }
}
.vip-cta-btn:active { transform: scale(0.97); }
.vip-cta-btn .cta-arrow {
    font-size: 16px;
    animation: arrow-bounce 1.5s infinite;
}
@keyframes arrow-bounce {
    0%,100% { transform: translateX(0); }
    50%      { transform: translateX(-5px); }
}
.vip-future-features {
    background: rgba(255,255,255,0.02);
    border: 1px solid var(--border);
    border-radius: 16px;
    padding: 14px 16px;
    margin-top: 14px;
}
.vip-future-title {
    font-size: 11px;
    font-weight: 800;
    color: #555;
    letter-spacing: 1px;
    text-transform: uppercase;
    margin-bottom: 12px;
    display: flex;
    align-items: center;
    gap: 6px;
}
.future-feature-item {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 8px 0;
    border-bottom: 1px solid rgba(255,255,255,0.03);
    font-size: 12px;
    color: #555;
    font-weight: 700;
}
.future-feature-item:last-child { border-bottom: none; }
.future-feature-item .ff-icon {
    font-size: 16px;
    width: 28px;
    text-align: center;
    flex-shrink: 0;
}
.future-feature-item .ff-soon {
    margin-right: auto;
    font-size: 9px;
    background: rgba(192,132,252,0.1);
    color: #c084fc;
    border-radius: 50px;
    padding: 2px 7px;
    font-weight: 800;
}

/* ══ TOP COINS ══ */
.coins-section-title{
    font-size:11px;font-weight:800;color:#555;
    letter-spacing:1.5px;text-transform:uppercase;
    margin:22px 0 14px;padding-bottom:10px;
    border-bottom:1px solid var(--border);
    display:flex;align-items:center;gap:8px;
}
.coins-section-title img{width:16px;height:16px;border-radius:50%;}
.coins-card{
    background:var(--card);border:1px solid var(--border);
    border-radius:18px;padding:14px 16px;margin-bottom:10px;
    display:flex;align-items:center;gap:12px;
    cursor:pointer;transition:border-color 0.2s;
}
.coins-card{transition:all 0.3s cubic-bezier(0.4,0,0.2,1);}
.coins-card:hover{border-color:rgba(255,204,0,0.3);box-shadow:0 6px 20px rgba(255,204,0,0.08);transform:translateY(-2px);}
.coins-rank{font-size:18px;min-width:28px;text-align:center;}
.coins-avatar{
    width:40px;height:40px;border-radius:50%;
    object-fit:cover;border:2px solid var(--border);flex-shrink:0;
}
.coins-info{flex:1;}
.coins-name{font-size:13px;font-weight:800;color:#fff;}
.coins-username{font-size:10px;color:#555;margin-top:1px;}
.coins-amount{
    display:flex;align-items:center;gap:5px;
    font-size:13px;font-weight:900;color:var(--gold);
}
.coins-amount img{width:16px;height:16px;border-radius:50%;}
    .card-menu-btn{background:none;border:none;color:#555;font-size:18px;cursor:pointer;padding:4px 8px;border-radius:8px;transition:.2s;}
.card-menu-btn:hover{color:#aaa;background:rgba(255,255,255,.05);}
.card-menu{position:absolute;top:30px;left:0;background:#111;border:1px solid rgba(255,255,255,.08);border-radius:14px;padding:6px;display:none;flex-direction:column;gap:4px;z-index:100;min-width:130px;box-shadow:0 8px 24px rgba(0,0,0,.5);}
.card-menu.show{display:flex;}
.card-menu-item{background:none;border:none;color:#aaa;font-family:"Cairo";font-size:13px;font-weight:700;padding:9px 12px;border-radius:10px;cursor:pointer;display:flex;align-items:center;gap:9px;text-align:right;width:100%;transition:.2s;}
.card-menu-item:hover{background:rgba(255,255,255,.05);color:white;}
.share-item i{color:#f80566;}
.report-item i{color:#ff4444;}
.delete-item i{color:#ff4444;}
.share-sheet-overlay{position:fixed;inset:0;background:rgba(0,0,0,0.75);backdrop-filter:blur(8px);z-index:10001;display:none;align-items:flex-end;justify-content:center;}
.share-sheet-overlay.show{display:flex;}
.share-sheet{width:100%;max-width:480px;background:linear-gradient(180deg,#111,#0a0a0a);border:1px solid rgba(248,5,102,0.2);border-bottom:none;border-radius:28px 28px 0 0;padding:12px 20px 26px;animation:shareSheetUp 0.35s cubic-bezier(0.34,1.2,0.64,1);box-shadow:0 -10px 40px rgba(0,0,0,0.5);}
@keyframes shareSheetUp{from{transform:translateY(100%);}to{transform:translateY(0);}}
.share-sheet-handle{width:40px;height:4px;background:rgba(255,255,255,0.15);border-radius:10px;margin:0 auto 16px;}
.share-sheet-title{text-align:center;font-size:15px;font-weight:900;color:#fff;margin-bottom:14px;}
.share-preview{background:rgba(255,255,255,0.03);border:1px solid var(--border);border-radius:14px;padding:10px 14px;margin-bottom:18px;font-size:11px;color:#888;line-height:1.6;max-height:60px;overflow:hidden;text-overflow:ellipsis;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;}
.share-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:14px;margin-bottom:18px;}
.share-opt{background:none;border:none;cursor:pointer;display:flex;flex-direction:column;align-items:center;gap:8px;font-family:'Cairo',sans-serif;color:#ccc;font-size:11px;font-weight:700;transition:transform 0.15s;}
.share-opt:active{transform:scale(0.92);}
.share-icon{width:52px;height:52px;border-radius:16px;display:flex;align-items:center;justify-content:center;font-size:20px;color:#fff;box-shadow:0 4px 14px rgba(0,0,0,0.3);}
.share-native-btn{width:100%;padding:14px;margin-bottom:10px;background:rgba(255,255,255,0.05);border:1px solid var(--border);border-radius:16px;color:#ccc;font-family:'Cairo';font-size:13px;font-weight:800;cursor:pointer;display:flex;align-items:center;justify-content:center;gap:8px;}
.share-cancel-btn{width:100%;padding:14px;background:rgba(255,255,255,0.06);border:none;border-radius:16px;color:#888;font-family:'Cairo';font-size:13px;font-weight:800;cursor:pointer;}
.share-toast-copied{position:fixed;top:20px;left:50%;transform:translateX(-50%) translateY(-100px);background:linear-gradient(135deg,#0d0d0d,#111);border:1px solid rgba(0,230,118,0.4);border-radius:16px;padding:12px 22px;color:#00e676;font-family:'Cairo';font-size:12px;font-weight:800;z-index:99999;transition:transform 0.4s cubic-bezier(0.34,1.2,0.64,1);display:flex;align-items:center;gap:8px;}
.share-toast-copied.show{transform:translateX(-50%) translateY(0);} 
