<div id="referralFloat" style="
  position: fixed;
  bottom: 80px;
  left: 50%;
  transform: translateX(-50%) translateY(100px);
  z-index: 9999;
  width: calc(100% - 32px);
  max-width: 420px;
  background: linear-gradient(135deg, rgba(14,14,14,0.98), rgba(30,0,20,0.98));
  border: 1px solid rgba(248,5,102,0.4);
  border-radius: 20px;
  padding: 14px 16px;
  display: flex;
  align-items: center;
  gap: 12px;
  box-shadow: 0 8px 32px rgba(248,5,102,0.25), 0 0 0 1px rgba(255,255,255,0.04);
  backdrop-filter: blur(20px);
  transition: transform 0.5s cubic-bezier(0.34,1.2,0.64,1), opacity 0.4s;
  opacity: 0;
  pointer-events: none;
  cursor: pointer;
  font-family: Cairo, sans-serif;
">
  <div style="
    width: 44px; height: 44px; min-width: 44px;
    background: linear-gradient(135deg, #f80566, #c4024e);
    border-radius: 14px;
    display: flex; align-items: center; justify-content: center;
    font-size: 22px;
    box-shadow: 0 4px 14px rgba(248,5,102,0.4);
    flex-shrink: 0;
  ">🎁</div>
  <div style="flex: 1; min-width: 0;" onclick="openReferralPage()">
    <div style="color: #fff; font-size: 13px; font-weight: 800; margin-bottom: 3px;">
      ادعُ أصدقاءك واكسب كوينز! 🔥
    </div>
    <div style="color: #aaa; font-size: 11px; line-height: 1.5;">
      1000 كوين لكل صديق يسجل من رابطك
    </div>
    <div style="
      margin-top: 6px;
      background: linear-gradient(135deg, #f80566, #c4024e);
      color: #fff; font-size: 11px; font-weight: 800;
      padding: 4px 12px; border-radius: 50px;
      display: inline-block;
    ">اعرف أكتر ←</div>
  </div>
  <button onclick="closeReferralFloat(event)" style="
    width: 28px; height: 28px; min-width: 28px;
    background: rgba(255,255,255,0.07);
    border: 1px solid rgba(255,255,255,0.1);
    border-radius: 50%; color: #888;
    font-size: 13px; cursor: pointer;
    display: flex; align-items: center; justify-content: center;
    transition: all 0.2s; align-self: flex-start;
    font-family: Cairo, sans-serif;
  " onmouseover="this.style.background='rgba(248,5,102,0.2)';this.style.color='#f80566'"
     onmouseout="this.style.background='rgba(255,255,255,0.07)';this.style.color='#888'">✕</button>
</div>

<script>
(function() {
  const HIDE_KEY = 'referral_float_hidden';
  const HIDE_DURATION = 24 * 60 * 60 * 1000;

  function showReferralFloat() {
    const hidden = localStorage.getItem(HIDE_KEY);
    if (hidden && Date.now() - parseInt(hidden) < HIDE_DURATION) return;
    const el = document.getElementById('referralFloat');
    if (!el) return;
    setTimeout(() => {
      el.style.opacity = '1';
      el.style.transform = 'translateX(-50%) translateY(0)';
      el.style.pointerEvents = 'auto';
    }, 2000);
  }

  window.closeReferralFloat = function(e) {
    if (e) e.stopPropagation();
    const el = document.getElementById('referralFloat');
    if (!el) return;
    el.style.opacity = '0';
    el.style.transform = 'translateX(-50%) translateY(100px)';
    el.style.pointerEvents = 'none';
    localStorage.setItem('referral_float_hidden', Date.now().toString());
  };

  window.openReferralPage = function() {
    window.location.href = 'referral.html';
  };

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', showReferralFloat);
  } else {
    showReferralFloat();
  }
})();
</script>


