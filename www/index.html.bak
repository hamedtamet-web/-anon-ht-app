    <div class="ios-steps">
        <span data-lang-key="ios_step1">اضغط على</span>
        <i class="fa-solid fa-arrow-up-from-bracket"></i>
        <strong data-lang-key="ios_step2">مشاركة</strong><br>
        <span data-lang-key="ios_step3">ثم اختر</span>
        <strong data-lang-key="ios_step4">"إضافة إلى الشاشة الرئيسية"</strong>
    </div>
    <button id="ios-dismiss-btn" data-lang-key="ios_ok">فهمت ✓</button>
</div>

<div id="toast"></div>

<header>
    <div class="header-content">
        <img src="images/logo.png" style="width:28px;cursor:pointer;" onclick="location.reload()">

        <div class="search-container">
            <i class="fa-solid fa-magnifying-glass search-icon"></i>
            <input type="text" class="search-input" id="userSearch"
                   data-lang-key="search_placeholder"
                   placeholder="ابحث عن مستخدم..." autocomplete="off">
            <div id="searchResultContainer">
                <div class="search-res-title">
                    <span>نتائج البحث</span>
                    <i class="fa-solid fa-times" onclick="clearSearch()" style="cursor:pointer"></i>
                </div>
                <div id="usersResultList"></div>
            </div>
        </div>

        <!-- زر اللغة المشترك -->
        <select class="lang-select-global" aria-label="Language">
    <option value="ar">AR</option>
    <option value="en">EN</option>
    <option value="fr">FR</option>
    <option value="es">ES</option>
    <option value="pt">PT</option>
    <option value="de">DE</option>
    <option value="ru">RU</option>
    <option value="zh">ZH</option>
    <option value="hi">HI</option>
    <option value="tr">TR</option>
</select>

        <div id="notifContainer" style="position:relative;">
            <div id="notifTrigger" style="background:rgba(255,255,255,0.03);width:40px;height:40px;border-radius:12px;display:flex;align-items:center;justify-content:center;cursor:pointer;border:1px solid var(--border);position:relative;">
                <i class="fa-regular fa-bell" style="font-size:16px;color:#666;"></i>
                <div id="notifBadge" style="position:absolute;top:-2px;left:-2px;background:var(--primary);min-width:16px;height:16px;border-radius:10px;border:2px solid var(--bg);display:none;align-items:center;justify-content:center;font-size:8px;font-weight:900;">0</div>
            </div>
            <div class="notif-dropdown" id="notifDropdown">
                <div id="notifList">
                    <div style="padding:20px;text-align:center;color:#555;font-size:12px;"
                         data-lang-key="no_notif">لا توجد إشعارات حالياً</div>
                </div>
                <a href="notifications.html" class="notif-more"
                   data-lang-key="more_notif">عرض المزيد من الإشعارات</a>
            </div>
        </div>
    </div>
</header>
<div class="feed-container">
    <!-- تابات -->
    <div class="tab-switcher" id="tabSwitcher">
    <button class="tab-btn active" id="tabFeed" onclick="switchFeedTab('feed')">
        <i class="fa-solid fa-bolt"></i> Wall
        <div class="live-dot"></div>
    </button>
    <button class="tab-btn" id="tabLeader" onclick="switchFeedTab('leader')">
        <i class="fa-solid fa-ranking-star"></i> Legends
    </button>
    <button class="tab-btn" id="tabVip" onclick="switchFeedTab('vip')">
        <i class="fa-solid fa-crown"></i>
        <span style="font-size:11px;">VIP</span>
    </button>
    </div>
    <div id="topAdBanner" style="display:none;background:var(--bg);justify-content:center;align-items:center;margin:10px 0;border-radius:18px;overflow:hidden;">
    </div>
    <div style="display:none;" id="tabSwitcherEnd">
</div>

<!-- ══ DAILY CHALLENGE ══ -->
<div id="askFeed"></div>

<!-- == DAILY CHALLENGE FLOATING == -->
<div id="dailyChallengeModal" style="
  position:fixed;bottom:80px;left:50%;transform:translateX(-50%);
  width:calc(100% - 32px);max-width:480px;
  background:linear-gradient(135deg,#0d0d0d,#110008);
  border:1px solid rgba(248,5,102,0.3);
  border-radius:24px;padding:18px;
  box-shadow:0 8px 40px rgba(248,5,102,0.2),0 0 0 1px rgba(248,5,102,0.05);
  z-index:9999;font-family:Cairo,sans-serif;
  animation:slideUpChallenge 0.4s cubic-bezier(0.34,1.56,0.64,1);
  display:none;">
  
  <!-- Header -->
  <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:14px;">
    <div style="display:flex;align-items:center;gap:10px;">
      <div style="width:38px;height:38px;background:linear-gradient(135deg,#f80566,#c4024e);border-radius:12px;display:flex;align-items:center;justify-content:center;font-size:18px;box-shadow:0 4px 14px rgba(248,5,102,0.4);">⚡</div>
      <div>
        <div style="font-size:13px;font-weight:900;color:#fff;">تحدي اليوم</div>
        <div style="font-size:10px;color:#f80566;font-weight:700;" id="dailyChallengeXP">+50 XP عند الإجابة</div>
      </div>
    </div>
    <div style="display:flex;align-items:center;gap:8px;">
      <div id="dailyChallengeTimer" style="font-size:10px;color:#555;direction:ltr;background:rgba(255,255,255,0.05);padding:4px 8px;border-radius:8px;"></div>
      <button onclick="closeDailyChallenge()" style="width:28px;height:28px;background:rgba(255,255,255,0.07);border:none;border-radius:8px;color:#888;font-size:16px;cursor:pointer;display:flex;align-items:center;justify-content:center;">✕</button>
    </div>
  </div>

  <!-- Question -->
  <div id="dailyChallengeQ" style="font-size:14px;font-weight:800;color:#fff;line-height:1.8;margin-bottom:14px;padding:12px 14px;background:rgba(248,5,102,0.06);border-radius:14px;border-right:3px solid #f80566;">...جاري التحميل</div>

  <!-- Input -->
  <div style="display:flex;gap:8px;">
    <input id="dailyChallengeInput" type="text" maxlength="200" placeholder="اكتب إجابتك..." style="flex:1;background:rgba(255,255,255,0.05);border:1px solid rgba(255,255,255,0.08);border-radius:12px;padding:10px 14px;color:#fff;font-family:Cairo,sans-serif;font-size:13px;outline:none;transition:border 0.2s;" onfocus="this.style.border='1px solid rgba(248,5,102,0.5)'" onblur="this.style.border='1px solid rgba(255,255,255,0.08)'">
    <button onclick="submitDailyChallenge()" style="background:linear-gradient(135deg,#f80566,#c4024e);color:#fff;border:none;border-radius:12px;padding:10px 16px;font-size:13px;font-weight:800;cursor:pointer;font-family:Cairo,sans-serif;box-shadow:0 4px 12px rgba(248,5,102,0.3);white-space:nowrap;">أرسل ⚡</button>
  </div>

  <!-- Result -->
  <div id="dailyChallengeResult" style="display:none;margin-top:10px;padding:10px 14px;background:rgba(74,222,128,0.08);border:1px solid rgba(74,222,128,0.2);border-radius:12px;font-size:12px;color:#4ade80;font-weight:700;text-align:center;"></div>
</div>

<style>
@keyframes slideUpChallenge {
  from { opacity:0; transform:translateX(-50%) translateY(30px); }
  to   { opacity:1; transform:translateX(-50%) translateY(0); }
}
</style>
<div id="leaderboardTab" style="display:none;"></div>
<div id="vipTab" style="display:none;"></div>

<nav class="bottom-nav" aria-label="التنقل الرئيسي">
    <a href="/" class="nav-item active">
        <i class="fa-solid fa-house" aria-hidden="true"></i>
        <span data-lang-key="nav_home">الرئيسية</span>
    </a>
    <a href="questions.html" class="nav-item" style="position:relative;">
        <i class="fa-solid fa-circle-question" aria-hidden="true"></i>
        <span data-lang-key="nav_qs">الأسئلة</span>
        <div id="qBadgeNav" class="badge-nav" style="display:none;">0</div>
    </a>
    <a href="quiet-corner.html" class="nav-item">
        <i class="fa-solid fa-leaf" aria-hidden="true"></i>
        <span data-lang-key="nav_skina">سكينة</span>
    </a>
    <a href="game.html" class="nav-item">
        <i class="fa-solid fa-brain" aria-hidden="true"></i>
        <span data-lang-key="nav_tayf">تحدِّ</span>
    </a>
    <a href="profile.html" id="myProfileLink" class="nav-item">
        <i class="fa-solid fa-user" aria-hidden="true"></i>
        <span data-lang-key="nav_profile">بروفايلي</span>
    </a>
</nav>

<script>
'use strict';

firebase.initializeApp(APP_CONFIG.firebase);
firebase.analytics();
const db = firebase.firestore(), auth = firebase.auth();
let currentUser = null;
let currentUserLang    = 'ar';
let currentUserCountry = '';

const sndQuestion = new Audio('sounds/question.wav');
const sndNotif    = new Audio('sounds/notification.wav');

/* XSS protection */
const safe = (t) => {
    if (t === null || t === undefined) return "";
    const d = document.createElement('div');
    d.textContent = String(t);
    return d.innerHTML;
};

/* JS attribute escaping — للاستخدام في data-* */
const escapeAttr = (t) => {
    if (t === null || t === undefined) return "";
    return String(t)
        .replace(/&/g, '&amp;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#39;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/\n/g, '&#10;')
        .replace(/\r/g, '&#13;');
};

/* ── Modal ── */
const customPrompt = (title, showInput = true) => new Promise((resolve) => {
    const overlay = document.getElementById('modalOverlay');
    const input   = document.getElementById('modalInput');
    document.getElementById('modalTitle').innerText = title;
    overlay.style.display = 'flex';
    input.style.display   = showInput ? 'block' : 'none';
    input.value = "";
    const confirmBtn = document.getElementById('modalConfirmBtn');
    const cancelBtn  = document.getElementById('modalCancelBtn');
    const nc = confirmBtn.cloneNode(true);
    const nl = cancelBtn.cloneNode(true);
    confirmBtn.parentNode.replaceChild(nc, confirmBtn);
    cancelBtn.parentNode.replaceChild(nl,  cancelBtn);
    nc.onclick = () => { overlay.style.display = 'none'; resolve(showInput ? input.value.trim() : true); };
    nl.onclick  = () => { overlay.style.display = 'none'; resolve(null); };
});

/* ── Realtime listeners state ── */
let initialQuestionsLoaded     = false;
let initialNotificationsLoaded = false;
let notifUnsubscribe           = null;
let questionsUnsubscribe       = null;

function startListening(uid) {
    if (questionsUnsubscribe) questionsUnsubscribe();
    if (notifUnsubscribe)     notifUnsubscribe();

    questionsUnsubscribe = db.collection("questions")
        .where("receiverId","==",uid).where("status","==","pending")
        .onSnapshot(snap => {
            const b = document.getElementById('qBadgeNav');
            if (!snap.empty) {
                b.style.display = 'flex'; b.innerText = snap.size;
                if (initialQuestionsLoaded && !snap.metadata.hasPendingWrites)
                    snap.docChanges().forEach(c => { if (c.type==="added") sndQuestion.play().catch(()=>{}); });
            } else b.style.display = 'none';
            initialQuestionsLoaded = true;
        });

    notifUnsubscribe = db.collection("notifications")
        .where("receiverId","==",uid).where("isRead","==",false)
        .onSnapshot(snap => {
            const nb = document.getElementById('notifBadge');
            if (!snap.empty) {
                nb.style.display = 'flex'; nb.innerText = snap.size;
                if (initialNotificationsLoaded)
                    snap.docChanges().forEach(c => { if (c.type==="added") sndNotif.play().catch(()=>{}); });
            } else nb.style.display = 'none';
            initialNotificationsLoaded = true;
            loadRecentNotifs(uid);
        });
}

/* ── Recent Notifs ── */
let notifsUnsubscribeRecent = null;
function loadRecentNotifs(uid) {
    if (notifsUnsubscribeRecent) notifsUnsubscribeRecent();
    notifsUnsubscribeRecent = db.collection("notifications")
        .where("receiverId","==",uid)
        .orderBy("timestamp","desc").limit(5)
        .onSnapshot(snap => {
            const list = document.getElementById('notifList');
            if (snap.empty) {
                list.innerHTML = `<div style="padding:20px;text-align:center;color:#555;font-size:12px;">${LangManager.t('no_notif')}</div>`;
                return;
            }
            list.innerHTML = "";
            snap.forEach(doc => {
                const n = doc.data();
                let iconContainerClass='n-icon', iconClass='fa-solid fa-bell', msg='';
                switch(n.type) {
                    case 'like':    iconClass='fa-solid fa-heart';    msg=n.senderName?`${safe(n.senderName)} أعجب بإجابتك ❤️`:"شخص ما أعجب بإجابتك"; break;
                    case 'follow':  iconClass='fa-solid fa-user-plus'; iconContainerClass='n-icon follow-icon'; msg=n.senderName?`${safe(n.senderName)} بدأ متابعتك 💙`:"شخص ما بدأ متابعتك"; break;
                    case 'comment': iconClass='fa-solid fa-comment';   msg=n.senderName?`${safe(n.senderName)} علّق على إجابتك 💬`:"رد أحدهم على إجابتك"; break;
                    default: msg = n.message || "إشعار جديد";
                }
                const avatarSection = n.senderAvatar
                    ? `<img src="${safe(n.senderAvatar)}" onerror="this.onerror=null;this.src='images/user.png'" style="width:35px;height:35px;border-radius:50%;object-fit:cover;flex-shrink:0;" loading="lazy">`
                    : `<div class="${iconContainerClass}"><i class="${iconClass}"></i></div>`;
                const item = document.createElement('div');
                item.className = 'notif-item';
                item.innerHTML = avatarSection + `<div class="notif-text">${msg}</div>`;
                item.onclick = () => {
                    if (n.type === 'follow') {
    location.href = `profile.html?id=${n.senderId}`;
} else if (n.type === 'question') {
    location.href = `questions.html`;
} else if (n.answerId) {
    location.href = `thread.html?id=${n.answerId}`;
}
                };
                list.appendChild(item);
            });
        });
}

document.getElementById('notifTrigger').onclick = (e) => {
    e.stopPropagation();
    if (!currentUser) return location.href = 'signin.html';
    const dropdown  = document.getElementById('notifDropdown');
    const isVisible = dropdown.style.display === 'flex';
    dropdown.style.display = isVisible ? 'none' : 'flex';
    if (!isVisible && currentUser) {
        db.collection("notifications").where("receiverId","==",currentUser.uid).where("isRead","==",false).get()
            .then(s=>{ const b=db.batch(); s.forEach(d=>b.update(d.ref,{isRead:true})); return b.commit(); }).catch(()=>{});
    }
};

document.addEventListener('click', (e) => {
    document.getElementById('notifDropdown').style.display = 'none';
    if (!e.target.closest('.search-container')) clearSearch();
});

/* ── Create Notification ── */
async function createNotification(receiverId, type, answerId = null) {
    if (!receiverId || !currentUser || receiverId===currentUser.uid) return;
    try {
        const senderSnap = await db.collection("users").doc(currentUser.uid).get();
        const sD = senderSnap.exists ? senderSnap.data() : {};
        const nd = {
            receiverId, senderId:currentUser.uid,
            senderName:sD.name||"شخص ما", senderUsername:sD.username||"",
            senderAvatar:sD.avatarUrl||"",
            isSenderVerified:!!(sD.isVerified||sD.isPremium),
            type, isRead:false,
            timestamp:firebase.firestore.FieldValue.serverTimestamp()
        };
        if (answerId) nd.answerId = answerId;
        await db.collection("notifications").add(nd);
    } catch(e) { console.log("Notification error:",e); }
}

/* ══════════════════════════════════════
   FEED
══════════════════════════════════════ */
let feedUnsubscribe = null;

const renderFeed = (forceLang = null) => {
    if (feedUnsubscribe) feedUnsubscribe();
    const lang = forceLang || LangManager.get();

    feedUnsubscribe = db.collection("answers")
    .where("language", "==", lang)
    .orderBy("answeredAt","desc").limit(35)
    .onSnapshot(async (snap) => {

            let docs = snap.docs;

            // لو الإجابات أقل من 10 والمستخدم مش عربي → ادمج مع الفيد العربي
            if (docs.length < 10 && lang !== 'ar') {
                try {
                    const arSnap = await db.collection("answers")
                        .where("language", "==", "ar")
                        .orderBy("answeredAt", "desc")
                        .limit(35)
                        .get();
                    const existingIds = new Set(docs.map(d => d.id));
                    const arDocs = arSnap.docs.filter(d => !existingIds.has(d.id));
                    docs = [...docs, ...arDocs].slice(0, 35);
                } catch(e) { console.log("Fallback feed error:", e); }
            }

            const feedEl   = document.getElementById('askFeed');
            const fragment = document.createDocumentFragment();

            const userIds   = [...new Set(docs.map(d=>d.data().userId).filter(Boolean))];
            const userCache = {};
            await Promise.all(userIds.map(async uid => {
                try {
                    const s = await db.collection("users").doc(uid).get();
                    userCache[uid] = s.exists ? s.data() : {};
                } catch(e) { userCache[uid]={}; }
            }));

            for (const doc of docs) {
                const d = doc.data();
                if (!d.userId || !d.reply) continue;

                const u          = userCache[d.userId] || {};
                const username   = ((u.username||d.username||"anon")+"").toLowerCase();
                const isDev      = username === 'ht';
                const isVerified = u.isVerified===true || u.isPremium===true;
                const likedBy = Array.isArray(d.likedBy) ? d.likedBy : [];
                const likes = Array.isArray(d.likes) ? d.likes : [];
                const isLiked = likedBy.includes(currentUser?.uid) || likes.includes(currentUser?.uid);
                const isMyPost   = d.userId === currentUser?.uid;

                const cardGlow   = isDev ? "dev-glow"   : (isVerified ? "user-glow"   : "");
                const avatarGlow = isDev ? "admin-glow" : (isVerified ? "verify-glow" : "");

                let badgeHtml = '';
                if (isDev) {
                    badgeHtml = `
                        <img src="images/admin-verified-logo.png" class="badge-feed admin-badge" alt="">
                        <span class="dev-badge-label">
                            <i class="fa-solid fa-code"></i> ${LangManager.t('dev_label')}
                        </span>`;
                } else if (isVerified) {
                    badgeHtml = `<img src="images/verified-logo.png" class="badge-feed user-badge" alt="">`;
                }

                const dateObj = d.answeredAt?.toDate();
                const locale  = lang==='ar' ? 'ar-EG' : 'en-GB';
                const timeStr = dateObj ? dateObj.toLocaleTimeString(locale,{hour:'2-digit',minute:'2-digit'}) : '';
                const dateStr = dateObj ? dateObj.toLocaleDateString(locale,{month:'long',day:'numeric'}) : '';

                const card = document.createElement('div');
                card.className   = `ans-card ${cardGlow}`;
                card.dataset.id  = doc.id;
                card.innerHTML = `
                    <div class="ans-header">
                        <div class="avatar-frame ${avatarGlow}"
                             onclick="location.href='profile.html?id=${safe(d.userId)}'">
                            <img src="${safe(u.avatarUrl||'images/user.png')}"
                                 class="avatar-img" onerror="this.src='images/user.png'" loading="lazy" width="45" height="45">
                            <span class="online-dot" id="odot-${safe(d.userId)}"></span>
                        </div>
                        <div class="user-info-text"
                             onclick="location.href='profile.html?id=${safe(d.userId)}'">
                            <div class="name-badge-row">
                                <span class="ans-display-name">${safe(u.name||d.name||"غريب")}</span>
                                ${badgeHtml}
                            </div>
                            <span class="ans-user-name">@${safe(username)}</span>
                        </div>
                        <div style="position:relative;">
                            <button class="card-menu-btn">
                                <i class="fa-solid fa-ellipsis"></i>
                            </button>
                            <div class="card-menu" id="menu-${safe(doc.id)}">
                                <button class="card-menu-item share-item"
                                    data-action="share"
                                    data-id="${escapeAttr(doc.id)}"
                                    data-question="${escapeAttr(d.questionText)}"
                                    data-reply="${escapeAttr(d.reply)}"
                                    data-name="${escapeAttr(u.name||d.name||'')}"
                                    data-username="${escapeAttr(username)}">
                                    <i class="fa-solid fa-share-nodes"></i> شارك</button>
                                ${!isMyPost ? `<button class="card-menu-item report-item"
                                    data-action="report"
                                    data-id="${escapeAttr(doc.id)}"
                                    data-uid="${escapeAttr(d.userId)}">
                                    <i class="fa-solid fa-flag"></i> بلّغ</button>` : ''}
                                ${isMyPost ? `<button class="card-menu-item delete-item"
                                    data-action="delete"
                                    data-id="${escapeAttr(doc.id)}"
                                    data-qid="${escapeAttr(d.questionId||'')}">
                                    <i class="fa-solid fa-trash-can"></i> احذف</button>` : ''}
                            </div>
                        </div>
                    </div>
                    <div class="ans-q">${safe(d.questionText)}</div>
                    <div class="ans-a">${safe(d.reply)}</div>
                    <div class="ans-footer">
                        <div class="ans-actions">
                            <button class="action-btn ${isLiked?'liked':''}"
                                    onclick="toggleLike('${safe(doc.id)}','${safe(d.userId)}')">
                                <i class="${isLiked?'fa-solid':'fa-regular'} fa-heart"></i>
                                <span>${d.likesCount || Math.max(likedBy.length, likes.length) || 0}</span>
                            </button>
                            <button class="action-btn"
                                    onclick="window.location.href='thread.html?id=${safe(doc.id)}'">
                                <i class="fa-regular fa-comment"></i>
                                <span>${LangManager.t('replies_btn')}</span>
                            </button>
                        </div>
                        <div style="display:flex;align-items:center;gap:8px;">
                            ${currentUser?.uid !== d.userId ? `
                            <button class="gift-btn" id="gift-${safe(doc.id)}"
                                style="padding:4px 8px;font-size:12px;border-radius:50px;"
                                data-total="${d.giftsTotal || 0}"
                                data-owner="${safe(d.userId)}"
                                data-id="${safe(doc.id)}"
                                onclick="handleGiftBtn(this)">
                                🔥 <span class="gift-count">${d.giftsTotal || 0}</span>
                            </button>` : `
                            <button class="gift-btn" style="padding:4px 8px;font-size:12px;border-radius:50px;opacity:0.35;cursor:default;" disabled>
                                🔥 <span class="gift-count">${d.giftsTotal || 0}</span>
                            </button>`}
                            <div class="ans-time-container">
                                <span class="ans-time">${timeStr}</span>
                                <span class="ans-date">${dateStr}</span>
                            </div>
                        </div>
                    </div>`;
                fragment.appendChild(card);
            }

            feedEl.innerHTML = "";
            feedEl.appendChild(fragment);

            if (typeof AdsManager !== 'undefined') AdsManager.injectAds(feedEl);

            // ── Online Presence Dots ──
if (!window._presenceActiveListeners) window._presenceActiveListeners = {};
if (!window._presenceCache) window._presenceCache = {};
if (window._presenceListeners) window._presenceListeners.forEach(fn => fn());
window._presenceListeners = [];
const rtdb = firebase.database();

const cardsByUser = {};
feedEl.querySelectorAll('.ans-card').forEach(card => {
    const dot = card.querySelector('.online-dot');
    if (!dot) return;
    const avatarFrame = card.querySelector('.avatar-frame');
    if (!avatarFrame) return;
    const href = avatarFrame.getAttribute('onclick') || '';
    const match = href.match(/profile\.html\?id=([^']+)/);
    if (!match) return;
    const uid = match[1];
    if (!cardsByUser[uid]) cardsByUser[uid] = [];
    cardsByUser[uid].push(dot);
});

Object.entries(cardsByUser).forEach(([uid, dots]) => {
    const u = userCache[uid] || {};
    if (u.showOnlineStatus === false) {
        dots.forEach(dot => dot.style.display = 'none');
        return;
    }
    // طبّق الكاش فورًا لو موجود
    if (window._presenceCache[uid] !== undefined) {
        const cached = window._presenceCache[uid];
        dots.forEach(dot => {
            dot.style.display = 'block';
            dot.style.background = cached.isOnline ? '#4ade80' : '#555';
            dot.title = cached.isOnline ? 'متصل الآن' : (cached.title || '');
        });
    }
    // listener واحد بس لكل uid
    if (window._presenceActiveListeners[uid]) return;
    const ref = rtdb.ref('presence/' + uid);
    const listener = ref.on('value', snap => {
        const p = snap.val();
        const isOnline = p && p.isOnline;
        let title = '';
        if (!isOnline && p && p.lastSeenAt) {
            const diff = Date.now() - p.lastSeenAt;
            const mins = Math.floor(diff / 60000);
            const hrs  = Math.floor(diff / 3600000);
            const days = Math.floor(diff / 86400000);
            title = mins < 1 ? 'منذ لحظات' : mins < 60 ? 'منذ ' + mins + ' دقيقة' : hrs < 24 ? 'منذ ' + hrs + ' ساعة' : 'منذ ' + days + ' يوم';
        }
        window._presenceCache[uid] = { isOnline, title };
        document.querySelectorAll('#odot-' + uid).forEach(dot => {
            dot.style.display = 'block';
            dot.style.background = isOnline ? '#4ade80' : '#555';
            dot.title = isOnline ? 'متصل الآن' : title;
        });
    });
    window._presenceActiveListeners[uid] = listener;
    window._presenceListeners.push(() => {
        ref.off('value', listener);
        delete window._presenceActiveListeners[uid];
        delete window._presenceCache[uid];
    });
});

        }, err => console.log("Feed error:",err));
};

/* إعادة رسم الفيد عند تغيير اللغة */
document.addEventListener('langChanged', () => {
    if (currentUser) renderFeed();
});

/* ── Search ── */
const searchInput  = document.getElementById('userSearch');
const searchResBox = document.getElementById('searchResultContainer');
const searchList   = document.getElementById('usersResultList');
let searchTimeout  = null;

searchInput.addEventListener('input', (e) => {
    clearTimeout(searchTimeout);
    const query = e.target.value.trim().toLowerCase();
    if (query.length < 1) { searchResBox.style.display='none'; return; }
    searchTimeout = setTimeout(async () => {
        try {
            const snap = await db.collection("users")
                .where("username",">=",query).where("username","<=",query+"\uf8ff").limit(5).get();
            searchList.innerHTML = "";
            if (snap.empty) {
                searchList.innerHTML = `<div style="padding:15px;text-align:center;font-size:12px;color:#555;">لا توجد نتائج</div>`;
            } else {
                snap.forEach(doc => {
                    const u = doc.data();
                    const div = document.createElement('div');
                    div.className = 'user-res-item';
                    div.onclick   = () => location.href=`profile.html?id=${doc.id}`;
                    div.innerHTML = `
                        <img src="${safe(u.avatarUrl||'images/user.png')}"
                             style="width:30px;height:30px;border-radius:50%;object-fit:cover;"
                             onerror="this.src='images/user.png'">
                        <div>
                            <div style="font-size:12px;font-weight:700;">${safe(u.name||"غريب")}</div>
                            <div style="font-size:10px;color:#555;">@${safe(u.username)}</div>
                        </div>`;
                    searchList.appendChild(div);
                });
            }
            searchResBox.style.display = 'flex';
        } catch(e) { console.log("Search error:",e); }
    }, 300);
});

function clearSearch() { searchInput.value=""; searchResBox.style.display='none'; }

/* ── Report ── */
async function reportContent(id, uid) {
    if (!currentUser) return location.href = 'signin.html';
    const reason = await customPrompt(LangManager.t('report_reason'), true);
    if (reason && reason.length > 0) {
        try {
            await db.collection("reports").add({
                targetId:id, type:'answer', targetUser:uid,
                reporter:currentUser.uid, reason:reason.substring(0,300),
                time:firebase.firestore.FieldValue.serverTimestamp()
            });
            showToast(LangManager.t('report_success'));
        } catch(e) { showToast(LangManager.t('error_generic')); }
    }
}

/* ── Like ── */
let likeLock = false;
async function toggleLike(id, ownerId) {
    if (!currentUser) return location.href = 'signin.html';
    if (likeLock) return;
    likeLock = true;

    const card = document.querySelector(`.ans-card[data-id="${id}"]`);
    const btn = card?.querySelector('.action-btn');
    const icon = btn?.querySelector('i');
    const countSpan = btn?.querySelector('span');
    const isLiked = btn?.classList.contains('liked');
    const currentCount = parseInt(countSpan?.textContent || '0');

    if (isLiked) {
        btn.classList.remove('liked');
        if (icon) icon.className = 'fa-regular fa-heart';
        if (countSpan) countSpan.textContent = Math.max(0, currentCount - 1);
    } else {
        btn.classList.add('liked');
        if (icon) icon.className = 'fa-solid fa-heart';
        if (countSpan) countSpan.textContent = currentCount + 1;
    }

    try {
        const ref = db.collection("answers").doc(id);
        if (isLiked) {
            await ref.update({
                likedBy: firebase.firestore.FieldValue.arrayRemove(currentUser.uid),
                likesCount: firebase.firestore.FieldValue.increment(-1)
            });
            if (ownerId && ownerId !== currentUser.uid) {
                await db.collection("users").doc(ownerId).update({
                    totalLikes: firebase.firestore.FieldValue.increment(-1),
                    anonCoins: firebase.firestore.FieldValue.increment(-1)
                });
            }
        } else {
            await ref.update({
                likedBy: firebase.firestore.FieldValue.arrayUnion(currentUser.uid),
                likesCount: firebase.firestore.FieldValue.increment(1)
            });
            if (ownerId && ownerId !== currentUser.uid) {
                await db.collection("users").doc(ownerId).update({
                    totalLikes: firebase.firestore.FieldValue.increment(1),
                    anonCoins: firebase.firestore.FieldValue.increment(1)
                });
            }
            createNotification(ownerId, 'like', id);
        }
    } catch(e) {
        console.log("Like error:", e);
        if (isLiked) {
            btn.classList.add('liked');
            if (icon) icon.className = 'fa-solid fa-heart';
            if (countSpan) countSpan.textContent = currentCount;
        } else {
            btn.classList.remove('liked');
            if (icon) icon.className = 'fa-regular fa-heart';
            if (countSpan) countSpan.textContent = currentCount;
        }
    } finally {
        likeLock = false;
    }
}
/* ── Delete ── */
async function deleteAnswer(aid, qid) {
    if (!currentUser) return location.href = 'signin.html';
    const confirmed = await customPrompt(LangManager.t('delete_confirm'), false);
    if (confirmed) {
        try {
            await db.collection("answers").doc(aid).delete();
            if (qid) {
                const qDoc = await db.collection("questions").doc(qid).get();
                if (qDoc.exists) {
                    await db.collection("questions").doc(qid).update({status:"pending"});
                }
            }
            await db.collection("users").doc(currentUser.uid).update({
                answersCount: firebase.firestore.FieldValue.increment(-1)
            });
            showToast(LangManager.t('deleted_ok'));
        } catch(e) {
            console.log("Delete error:", e);
            showToast(LangManager.t('delete_error'));
        }
    }
}

function showToast(m) {
    const t = document.getElementById('toast');
    t.innerText=m; t.style.display='block';
    setTimeout(()=>t.style.display='none',2500);
}

/* ── Auth ── */
auth.onAuthStateChanged(async user => {
    if (user) {
        currentUser = user;
        document.getElementById('myProfileLink').href = `profile.html?id=${user.uid}`;
        initFCM(user.uid);
        const uSnap = await db.collection('users').doc(user.uid).get();
        const uData = uSnap.exists ? uSnap.data() : {};
        currentUserLang    = uData.language || uData.lang?.toLowerCase() || 'ar';
        currentUserCountry = uData.country  || '';
        if (typeof AdsManager !== 'undefined' && typeof AdsManager.init === 'function') {
    AdsManager.init(uData);
}
renderFeed();
startListening(user.uid);
    } else {
        currentUser = null;
        const link = document.getElementById('myProfileLink');
        if (link) link.href = 'signin.html';
        if (typeof AdsManager !== 'undefined' && typeof AdsManager.init === 'function') {
            AdsManager.init({});
        }
        renderFeed();
    }
});

/* ── Butterflies ── */
function createButterfly() {
    if (document.querySelectorAll('.butterfly').length > 6) return;
    const bf = document.createElement('div');
    bf.className = 'butterfly';
    bf.innerHTML = '<div class="wing left-wing"></div><div class="wing right-wing"></div>';
    document.body.appendChild(bf);
    let x=Math.random()*window.innerWidth, y=Math.random()*window.innerHeight;
    let vX=(Math.random()-0.5)*0.8, vY=(Math.random()-0.5)*0.8, animFrame;
    function move() {
        vX+=(Math.random()-0.5)*0.15; vY+=(Math.random()-0.5)*0.15;
        const spd=Math.sqrt(vX**2+vY**2);
        if(spd>1.2){vX=vX/spd*1.2;vY=vY/spd*1.2;}
        x+=vX; y+=vY;
        if(x<=10||x>=window.innerWidth-40)  vX*=-1;
        if(y<=10||y>=window.innerHeight-40) vY*=-1;
        bf.style.left=x+'px'; bf.style.top=y+'px';
        bf.style.transform=`rotateZ(${Math.atan2(vY,vX)+Math.PI/2}rad) rotateX(20deg)`;
        if(document.body.contains(bf)) animFrame=requestAnimationFrame(move);
    }
    move();
    setTimeout(()=>{
        cancelAnimationFrame(animFrame);
        bf.style.opacity='0'; bf.style.transition='opacity 4s';
        setTimeout(()=>{ if(bf.parentNode) bf.remove(); },4000);
    },18000);
}
setInterval(createButterfly,6000);

/* ══════════════════════════════════════
   PWA Install — كامل ومحسَّن
══════════════════════════════════════ */
let deferredPrompt  = null;
const installBanner = document.getElementById('pwa-install-banner');
const iosBanner     = document.getElementById('ios-install-banner');
const PWA_KEY       = 'pwa_install_dismissed';
const PWA_DAYS      = 7;

/* ── منطق البانر الجديد: يظهر كل مرتين لحد ما يضغط تحميل ── */
const isPWAInstalled = () => window.matchMedia("(display-mode: standalone)").matches || navigator.standalone===true;
const wasDismissedRecently = () => { const d=localStorage.getItem(PWA_KEY); return d&&(Date.now()-parseInt(d))/86400000<PWA_DAYS; };
const isIOS = () => /iPad|iPhone|iPod/.test(navigator.userAgent) && !window.MSStream;
(function() {
    if (isPWAInstalled()) return;
    if (localStorage.getItem('apk_downloaded') === '1') return;

    let visits = parseInt(localStorage.getItem('apk_banner_visits') || '0') + 1;
    localStorage.setItem('apk_banner_visits', visits);

    if (visits % 2 === 0) {
        setTimeout(() => { installBanner.style.display = 'flex'; }, 2000);
    }
})();


/* 1 — احتجاز حدث التثبيت ومنع الظهور التلقائي */
window.addEventListener('beforeinstallprompt', (e) => {
    e.preventDefault();
    deferredPrompt = e;
    if (isPWAInstalled() || wasDismissedRecently()) return;
    setTimeout(() => { installBanner.style.display='flex'; }, 3000);
});

/* 2 — زر التثبيت يُفعّل الحدث المحتجز */
document.getElementById('pwa-install-btn').addEventListener('click', () => {
    localStorage.setItem('apk_downloaded', '1');
    installBanner.style.display = 'none';
});

/* 3 — لاحقاً */
document.getElementById('pwa-dismiss-btn').addEventListener('click', () => {
    installBanner.style.display = 'none';
});

/* 4 — إغلاق iOS */
document.getElementById('ios-dismiss-btn').addEventListener('click', () => {
    iosBanner.style.display = 'none';
    localStorage.setItem(PWA_KEY, Date.now().toString());
});

/* 5 — iOS banner */
window.addEventListener('load', () => {
    if (isIOS() && !isPWAInstalled() && !wasDismissedRecently())
        setTimeout(() => { iosBanner.style.display='flex'; }, 3000);
});

/* 6 — بعد التثبيت */
window.addEventListener('appinstalled', () => {
    installBanner.style.display = 'none';
    iosBanner.style.display     = 'none';
    deferredPrompt              = null;
    showToast(LangManager.t('installed_ok'));
});

/* ── Service Worker ── */
if ('serviceWorker' in navigator) {
    window.addEventListener('load', () => {
        navigator.serviceWorker.register('service-worker.js')
            .then(r  => console.log('SW registered',r))
            .catch(e => console.log('SW failed',e));
    });
}
  /* ══════════════════════════════════════
   FEED TABS
══════════════════════════════════════ */
function switchFeedTab(tab) {
    // إخفاء كل المحتوى
    document.getElementById('askFeed').style.display        = 'none';
    document.getElementById('leaderboardTab').style.display = 'none';
    document.getElementById('vipTab').style.display         = 'none';

    // إزالة active من كل التابس
    document.getElementById('tabFeed').classList.remove('active');
    document.getElementById('tabLeader').classList.remove('active');
    document.getElementById('tabVip').classList.remove('active');

    if (tab === 'feed') {
        document.getElementById('askFeed').style.display = 'block';
        document.getElementById('tabFeed').classList.add('active');
        // إعادة تحميل الفيد لو فاضي
        if (!document.getElementById('askFeed').hasChildNodes()) renderFeed();

    } else if (tab === 'leader') {
        document.getElementById('leaderboardTab').style.display = 'block';
        document.getElementById('tabLeader').classList.add('active');
        // إعادة تحميل لو الفلاج اتعمل reset
        if (!leaderLoaded) loadLeaderboard();

    } else if (tab === 'vip') {
    location.href = 'verification.html';
}
}
/* ══════════════════════════════════════
   LEADERBOARD
══════════════════════════════════════ */
let leaderLoaded = false;

async function loadLeaderboard() {
    if (leaderLoaded) return;
    const el = document.getElementById('leaderboardTab');
    el.innerHTML = `
        <div class="skeleton" style="height:80px;border-radius:20px;margin-bottom:12px;background:rgba(255,255,255,0.04);"></div>
        <div class="skeleton" style="height:80px;border-radius:20px;margin-bottom:12px;background:rgba(255,255,255,0.04);"></div>
        <div class="skeleton" style="height:80px;border-radius:20px;margin-bottom:12px;background:rgba(255,255,255,0.04);"></div>`;

    try {
        const now = new Date();
        const dayOfWeek = now.getDay();
        const startWeek = new Date(now);
        startWeek.setDate(now.getDate() - dayOfWeek);
        startWeek.setHours(0,0,0,0);
        const endWeek = new Date(startWeek);
        endWeek.setDate(startWeek.getDate() + 7);

        const startTs = firebase.firestore.Timestamp.fromDate(startWeek);
        const endTs   = firebase.firestore.Timestamp.fromDate(endWeek);

        const answersSnap = await db.collection('answers')
            .where('answeredAt', '>=', startTs)
            .where('answeredAt', '<',  endTs)
            .get();

        const likesMap   = {};
        const answersMap = {};
        const coinsMap   = {};

        answersSnap.forEach(doc => {
            const d   = doc.data();
            const uid = d.userId;
            if (!uid) return;
            const likedBy = Array.isArray(d.likedBy) ? d.likedBy.length : 0;
const likesArr = Array.isArray(d.likes) ? d.likes.length : 0;
const likes = Math.max(likedBy, likesArr, d.likesCount || 0);
            likesMap[uid]   = (likesMap[uid]   || 0) + likes;
            answersMap[uid] = (answersMap[uid] || 0) + 1;
        });

        const allUids = new Set([...Object.keys(likesMap), ...Object.keys(answersMap)]);
        allUids.forEach(uid => {
            const likeCoins   = Math.floor((likesMap[uid]   || 0) / 100) * 10;
            const answerCoins = (answersMap[uid] || 0) * 1;
            coinsMap[uid]     = likeCoins + answerCoins;
        });

        // ✅ sorted مرة واحدة بس
        const sorted = Object.entries(coinsMap)
            .sort((a, b) => b[1] - a[1])
            .slice(0, 10);

        if (sorted.length === 0) {
            el.innerHTML = `<div style="text-align:center;padding:50px 20px;color:#444;">
                <i class="fa-solid fa-trophy" style="font-size:40px;margin-bottom:15px;display:block;"></i>
                <p style="font-size:13px;font-weight:700;">لا توجد بيانات هذا الأسبوع بعد</p>
            </div>`;
            return;
        }

        const userIds   = sorted.map(([uid]) => uid);
        const userCache = {};
        await Promise.all(userIds.map(async uid => {
            try {
                const s = await db.collection('users').doc(uid).get();
                userCache[uid] = s.exists ? s.data() : {};
            } catch(e) { userCache[uid] = {}; }
        }));

        const myRank  = sorted.findIndex(([uid]) => uid === currentUser?.uid);
        const myCoins = myRank >= 0 ? sorted[myRank][1] : (coinsMap[currentUser?.uid] || 0);
        const myLikes = likesMap[currentUser?.uid] || 0;

        const rankEmojis = ['🥇','🥈','🥉'];
        const startDate  = startWeek.toLocaleDateString('ar-EG', {month:'long', day:'numeric'});
        const endDate    = new Date(endWeek.getTime()-1).toLocaleDateString('ar-EG', {month:'long', day:'numeric'});

        let html = `
            <div class="week-header">
                <h3>🏆 أبطال الأسبوع</h3>
                <p>${startDate} — ${endDate}</p>
            </div>`;

        if (currentUser) {
            html += `
                <div class="my-rank-bar">
                    <span class="my-rank-label">
                        ${myRank >= 0 ? `ترتيبك: #${myRank+1}` : 'ترتيبك: خارج القائمة'}
                    </span>
                    <span class="my-rank-likes">
                        ❤️ ${myLikes} لايك · 🪙 ${myCoins} كوين
                    </span>
                </div>`;
        }

        // ✅ كل المتغيرات معرّفة داخل اللوب
        sorted.forEach(([uid, coins], i) => {
            const u           = userCache[uid] || {};
            const rank        = i + 1;
            const rankClass   = rank <= 3 ? `rank-${rank}` : 'rank-other';
            const rankIcon    = rank <= 3 ? rankEmojis[i] : `#${rank}`;
            const isMe        = uid === currentUser?.uid;
            const likeCoins   = Math.floor((likesMap[uid] || 0) / 100) * 10;
            const answerCoins = (answersMap[uid] || 0) * 1;
            const answers     = answersMap[uid] || 0;
            const likes       = likesMap[uid]   || 0;

            html += `
                <div class="leader-card"
                     onclick="location.href='profile.html?id=${uid}'"
                     style="${isMe ? 'border-color:rgba(248,5,102,0.5);background:rgba(248,5,102,0.04);' : ''}">
                    <div class="leader-rank ${rankClass}">${rankIcon}</div>
                    <img src="${safe(u.avatarUrl || 'images/user.png')}"
      class="leader-avatar"
      onerror="this.src='images/user.png'" loading="lazy" width="52" height="52">
                    <div class="leader-info">
                        <div class="leader-name">${safe(u.name || 'مستخدم')} ${isMe ? '(أنت)' : ''}</div>
                        <div class="leader-username">@${safe(u.username || '')}</div>
                    </div>
                    <div class="leader-likes">
                        <span style="font-size:12px;color:#aaa;font-weight:700;">
                            ❤️ ${likes.toLocaleString()} · 💬 ${answers}
                        </span>
                        <span style="font-size:10px;color:#666;">لايك · إجابة</span>
                        ${coins > 0 ? `
                        <div class="leader-coins-badge">
                            <i class="fa-solid fa-coins"></i> +${coins} كوين
                        </div>
                        <div style="font-size:9px;color:#666;margin-top:2px;">
                            ${likeCoins > 0 ? `❤️ ${likeCoins}` : ''}
                            ${likeCoins > 0 && answerCoins > 0 ? ' + ' : ''}
                            ${answerCoins > 0 ? `💬 ${answerCoins}` : ''}
                        </div>` : ''}
                    </div>
                </div>`;
        });

        el.innerHTML = html;
        await distributeWeeklyCoins(sorted, likesMap, answersMap, coinsMap);
        leaderLoaded = true;

    } catch(e) {
        console.error('Leaderboard error:', e);
        el.innerHTML = `<div style="text-align:center;padding:40px;color:#444;">
            <p style="font-size:13px;">حدث خطأ في تحميل البيانات</p>
        </div>`;
    }
}

/* ══════════════════════════════════════
   توزيع الكوينز الأسبوعية
══════════════════════════════════════ */
async function distributeWeeklyCoins(sorted, likesMap, answersMap, coinsMap) {
    if (!currentUser) return;

    const now = new Date();
    const weekStart = new Date(now);
    weekStart.setDate(now.getDate() - now.getDay());
    weekStart.setHours(0,0,0,0);
    const weekKey = `week_${weekStart.getFullYear()}_${weekStart.getMonth()}_${weekStart.getDate()}`;

    const myEntry = sorted.find(([uid]) => uid === currentUser.uid);
    if (myEntry) {
        const [uid, coins] = myEntry;
        if (coins > 0) {
            try {
                const rewardRef = db.collection('users').doc(uid)
                    .collection('weeklyRewards').doc(weekKey);
                const rewardDoc = await rewardRef.get();
                if (!rewardDoc.exists) {
                    const batch = db.batch();
                    batch.update(db.collection('users').doc(uid), {
                        anonCoins: firebase.firestore.FieldValue.increment(coins)
                    });
                    batch.set(rewardRef, {
                        weekKey,
                        likes:   likesMap[uid]   || 0,
                        answers: answersMap[uid] || 0,
                        coins,
                        distributedAt: firebase.firestore.FieldValue.serverTimestamp()
                    });
                    await batch.commit();
                    showToast(`🎉 مبروك! حصلت على ${coins} كوينز هذا الأسبوع!`);
                }
            } catch(e) {
                console.error('distributeWeeklyCoins error:', e);
            }
        }
    }
}
  /* ══════════════════════════════════════
   VIP TAB
══════════════════════════════════════ */
let vipLoaded = false;

async function loadVipTab() {
    if (vipLoaded) return;
    vipLoaded = true;
    const el = document.getElementById('vipTab');
    el.innerHTML = '<div style="text-align:center;padding:40px;color:#555;">جارٍ التحميل...</div>';

    try {
        const myDoc  = await db.collection('users').doc(currentUser.uid).get();
        const myData = myDoc.data() || {};
        const isVip  = !!(myData.isVerified || myData.isPremium);

        const weekStart = new Date();
        weekStart.setDate(weekStart.getDate() - weekStart.getDay());
        weekStart.setHours(0,0,0,0);
        const weekEnd = new Date(weekStart);
        weekEnd.setDate(weekStart.getDate() + 7);
        const weekKey = `vip_week_${weekStart.getFullYear()}_${weekStart.getMonth()}_${weekStart.getDate()}`;

        const weekAnswersSnap = await db.collection('answers')
    .where('userId','==', currentUser.uid)
    .get();
const myAnswersCount = weekAnswersSnap.docs.filter(d => {
    const t = d.data().answeredAt?.toDate();
    return t && t >= weekStart && t < weekEnd;
}).length;

        const missions = [
            { id:'answers_50', icon:'💬', iconBg:'rgba(192,132,252,0.15)', title:'أجب على 50 سؤال', target:50, current:Math.min(myAnswersCount,50), reward:2000 },
            { id:'answers_100', icon:'🔥', iconBg:'rgba(248,5,102,0.15)', title:'أجب على 100 سؤال', target:100, current:Math.min(myAnswersCount,100), reward:5000 },
            { id:'likes_200', icon:'❤️', iconBg:'rgba(255,80,100,0.15)', title:'احصل على 200 إعجاب', target:200, current:0, reward:3000 }
        ];

        try {
            const answersSnap = await db.collection('answers').where('userId','==', currentUser.uid).get();
            let totalLikes = 0;
            answersSnap.forEach(d => {
                const data = d.data();
                const likedBy = Array.isArray(data.likedBy) ? data.likedBy.length : 0;
                const likes   = Array.isArray(data.likes)   ? data.likes.length   : 0;
                totalLikes += Math.max(likedBy, likes, data.likesCount || 0);
            });
            missions[2].current = Math.min(totalLikes, 200);
        } catch(e) {}

        let missionsHtml = '';
        for (const m of missions) {
            const pct    = Math.min(100, Math.round((m.current / m.target) * 100));
            const isDone = m.current >= m.target;
            let claimed = false;
            try {
                const claimDoc = await db.collection('users').doc(currentUser.uid)
                    .collection('vipRewards').doc(`${m.id}_${weekKey}`).get();
                claimed = claimDoc.exists;
            } catch(e) {}

            missionsHtml += `
            <div class="mission-card ${isDone ? 'done' : ''}">
                <div class="mission-icon" style="background:${m.iconBg};">${m.icon}</div>
                <div class="mission-info">
                    <div class="mission-title">${m.title}</div>
                    <div style="font-size:10px;color:#666;margin-bottom:4px;">${m.current} / ${m.target}</div>
                    <div class="mission-progress-bar">
                        <div class="mission-progress-fill" style="width:${pct}%;"></div>
                    </div>
                </div>
                <div class="mission-reward">
                    <div class="mission-coins"><img src="images/logo.png" alt=""> +${m.reward.toLocaleString()}</div>
                    ${claimed
                        ? `<div class="mission-done-badge">✅ تم الاستلام</div>`
                        : isDone
                            ? `<button onclick="claimVipReward('${m.id}','${weekKey}',${m.reward})"
                                  style="background:linear-gradient(135deg,#c084fc,#818cf8);border:none;
                                         color:#fff;font-family:'Cairo';font-weight:800;font-size:11px;
                                         padding:6px 12px;border-radius:20px;cursor:pointer;">استلام 🎁</button>`
                            : `<span style="font-size:10px;color:#555;font-weight:700;">${pct}%</span>`
                    }
                </div>
            </div>`;
        }

        let coinsHtml = '';
        try {
            const topSnap = await db.collection('users').orderBy('anonCoins','desc').limit(10).get();
            topSnap.forEach((doc, i) => {
                const u = doc.data();
                const rank = i + 1;
                const emojis = ['🥇','🥈','🥉'];
                const rankIcon = rank <= 3 ? emojis[rank-1] : `#${rank}`;
                const isMe = doc.id === currentUser?.uid;
                const coins = (u.anonCoins || 0).toFixed(2);
                coinsHtml += `
                <div class="coins-card" onclick="location.href='profile.html?id=${doc.id}'"
                     ${isMe ? 'style="border-color:rgba(255,204,0,0.35);background:rgba(255,204,0,0.03);"' : ''}>
                    <span class="coins-rank">${rankIcon}</span>
                    <img src="${safe(u.avatarUrl||'images/user.png')}" class="coins-avatar" onerror="this.src='images/user.png'" loading="lazy" width="40" height="40">
                    <div class="coins-info">
                        <div class="coins-name">${safe(u.name||'مستخدم')} ${isMe?'(أنت)':''}</div>
                        <div class="coins-username">@${safe(u.username||'')}</div>
                    </div>
                    <div class="coins-amount"><img src="images/logo.png" alt="coin"> ${parseFloat(coins).toLocaleString()}</div>
                </div>`;
            });
        } catch(e) { coinsHtml = '<p style="color:#555;font-size:12px;text-align:center;">تعذّر التحميل</p>'; }

        const trackerPct  = Math.min(100, Math.round((myAnswersCount / 50) * 100));
        const trackerDone = myAnswersCount >= 50;
        const dotsHtml    = Array.from({length: 50}, (_, i) =>
            `<div class="tracker-dot ${i < myAnswersCount ? (trackerDone ? 'filled done-dot' : 'filled') : ''}"></div>`
        ).join('');

        const vipBannerHtml = isVip ? `
            <div class="vip-coins-banner">
                <span class="banner-icon">⚡</span>
                <div class="banner-text">
                    <strong>أنت مشترك VIP — كوينزك مضاعفة!</strong>
                    <span>تحصل على <span style="color:#ffd700;font-weight:900;">×2 كوينز</span> على كل مهمة +
                        <span class="vip-badge-inline"><img src="images/verified-logo.png" alt=""> توثيق</span> على بروفايلك
                    </span>
                </div>
                <div class="vip-multiplier-tag">×2 🪙</div>
            </div>` : '';

        const ctaHtml = `
            <a href="verification.html" class="vip-cta-btn">
                <span class="cta-arrow">←</span>
                <span>احصل على توثيق VIP</span>
                <span style="font-size:18px;">👑</span>
            </a>
            <div class="vip-future-features">
                <div class="vip-future-title">✨ مميزات قادمة</div>
                <div class="future-feature-item"><span class="ff-icon">🎨</span> إطار بروفايل حصري للـ VIP <span class="ff-soon">قريباً</span></div>
                <div class="future-feature-item"><span class="ff-icon">📌</span> تثبيت إجابة على بروفايلك <span class="ff-soon">قريباً</span></div>
                <div class="future-feature-item"><span class="ff-icon">🚀</span> أولوية في الـ Feed <span class="ff-soon">قريباً</span></div>
                <div class="future-feature-item"><span class="ff-icon">🎁</span> مكافآت شهرية حصرية <span class="ff-soon">قريباً</span></div>
            </div>`;

        el.innerHTML = `
            <div class="vip-hero">
                <span class="vip-crown-icon">👑</span>
                <h2>مهام VIP الأسبوعية</h2>
                <p>أكمل المهام كل أسبوع واحصل على مكافآت ضخمة بالعملات</p>
                <div class="vip-reward"><img src="images/logo.png" alt="coin"> حتى 10,000 عملة أسبوعياً</div>
            </div>
            ${vipBannerHtml}
            <div class="weekly-tracker-card ${isVip ? 'vip-member' : ''}">
                <div class="tracker-header">
                    <div class="tracker-title">💬 تقدم الأسبوع
                        ${isVip ? '<span class="vip-badge-inline"><img src="images/verified-logo.png" alt=""> VIP</span>' : ''}
                    </div>
                    <div class="tracker-count ${trackerDone ? 'done' : ''}">${myAnswersCount} / 50 ${trackerDone ? '✅' : ''}</div>
                </div>
                <div class="tracker-bar-bg">
                    <div class="tracker-bar-fill ${trackerDone ? 'done' : ''}" style="width:${trackerPct}%;"></div>
                </div>
                <div class="tracker-dots">${dotsHtml}</div>
                <div class="tracker-footer">
                    <span>الهدف: 50 إجابة أسبوعياً</span>
                    <span style="color:${trackerDone ? '#00e676' : '#c084fc'};">
                        ${trackerDone ? '🎉 أكملت الهدف!' : `باقي ${50 - myAnswersCount} إجابة`}
                    </span>
                </div>
            </div>
            ${missionsHtml}
            <div class="coins-section-title"><img src="images/logo.png" alt="coin"> أثرى المستخدمين</div>
            ${coinsHtml}
            ${ctaHtml}
        `;

    } catch(e) {
        console.error('VIP tab error:', e);
        vipLoaded = false;
        el.innerHTML = '<div style="text-align:center;padding:40px;color:#444;">حدث خطأ في التحميل، اضغط مجدداً</div>';
    }
}
/* ══════════════════════════════════════
   CLAIM VIP REWARD
══════════════════════════════════════ */
async function claimVipReward(missionId, weekKey, amount) {
    if (!currentUser) return;
    const rewardKey = `${missionId}_${weekKey}`;
    const rewardRef = db.collection('users').doc(currentUser.uid)
        .collection('vipRewards').doc(rewardKey);

    try {
        const doc = await rewardRef.get();
        if (doc.exists) return showToast('✅ تم استلام المكافأة مسبقاً');

        const batch = db.batch();
        batch.update(db.collection('users').doc(currentUser.uid), {
            anonCoins: firebase.firestore.FieldValue.increment(amount)
        });
        batch.set(rewardRef, {
            missionId, weekKey, amount,
            claimedAt: firebase.firestore.FieldValue.serverTimestamp()
        });
        await batch.commit();

        showToast(`🎉 مبروك! استلمت ${amount.toLocaleString()} عملة!`);
        vipLoaded = false;
        loadVipTab();
    } catch(e) {
        console.error('claimVipReward:', e);
        showToast('حدث خطأ، حاول مجدداً');
    }
}
</script>
<!-- ══ BIRTHDAY CELEBRATION ══ -->
<canvas id="bdayCanvas" style="position:fixed;inset:0;pointer-events:none;z-index:99998;"></canvas>

<div id="bdayModal" style="display:none;position:fixed;inset:0;z-index:99999;background:rgba(0,0,0,0.85);backdrop-filter:blur(12px);align-items:center;justify-content:center;padding:20px;">
  <div style="background:linear-gradient(145deg,#0e0e0e,#1a0010);border:1px solid rgba(248,5,102,0.4);border-radius:28px;padding:32px 24px;text-align:center;max-width:340px;width:100%;box-shadow:0 0 60px rgba(248,5,102,0.2);position:relative;overflow:hidden;">
    <div style="position:absolute;inset:0;background:radial-gradient(circle at 50% 0%,rgba(248,5,102,0.1),transparent 65%);pointer-events:none;"></div>
    <div style="font-size:56px;margin-bottom:12px;animation:bdFloat 2s ease-in-out infinite;">🎂</div>
    <div style="font-size:20px;font-weight:900;color:#fff;margin-bottom:8px;">عيد ميلاد سعيد! 🎉</div>
    <div style="font-size:13px;color:#aaa;line-height:1.8;margin-bottom:20px;">
      يسعدنا يوم ميلادك! 🎂<br>
      تفقّد <strong style="color:#f80566;">بريدك الإلكتروني</strong><br>
      بعتنالك هدية خاصة منّا 🎁
    </div>
    <button onclick="closeBdayModal()" style="width:100%;padding:14px;background:linear-gradient(135deg,#f80566,#c4024e);color:#fff;border:none;border-radius:50px;font-family:'Cairo';font-size:15px;font-weight:800;cursor:pointer;box-shadow:0 6px 20px rgba(248,5,102,0.35);">
      📧 تمام، هشوف البريد
    </button>
  </div>
</div>

<style>
@keyframes bdFloat { 0%,100%{transform:translateY(0);} 50%{transform:translateY(-8px);} }

/* Gift + Floater في الفيد */
.coin-float {
    position: fixed;
    font-size: 11px;
    font-weight: 900;
    color: #ffcc00;
    pointer-events: none;
    z-index: 9999;
    animation: coinFloatUp 2s ease-in-out forwards;
    background: rgba(255,204,0,0.1);
    border: 1px solid rgba(255,204,0,0.25);
    border-radius: 50px;
    padding: 3px 8px;
    display: flex;
    align-items: center;
    gap: 4px;
    white-space: nowrap;
}
@keyframes coinFloatUp {
    0%   { opacity: 0; transform: translateY(0) scale(0.8); }
    20%  { opacity: 1; transform: translateY(-10px) scale(1); }
    70%  { opacity: 1; transform: translateY(-50px) scale(1.1); }
    100% { opacity: 0; transform: translateY(-80px) scale(0.9); }
}
.gift-btn {
    background: none;
    border: 1px solid rgba(255,204,0,0.2);
    border-radius: 50px;
    color: #666;
    cursor: pointer;
    display: flex;
    align-items: center;
    gap: 5px;
    transition: all 0.2s;
    font-family: 'Cairo';
}
.gift-btn:hover:not(:disabled) {
    border-color: rgba(255,204,0,0.5);
    color: #ffcc00;
    background: rgba(255,204,0,0.05);
}
.gift-btn .gift-count {
    background: rgba(255,204,0,0.15);
    border-radius: 50px;
    padding: 1px 6px;
    font-size: 11px;
    color: #ffcc00;
    font-weight: 800;
}

.card-menu-btn{background:none;border:none;color:#555;font-size:18px;cursor:pointer;padding:4px 8px;border-radius:8px;transition:.2s;}
.card-menu-btn:hover{color:#aaa;background:rgba(255,255,255,.05);}
.card-menu{position:absolute;top:30px;left:0;background:#111;border:1px solid rgba(255,255,255,.08);border-radius:14px;padding:6px;display:none;flex-direction:column;gap:4px;z-index:100;min-width:130px;box-shadow:0 8px 24px rgba(0,0,0,.5);}
.card-menu.show{display:flex;}
.card-menu-item{background:none;border:none;color:#aaa;font-family:"Cairo";font-size:13px;font-weight:700;padding:9px 12px;border-radius:10px;cursor:pointer;display:flex;align-items:center;gap:9px;text-align:right;width:100%;transition:.2s;}
.card-menu-item:hover{background:rgba(255,255,255,.05);color:white;}
.share-item i{color:#f80566;}
.report-item i{color:#ff4444;}
.delete-item i{color:#ff4444;}
</style>

<script>
/* ══ BIRTHDAY SYSTEM ══ */
(async function initBirthday() {
  const _auth = firebase.auth();
  const _db   = firebase.firestore();
  _auth.onAuthStateChanged(async (user) => {
    if (!user) return;

    const uid      = user.uid;
    const today    = new Date();
    const mm       = String(today.getMonth()+1).padStart(2,'0');
    const dd       = String(today.getDate()).padStart(2,'0');
    const todayMD  = `${mm}${dd}`;
    const year     = today.getFullYear();
    const shownKey = `bdayModalShown_${year}`;

    if (localStorage.getItem(shownKey)) {
      startConfetti();
      startBdayParticles();
      return;
    }

    const userSnap = await _db.collection('users').doc(uid).get();
    if (!userSnap.exists) return;
    const userData = userSnap.data();

    const birthdayMMDD = userData.birthdayMMDD || '';
    if (birthdayMMDD !== todayMD) return;

    document.getElementById('bdayModal').style.display = 'flex';
    startConfetti();
    startBdayParticles();
    localStorage.setItem(shownKey, '1');
  });
})();

function closeBdayModal() {
  document.getElementById('bdayModal').style.display = 'none';
  // نظّف الـ URL من الـ parameter
}

/* ══ CONFETTI ══ */
function startConfetti() {
  const canvas = document.getElementById('bdayCanvas');
  const ctx    = canvas.getContext('2d');
  canvas.width  = window.innerWidth;
  canvas.height = window.innerHeight;

  const colors  = ['#f80566','#ff6b6b','#ffd166','#06d6a0','#118ab2','#c084fc','#fff'];
  const pieces  = Array.from({length: 120}, () => ({
    x:     Math.random() * canvas.width,
    y:     Math.random() * canvas.height - canvas.height,
    w:     Math.random() * 10 + 5,
    h:     Math.random() * 6 + 3,
    color: colors[Math.floor(Math.random() * colors.length)],
    rot:   Math.random() * 360,
    vX:    (Math.random() - 0.5) * 3,
    vY:    Math.random() * 3 + 1,
    vR:    (Math.random() - 0.5) * 5,
  }));

  let frame;
  const end = Date.now() + 8000; // 8 ثواني أول ما يفتح

  function draw() {
    ctx.clearRect(0, 0, canvas.width, canvas.height);
    pieces.forEach(p => {
      ctx.save();
      ctx.translate(p.x, p.y);
      ctx.rotate(p.rot * Math.PI / 180);
      ctx.fillStyle = p.color;
      ctx.fillRect(-p.w/2, -p.h/2, p.w, p.h);
      ctx.restore();
      p.x  += p.vX;
      p.y  += p.vY;
      p.rot += p.vR;
      if (p.y > canvas.height) { p.y = -10; p.x = Math.random() * canvas.width; }
    });
    if (Date.now() < end) frame = requestAnimationFrame(draw);
    else ctx.clearRect(0, 0, canvas.width, canvas.height);
  }
  draw();

  // كل 30 دقيقة يعيد المؤثرات طول اليوم
  setInterval(() => {
    const today = new Date();
    if (today.getHours() < 23) {
      cancelAnimationFrame(frame);
      const newEnd = Date.now() + 5000;
      function redraw() {
        ctx.clearRect(0,0,canvas.width,canvas.height);
        pieces.forEach(p => {
          ctx.save(); ctx.translate(p.x,p.y); ctx.rotate(p.rot*Math.PI/180);
          ctx.fillStyle=p.color; ctx.fillRect(-p.w/2,-p.h/2,p.w,p.h); ctx.restore();
          p.x+=p.vX; p.y+=p.vY; p.rot+=p.vR;
          if(p.y>canvas.height){p.y=-10;p.x=Math.random()*canvas.width;}
        });
        if(Date.now()<newEnd) requestAnimationFrame(redraw);
        else ctx.clearRect(0,0,canvas.width,canvas.height);
      }
      redraw();
    }
  }, 30 * 60 * 1000);
}

/* ══ FLOATING EMOJIS ══ */
function startBdayParticles() {
  const emojis = ['🎂','🎉','🎊','🎈','🎁','✨','⭐','🌟'];
  let count = 0;
  const interval = setInterval(() => {
    if (count++ > 20) { clearInterval(interval); return; }
    const el = document.createElement('div');
    el.textContent = emojis[Math.floor(Math.random() * emojis.length)];
    el.style.cssText = `
      position:fixed;
      left:${Math.random()*90+5}%;
      bottom:-50px;
      font-size:${Math.random()*20+20}px;
      pointer-events:none;
      z-index:99997;
      animation:bdRise ${Math.random()*3+4}s ease-out forwards;
    `;
    document.body.appendChild(el);
    setTimeout(() => el.remove(), 7000);
  }, 300);

  // أضف الـ keyframe لو مش موجود
  if (!document.getElementById('bdRiseStyle')) {
    const s = document.createElement('style');
    s.id = 'bdRiseStyle';
    s.textContent = `@keyframes bdRise {
      0%   { transform:translateY(0) scale(0.5); opacity:1; }
      100% { transform:translateY(-100vh) scale(1.2); opacity:0; }
    }`;
    document.head.appendChild(s);
  }
}

/* ══ GIFT IN FEED ══ */
function handleGiftBtn(btn) {
    const answerId = btn.dataset.id;
    const ownerId  = btn.dataset.owner;
    giftCoinsInFeed(answerId, ownerId, btn);
}

let feedGiftHold = null;
function handleGiftDown(btn) {
    handleGiftBtn(btn);
    feedGiftHold = setInterval(() => giftCoinsInFeed(btn.dataset.id, btn.dataset.owner, btn), 600);
}
function handleGiftUp() {
    clearInterval(feedGiftHold);
    feedGiftHold = null;
}

let feedIsGifting = false;

async function giftCoinsInFeed(answerId, answerOwnerId, btn) {
    if (!currentUser) return location.href = 'signin.html';
    if (feedIsGifting) return;
    feedIsGifting = true;
    if (currentUser.uid === answerOwnerId) {
        feedIsGifting = false;
        return;
    }

    const meDoc  = await db.collection('users').doc(currentUser.uid).get();
    const myCoins = parseFloat(meDoc.data()?.anonCoins || 0);
    if (myCoins < 10) {
        feedIsGifting = false;
        return showToast('تحتاج على الأقل 10 عملات 🔥');
    }

    const giftAmount = 10;

    const rect    = btn.getBoundingClientRect();
    const floater = document.createElement('div');
    floater.className = 'coin-float';
    floater.innerHTML = '🔥 +10';
    floater.style.left = (rect.left + rect.width / 2 - 20) + 'px';
    floater.style.top  = (rect.top - 10) + 'px';
    document.body.appendChild(floater);
    setTimeout(() => floater.remove(), 2000);

    const newTotal = (parseInt(btn.dataset.total) || 0) + giftAmount;
    btn.dataset.total = newTotal;
    const countEl = btn.querySelector('.gift-count');
    if (countEl) countEl.textContent = newTotal;

    try {
        const giftRef  = db.collection('answers').doc(answerId).collection('gifts').doc(currentUser.uid);
        const existing = await giftRef.get();
        const prev     = existing.exists ? (existing.data().amount || 0) : 0;

        const batch = db.batch();
        batch.set(giftRef, { amount: prev + giftAmount, giftedAt: firebase.firestore.FieldValue.serverTimestamp() });
        batch.update(db.collection('answers').doc(answerId), {
            giftsTotal: firebase.firestore.FieldValue.increment(giftAmount)
        });
        batch.update(db.collection('users').doc(currentUser.uid), {
            anonCoins:      firebase.firestore.FieldValue.increment(-giftAmount),
            giftsSent:      firebase.firestore.FieldValue.increment(giftAmount),
            totalGiftsSent: firebase.firestore.FieldValue.increment(giftAmount)
        });
        batch.update(db.collection('users').doc(answerOwnerId), {
            anonCoins:           firebase.firestore.FieldValue.increment(giftAmount),
            giftsReceived:       firebase.firestore.FieldValue.increment(giftAmount),
            totalGiftsReceived:  firebase.firestore.FieldValue.increment(giftAmount)
        });
        await batch.commit();
        feedIsGifting = false;
    } catch(e) {
        console.error('giftCoinsInFeed:', e);
        feedIsGifting = false;
        showToast('حدث خطأ، حاول مجدداً');
    }
}

</script>
<script src="fcm-init.js"></script>
<script>
function toggleCardMenu(id){
    const m=document.getElementById("menu-"+id);
    if (!m) return;
    document.querySelectorAll(".card-menu.show").forEach(el=>{if(el.id!=="menu-"+id)el.classList.remove("show")});
    m.classList.toggle("show");
}

/* Event delegation — بدل onclick inline */
document.addEventListener("click", e => {
    // إغلاق المنيو لو ضغط برّه
    if (!e.target.closest(".card-menu-btn") && !e.target.closest(".card-menu"))
        document.querySelectorAll(".card-menu.show").forEach(el => el.classList.remove("show"));

    // menu btn toggle
    const menuBtn = e.target.closest(".card-menu-btn");
    if (menuBtn) {
        const card = menuBtn.closest(".ans-card");
        if (card) toggleCardMenu(card.dataset.id);
        return;
    }

    // share
    const shareBtn = e.target.closest("[data-action='share']");
    if (shareBtn) {
        const card = shareBtn.closest(".ans-card");
        if (card) toggleCardMenu(card.dataset.id);
        openShareSheet(
            shareBtn.dataset.id,
            shareBtn.dataset.question,
            shareBtn.dataset.reply,
            shareBtn.dataset.name,
            shareBtn.dataset.username
        );
        return;
    }

    // report
    const reportBtn = e.target.closest("[data-action='report']");
    if (reportBtn) {
        const card = reportBtn.closest(".ans-card");
        if (card) toggleCardMenu(card.dataset.id);
        reportContent(reportBtn.dataset.id, reportBtn.dataset.uid);
        return;
    }

    // delete
    const deleteBtn = e.target.closest("[data-action='delete']");
    if (deleteBtn) {
        const card = deleteBtn.closest(".ans-card");
        if (card) toggleCardMenu(card.dataset.id);
        deleteAnswer(deleteBtn.dataset.id, deleteBtn.dataset.qid);
        return;
    }
});
async function shareAnswer(id,question,answer,name,username){
    if (window.cairoFontsReady) { try { await window.cairoFontsReady; } catch(e){} }
    const canvas=document.createElement("canvas");
    canvas.width=1080;canvas.height=1920;
    const ctx=canvas.getContext("2d");

    ctx.fillStyle="#050505";ctx.fillRect(0,0,1080,1920);

    const glow1=ctx.createRadialGradient(540,250,0,540,250,900);
    glow1.addColorStop(0,"rgba(248,5,102,0.18)");glow1.addColorStop(1,"transparent");
    ctx.fillStyle=glow1;ctx.fillRect(0,0,1080,1920);

    const glow2=ctx.createRadialGradient(540,1750,0,540,1750,700);
    glow2.addColorStop(0,"rgba(248,5,102,0.08)");glow2.addColorStop(1,"transparent");
    ctx.fillStyle=glow2;ctx.fillRect(0,0,1080,1920);

    ctx.textAlign="center";
    ctx.shadowColor="rgba(248,5,102,0.6)";ctx.shadowBlur=25;
    ctx.fillStyle="#f80566";ctx.font="900 58px Cairo,Arial";
    ctx.fillText("AnonHT",540,160);
    ctx.shadowBlur=0;

    ctx.fillStyle="#666";ctx.font="700 28px Cairo,Arial";
    ctx.fillText("اسأل بشكل مجهول • anonht.com",540,210);

    const cardX=70,cardY=270,cardW=940,cardH=1180;
    ctx.fillStyle="#0d0d0d";roundRect(ctx,cardX,cardY,cardW,cardH,40);ctx.fill();
    const cardGrad=ctx.createLinearGradient(cardX,cardY,cardX,cardY+cardH);
    cardGrad.addColorStop(0,"rgba(248,5,102,0.5)");cardGrad.addColorStop(1,"rgba(248,5,102,0.08)");
    ctx.strokeStyle=cardGrad;ctx.lineWidth=3;roundRect(ctx,cardX,cardY,cardW,cardH,40);ctx.stroke();

    ctx.textAlign="right";ctx.fillStyle="#f80566";ctx.font="800 34px Cairo,Arial";
    ctx.fillText("❓ سؤال",cardX+cardW-50,cardY+80);

    ctx.fillStyle="#999";ctx.font="600 38px Cairo,Arial";ctx.textAlign="center";
    let endY=wrapTextCentered(ctx,question,540,cardY+170,820,54);

    ctx.strokeStyle="rgba(248,5,102,0.25)";ctx.lineWidth=2;
    ctx.beginPath();ctx.moveTo(cardX+50,endY+50);ctx.lineTo(cardX+cardW-50,endY+50);ctx.stroke();

    ctx.textAlign="right";ctx.fillStyle="#f80566";ctx.font="800 34px Cairo,Arial";
    ctx.fillText("💬 الإجابة",cardX+cardW-50,endY+120);

    ctx.fillStyle="#ffffff";ctx.font="900 46px Cairo,Arial";ctx.textAlign="center";
    endY=wrapTextCentered(ctx,answer,540,endY+200,820,64);

    ctx.fillStyle="#f80566";ctx.font="800 36px Cairo,Arial";
    ctx.fillText("— "+(name||"مجهول"),540,Math.max(endY+90,cardY+cardH-100));

    const badgeY=cardY+cardH+80;
    const badgeText="anonht.com/"+(username||"");
    ctx.font="800 38px Cairo,Arial";
    const badgeW=ctx.measureText(badgeText).width+140;
    const badgeH=90;
    const badgeX=540-badgeW/2;
    const badgeGrad=ctx.createLinearGradient(badgeX,badgeY,badgeX+badgeW,badgeY);
    badgeGrad.addColorStop(0,"#f80566");badgeGrad.addColorStop(1,"#c4024e");
    ctx.fillStyle=badgeGrad;roundRect(ctx,badgeX,badgeY,badgeW,badgeH,50);ctx.fill();

    ctx.fillStyle="#ffffff";ctx.font="800 38px Cairo,Arial";ctx.textAlign="center";
    ctx.fillText("🔗 "+badgeText,540,badgeY+58);

    ctx.fillStyle="#444";ctx.font="600 28px Cairo,Arial";
    ctx.fillText("Anon HT — أسئلة مجهولة وصريحة",540,badgeY+badgeH+70);

    canvas.toBlob(blob=>{
        const url=URL.createObjectURL(blob);
        const a=document.createElement("a");
        a.href=url;a.download="anonht-share.png";a.click();
        URL.revokeObjectURL(url);
    },"image/png");
}

function wrapTextCentered(ctx,text,x,y,maxWidth,lineHeight){
    const words=text.split(" ");let line="";let currentY=y;
    for(let i=0;i<words.length;i++){
        const testLine=line+words[i]+" ";
        if(ctx.measureText(testLine).width>maxWidth&&i>0){
            ctx.fillText(line,x,currentY);line=words[i]+" ";currentY+=lineHeight;
        }else{line=testLine;}
    }
    ctx.fillText(line,x,currentY);
    return currentY;
}
function roundRect(ctx,x,y,w,h,r){
    ctx.beginPath();ctx.moveTo(x+r,y);ctx.lineTo(x+w-r,y);
    ctx.quadraticCurveTo(x+w,y,x+w,y+r);ctx.lineTo(x+w,y+h-r);
    ctx.quadraticCurveTo(x+w,y+h,x+w-r,y+h);ctx.lineTo(x+r,y+h);
    ctx.quadraticCurveTo(x,y+h,x,y+h-r);ctx.lineTo(x,y+r);
    ctx.quadraticCurveTo(x,y,x+r,y);ctx.closePath();
}
function wrapText(ctx,text,x,y,maxWidth,lineHeight){
    const words=text.split(" ");let line="";let currentY=y;
    for(let i=0;i<words.length;i++){
        const testLine=line+words[i]+" ";
        if(ctx.measureText(testLine).width>maxWidth&&i>0){
            ctx.fillText(line,x,currentY);line=words[i]+" ";currentY+=lineHeight;
        }else{line=testLine;}
    }
    ctx.fillText(line,x,currentY);
}
</script>
<script src="butterfly.js"></script>

<div class="share-sheet-overlay" id="shareSheetOverlay" onclick="if(event.target===this)closeShareSheet()">
  <div class="share-sheet" id="shareSheet">
    <div class="share-sheet-handle"></div>
    <div class="share-sheet-title">مشاركة المنشور</div>
    <div class="share-preview" id="sharePreviewText"></div>
    <div class="share-grid">
      <button class="share-opt" onclick="shareVia('whatsapp')">
        <div class="share-icon" style="background:#25D366;"><i class="fa-brands fa-whatsapp"></i></div>
        <span>واتساب</span>
      </button>
      <button class="share-opt" onclick="shareVia('twitter')">
        <div class="share-icon" style="background:linear-gradient(135deg,#f80566,#c4024e);"><i class="fa-brands fa-x-twitter"></i></div>
        <span>X</span>
      </button>
      <button class="share-opt" onclick="shareVia('telegram')">
        <div class="share-icon" style="background:#229ED9;"><i class="fa-brands fa-telegram"></i></div>
        <span>تيليجرام</span>
      </button>
      <button class="share-opt" onclick="shareVia('facebook')">
        <div class="share-icon" style="background:#1877F2;"><i class="fa-brands fa-facebook-f"></i></div>
        <span>فيسبوك</span>
      </button>
      <button class="share-opt" onclick="copyShareLink()">
        <div class="share-icon" style="background:linear-gradient(135deg,#f80566,#c4024e);"><i class="fa-solid fa-link"></i></div>
        <span>نسخ الرابط</span>
      </button>
      <button class="share-opt" onclick="downloadShareImage()">
        <div class="share-icon" style="background:#555;"><i class="fa-solid fa-image"></i></div>
        <span>تحميل كصورة</span>
      </button>
    </div>
    <button class="share-native-btn" id="shareNativeBtn" onclick="shareViaNative()" style="display:none;">
      <i class="fa-solid fa-share-nodes"></i> مشاركة عبر تطبيق آخر
    </button>
    <button class="share-cancel-btn" onclick="closeShareSheet()">إلغاء</button>
  </div>
</div>

<script>
let currentShareData = null;

function openShareSheet(id, question, answer, name, username) {
    currentShareData = { id, question, answer, name, username };
    document.getElementById('sharePreviewText').textContent = `"${question}" — ${answer}`;
    document.getElementById('shareSheetOverlay').classList.add('show');
    document.getElementById('shareNativeBtn').style.display = navigator.share ? 'flex' : 'none';
}

function closeShareSheet() {
    document.getElementById('shareSheetOverlay').classList.remove('show');
}

function getShareLink() {
    if (!currentShareData) return 'https://anonht.com';
    return `https://anonht.com/thread.html?id=${currentShareData.id}`;
}

function getShareText() {
    if (!currentShareData) return '';
    return `"${currentShareData.question}"\n${currentShareData.answer}\n\n— ${currentShareData.name||'مجهول'} (@${currentShareData.username||''})`;
}

function shareVia(platform) {
    const link = encodeURIComponent(getShareLink());
    const text = encodeURIComponent(getShareText());
    let url = '';
    switch(platform) {
        case 'whatsapp': url = `https://wa.me/?text=${text}%20${link}`; break;
        case 'twitter':  url = `https://twitter.com/intent/tweet?text=${text}&url=${link}`; break;
        case 'telegram': url = `https://t.me/share/url?url=${link}&text=${text}`; break;
        case 'facebook': url = `https://www.facebook.com/sharer/sharer.php?u=${link}`; break;
    }
    if (url) window.open(url, '_blank', 'noopener,noreferrer');
    closeShareSheet();
}

async function shareViaNative() {
    if (!navigator.share) return;
    try {
        await navigator.share({ title: 'AnonHT', text: getShareText(), url: getShareLink() });
    } catch(e) {}
    closeShareSheet();
}

async function copyShareLink() {
    const link = getShareLink();
    try {
        await navigator.clipboard.writeText(link);
    } catch(e) {
        const ta = document.createElement('textarea');
        ta.value = link;
        document.body.appendChild(ta);
        ta.select();
        document.execCommand('copy');
        document.body.removeChild(ta);
    }
    showCopiedToast();
    closeShareSheet();
}

function showCopiedToast() {
    let toast = document.getElementById('shareCopiedToast');
    if (!toast) {
        toast = document.createElement('div');
        toast.id = 'shareCopiedToast';
        toast.className = 'share-toast-copied';
        toast.innerHTML = '<i class="fa-solid fa-check"></i> تم نسخ الرابط';
        document.body.appendChild(toast);
    }
    toast.classList.add('show');
    setTimeout(() => toast.classList.remove('show'), 2200);
}

function downloadShareImage() {
    if (!currentShareData) return;
    const { id, question, answer, name, username } = currentShareData;
    shareAnswer(id, question, answer, name, username);
    closeShareSheet();
}
</script>

