<div id="streakToast" style="
  position: fixed; top: 20px; left: 50%;
  transform: translateX(-50%) translateY(-100px);
  z-index: 99999;
  background: linear-gradient(135deg, rgba(14,14,14,0.98), rgba(40,10,0,0.98));
  border: 1px solid rgba(255,100,0,0.4);
  border-radius: 20px; padding: 14px 20px;
  display: flex; align-items: center; gap: 12px;
  box-shadow: 0 8px 32px rgba(255,100,0,0.2);
  backdrop-filter: blur(20px);
  transition: transform 0.5s cubic-bezier(0.34,1.2,0.64,1), opacity 0.4s;
  opacity: 0; font-family: Cairo, sans-serif;
  max-width: calc(100% - 32px);
">
  <span style="font-size:28px;">🔥</span>
  <div>
    <div id="streakToastMsg" style="color:#fff;font-size:13px;font-weight:800;"></div>
    <div style="color:#aaa;font-size:11px;margin-top:2px;">واصل الدخول اليومي لتحافظ على streak</div>
  </div>
</div>
<script>
(function(){
  const msg = localStorage.getItem('pendingStreakToast');
  if (!msg) return;
  localStorage.removeItem('pendingStreakToast');
  const el = document.getElementById('streakToast');
  const msgEl = document.getElementById('streakToastMsg');
  if (!el || !msgEl) return;
  msgEl.textContent = msg;
  setTimeout(() => {
    el.style.opacity = '1';
    el.style.transform = 'translateX(-50%) translateY(0)';
    setTimeout(() => {
      el.style.opacity = '0';
      el.style.transform = 'translateX(-50%) translateY(-100px)';
    }, 4000);
  }, 1000);
})();
</script>

<script>
// ===== DAILY CHALLENGE =====
const DAILY_CHALLENGES = [
  "ما أكثر شيء بتخاف منه؟",
  "لو قدرت تغير حاجة واحدة في نفسك إيه هتكون؟",
  "أكتر لحظة فرحت فيها في حياتك؟",
  "لو عندك يوم كامل من غير مسؤوليات هتعمل إيه؟",
  "أكتر شخص أثر فيك في حياتك ولو ليه؟",
  "إيه الحاجة اللي بتتمنى الناس تعرفها عنك؟",
  "لو قدرت ترسل رسالة لنفسك قبل 5 سنين هتقول إيه؟",
  "أكتر خطأ علمك درس مهم؟",
  "إيه اللي بيخليك تحس بالسعادة الحقيقية؟",
  "لو عندك قدرة خارقة واحدة هتختار إيه؟",
  "أكتر حاجة بتفتقدها من طفولتك؟",
  "إيه الحلم اللي لسه ما حققتوش؟",
  "لو قدرت تعيش في أي زمن غير دلوقتي هيكون إيه؟",
  "أكتر كتاب أو فيلم غير تفكيرك؟",
  "إيه الحاجة اللي عمرك ما هتتنازل عنها؟",
  "لو الدنيا هتنتهي بكره هتعمل إيه النهارده؟",
  "أكتر حاجة بتفخر بيها في نفسك؟",
  "إيه الحاجة اللي بتخجل منها وعايز تغيرها؟",
  "لو قدرت تكون أي شخص لمدة يوم مين هتختار؟",
  "إيه أصعب قرار اتخذته في حياتك؟",
];

function getTodayChallenge() {
  const now = new Date();
  const dayIndex = Math.floor(now.getTime() / 86400000) % DAILY_CHALLENGES.length;
  return DAILY_CHALLENGES[dayIndex];
}

function getTodayKey() {
  const now = new Date();
  return `dailyChallenge_${now.getFullYear()}_${now.getMonth()}_${now.getDate()}`;
}

function updateChallengeTimer() {
  const now = new Date();
  const midnight = new Date(now);
  midnight.setHours(24, 0, 0, 0);
  const diff = midnight - now;
  const h = Math.floor(diff / 3600000);
  const m = Math.floor((diff % 3600000) / 60000);
  const s = Math.floor((diff % 60000) / 1000);
  const el = document.getElementById('dailyChallengeTimer');
  if (el) el.textContent = `${String(h).padStart(2,'0')}:${String(m).padStart(2,'0')}:${String(s).padStart(2,'0')}`;
}

function closeDailyChallenge() {
  const modal = document.getElementById('dailyChallengeModal');
  if (modal) {
    modal.style.animation = 'slideDownChallenge 0.3s ease forwards';
    setTimeout(() => { modal.style.display = 'none'; }, 300);
  }
}

async function submitDailyChallenge() {
  const input = document.getElementById('dailyChallengeInput');
  const result = document.getElementById('dailyChallengeResult');
  const btn = document.querySelector('#dailyChallengeModal button:last-of-type');
  const answer = input ? input.value.trim() : '';

  if (!answer || answer.length < 2) {
    input.style.border = '1px solid rgba(248,5,102,0.8)';
    setTimeout(() => { input.style.border = '1px solid rgba(255,255,255,0.08)'; }, 1000);
    return;
  }

  const user = firebase.auth().currentUser;
  if (!user) {
    window.location.href = 'login.html';
    return;
  }

  btn.disabled = true;
  btn.textContent = '...';

  try {
    const todayKey = getTodayKey();
    const question = getTodayChallenge();

    await firebase.firestore().collection('dailyChallenges').add({
      uid: user.uid,
      question: question,
      answer: answer,
      createdAt: firebase.firestore.FieldValue.serverTimestamp(),
      dayKey: todayKey
    });

    // إضافة XP
    await firebase.firestore().collection('users').doc(user.uid).update({
      xp: firebase.firestore.FieldValue.increment(50)
    });

    localStorage.setItem(getTodayKey(), 'done');

    result.style.display = 'block';
    result.textContent = '🎉 أحسنت! +50 XP اتضافوا لحسابك';
    input.style.display = 'none';
    btn.style.display = 'none';

    document.getElementById('dailyChallengeXP').textContent = '✅ تم اليوم';

    setTimeout(() => closeDailyChallenge(), 2500);

  } catch(e) {
    btn.disabled = false;
    btn.textContent = 'أرسل ⚡';
    result.style.display = 'block';
    result.style.background = 'rgba(248,5,102,0.08)';
    result.style.color = '#f80566';
    result.textContent = 'حصل خطأ: ' + e.message;
  }
}

function initDailyChallenge() {
  const todayKey = getTodayKey();
  if (localStorage.getItem(todayKey) === 'done') return;

  const modal = document.getElementById('dailyChallengeModal');
  const qEl = document.getElementById('dailyChallengeQ');

  if (!modal || !qEl) return;

  qEl.textContent = getTodayChallenge();
  modal.style.display = 'block';

  updateChallengeTimer();
  setInterval(updateChallengeTimer, 1000);
}

// style للـ slideDown
const styleEl = document.createElement('style');
styleEl.textContent = `
@keyframes slideDownChallenge {
  from { opacity:1; transform:translateX(-50%) translateY(0); }
  to   { opacity:0; transform:translateX(-50%) translateY(30px); }
}
`;
document.head.appendChild(styleEl);

// شغّل بعد login
firebase.auth().onAuthStateChanged(user => {
  if (user) setTimeout(initDailyChallenge, 2000);
});
</script>

<style>
/* PAGE TRANSITIONS */
.page-transition-overlay {
  position:fixed;inset:0;z-index:99999;
  background:#050505;
  pointer-events:none;
  opacity:0;
  transition:opacity 0.3s ease;
}
.page-transition-overlay.fade-in { opacity:1; }
body { animation: pageFadeIn 0.35s ease; }
@keyframes pageFadeIn {
  from { opacity:0; transform:translateY(8px); }
  to   { opacity:1; transform:translateY(0); }
}
</style>

<div id="pageTransitionOverlay" class="page-transition-overlay"></div>

<script>
// ===== PAGE TRANSITIONS =====
function navigateTo(url) {
  const overlay = document.getElementById('pageTransitionOverlay');
  overlay.classList.add('fade-in');
  setTimeout(() => { window.location.href = url; }, 300);
}

document.addEventListener('click', function(e) {
  const a = e.target.closest('a');
  if (!a) return;
  const href = a.getAttribute('href');
  if (!href || href.startsWith('#') || href.startsWith('javascript') || href.startsWith('mailto') || a.target === '_blank') return;
  if (href.startsWith('http') && !href.includes(location.hostname)) return;
  e.preventDefault();
  navigateTo(href);
});
</script>

</body>
</html>