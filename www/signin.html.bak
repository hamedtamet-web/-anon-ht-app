<body>

<!-- ══ DESKTOP LAYOUT (مخفي على موبايل) ══ -->
<div id="desktopLayout" style="display:none; width:100%; min-height:100vh;">

  <!-- اليمين: اللوجو -->
  <div class="desktop-right-panel">
    <div class="logo-ring"></div>
    <div class="logo-ring"></div>
    <div class="logo-ring"></div>

    <!-- نقاط عائمة -->
    <div class="float-dot" style="width:8px;height:8px;top:20%;left:15%;animation-duration:4s;"></div>
    <div class="float-dot" style="width:5px;height:5px;top:35%;left:70%;animation-duration:5s;animation-delay:1s;background:#ff6b35;"></div>
    <div class="float-dot" style="width:10px;height:10px;top:65%;left:25%;animation-duration:6s;animation-delay:2s;"></div>
    <div class="float-dot" style="width:6px;height:6px;top:75%;left:60%;animation-duration:3.5s;animation-delay:0.5s;background:#c4024e;"></div>
    <div class="float-dot" style="width:4px;height:4px;top:10%;left:50%;animation-duration:4.5s;animation-delay:1.5s;"></div>

    <div class="desktop-logo-big">
      <img src="images/logo.png" alt="Anon HT Logo" width="130" height="130">
      <div class="desktop-logo-tagline">
        مرحباً بك في<br><span>عالم الغموض</span> 🕵️
      </div>
      <div class="desktop-logo-sub">
        اسأل مجهول، واكتشف من يراقبك في صمت
      </div>
    </div>
  </div>

  <!-- الوسط: بطاقة الدخول -->
  <div class="desktop-center-panel" id="desktopCenterPanel">

    <!-- اللانج بار -->
    <div class="lang-bar" style="max-width:480px;width:100%;">
      <div class="lang-switcher" id="langSwitcherD">
        <button class="lang-active-btn" id="langActiveBtnD" onclick="toggleLangMenuD()">
          <span class="lang-globe">🌐</span>
          <span class="lang-current" id="langCurrentLabelD">AR</span>
          <span class="lang-chevron" id="langChevronD">&#8964;</span>
        </button>
        <div class="lang-menu" id="langMenuD">
          <div class="lang-option" onclick="selectLangD('ar')"><span class="lang-opt-flag">🇸🇦</span><span class="lang-opt-name">العربية</span><span class="lang-opt-check" id="dcheck-ar">✓</span></div>
          <div class="lang-option" onclick="selectLangD('en')"><span class="lang-opt-flag">🇬🇧</span><span class="lang-opt-name">English</span><span class="lang-opt-check" id="dcheck-en"></span></div>
          <div class="lang-option" onclick="selectLangD('fr')"><span class="lang-opt-flag">🇫🇷</span><span class="lang-opt-name">Français</span><span class="lang-opt-check" id="dcheck-fr"></span></div>
          <div class="lang-option" onclick="selectLangD('es')"><span class="lang-opt-flag">🇪🇸</span><span class="lang-opt-name">Español</span><span class="lang-opt-check" id="dcheck-es"></span></div>
          <div class="lang-option" onclick="selectLangD('tr')"><span class="lang-opt-flag">🇹🇷</span><span class="lang-opt-name">Türkçe</span><span class="lang-opt-check" id="dcheck-tr"></span></div>
        </div>
      </div>
    </div>

    <!-- بطاقة الدخول — نسخة desktop ثابتة في DOM -->
    <div id="desktopAuthCard" class="auth-card" style="max-width:480px;width:100%;">

      <div class="logo-box">
        <img src="images/logo.png" alt="Anon HT" width="60" height="60" loading="eager">
      </div>

      <!-- تسجيل الدخول -->
      <div id="d-signin-section">
        <h2>تسجيل الدخول</h2>
        <p class="subtitle">أهلاً بك مجدداً في عالم الغموض</p>
        <div class="input-group">
          <input type="email" id="d-loginEmail" placeholder="البريد الإلكتروني" maxlength="254" autocomplete="email">
        </div>
        <div class="input-group">
          <input type="password" id="d-loginPass" placeholder="كلمة المرور" maxlength="128" autocomplete="current-password">
        </div>
        <button class="submit-btn" id="d-loginBtn" onclick="handleLoginD()">دخول</button>
        <span class="forgot-link" onclick="openResetModalD()">نسيت كلمة السر؟</span>
        <div class="switch-area">
          <span>مستخدم جديد؟</span>
          <b onclick="toggleAuthD()">أنشئ حساباً</b>
        </div>
      </div>

      <!-- انتظار التفعيل -->
      <div id="d-verify-waiting" class="hidden">
        <h2 style="font-size:20px;">تفقد بريدك 📧</h2>
        <p class="subtitle">أرسلنا رابط التفعيل. اضغط عليه لتأكيد هويتك.</p>
        <div class="loader" style="margin:20px auto"></div>
        <button onclick="location.reload()" class="submit-btn" style="margin-top:20px">تم التفعيل، دخول</button>
      </div>

    </div>

  </div>

  <!-- اليسار: إعلان كبير -->
  <!-- اليسار: إعلان desktop فقط -->
  <div class="desktop-left-panel">
    <div class="desktop-ad-panel" id="desktopAdPanel">

      <div class="desktop-ad-box" id="desktopAdBox1" style="min-height:620px;max-width:180px;width:100%;">
        <script>
          atOptions = {
            'format' : 'iframe',
            'height' : 600,
            'width' : 160,
            'params' : {}
          };
        </script>
      </div>

    </div>
  </div>

</div>

<!-- Toast -->
<div id="toast" role="alert" aria-live="polite">
  <div class="t-icon-wrap"><span class="t-icon">⚠️</span></div>
  <span class="t-text" id="toastText"></span>
  <div class="t-bar" id="toastBar"></div>
</div>

<!-- Privacy Modal -->
<div class="modal-overlay" id="privacyModal" role="dialog" aria-modal="true" aria-labelledby="privacyModalTitle">
  <div class="modal-sheet">
    <div class="modal-handle"></div>
    <div class="modal-head">
      <h3 id="privacyModalTitle">🔒 سياسة الخصوصية والشروط</h3>
      <button class="modal-close" onclick="closePrivacyModal()" aria-label="إغلاق">✕</button>
    </div>
    <div class="modal-body" id="privacyModalBody">
      <!-- Content injected by JS -->
    </div>
    <div class="modal-footer-btn">
      <button class="modal-accept-btn" id="privacyAcceptBtn" onclick="acceptPrivacy()">✅ أوافق على السياسة</button>
    </div>
  </div>
</div>

<main class="main-wrapper">

  <!-- Header Ad -->
  <div id="header-ad-placeholder" class="ad-slot"></div>

  <!-- Lang Bar -->
  <div class="lang-bar">
    <div class="lang-switcher" id="langSwitcher">
      <button class="lang-active-btn" id="langActiveBtn" onclick="toggleLangMenu()">
        <span class="lang-globe">🌐</span>
        <span class="lang-current" id="langCurrentLabel">AR</span>
        <span class="lang-chevron" id="langChevron">&#8964;</span>
      </button>
      <div class="lang-menu" id="langMenu">
        <div class="lang-option" onclick="selectLang('ar')"><span class="lang-opt-flag">🇸🇦</span><span class="lang-opt-name">العربية</span><span class="lang-opt-check" id="check-ar">✓</span></div>
        <div class="lang-option" onclick="selectLang('en')"><span class="lang-opt-flag">🇬🇧</span><span class="lang-opt-name">English</span><span class="lang-opt-check" id="check-en"></span></div>
        <div class="lang-option" onclick="selectLang('fr')"><span class="lang-opt-flag">🇫🇷</span><span class="lang-opt-name">Français</span><span class="lang-opt-check" id="check-fr"></span></div>
        <div class="lang-option" onclick="selectLang('es')"><span class="lang-opt-flag">🇪🇸</span><span class="lang-opt-name">Español</span><span class="lang-opt-check" id="check-es"></span></div>
        <div class="lang-option" onclick="selectLang('pt')"><span class="lang-opt-flag">🇧🇷</span><span class="lang-opt-name">Português</span><span class="lang-opt-check" id="check-pt"></span></div>
        <div class="lang-option" onclick="selectLang('de')"><span class="lang-opt-flag">🇩🇪</span><span class="lang-opt-name">Deutsch</span><span class="lang-opt-check" id="check-de"></span></div>
        <div class="lang-option" onclick="selectLang('ru')"><span class="lang-opt-flag">🇷🇺</span><span class="lang-opt-name">Русский</span><span class="lang-opt-check" id="check-ru"></span></div>
        <div class="lang-option" onclick="selectLang('zh')"><span class="lang-opt-flag">🇨🇳</span><span class="lang-opt-name">中文</span><span class="lang-opt-check" id="check-zh"></span></div>
        <div class="lang-option" onclick="selectLang('hi')"><span class="lang-opt-flag">🇮🇳</span><span class="lang-opt-name">हिन्दी</span><span class="lang-opt-check" id="check-hi"></span></div>
        <div class="lang-option" onclick="selectLang('tr')"><span class="lang-opt-flag">🇹🇷</span><span class="lang-opt-name">Türkçe</span><span class="lang-opt-check" id="check-tr"></span></div>
      </div>
    </div>
  </div>

  <!-- Maintenance Banner -->
  <div class="maintenance-banner hidden" id="maintenanceBanner">
    <span class="maint-icon">🔧</span>
    <div class="maint-title" id="maintTitle">الموقع في وضع الصيانة</div>
    <div class="maint-msg" id="maintMsg">نعمل على تحسين تجربتك. سنعود قريباً!</div>
    <div class="maint-timer-label">⏱ العودة خلال</div>
    <div class="maint-timer" id="maintTimer">
      <span id="maintHH">00</span>:<span id="maintMM">00</span>:<span id="maintSS">00</span>
    </div>
    <div class="maint-timer-sub">ساعة : دقيقة : ثانية</div>
    <div class="maint-progress"><div class="maint-progress-fill" id="maintProgressFill" style="width:0%"></div></div>
    <div class="maint-badge"><div class="maint-badge-dot"></div> جاري الصيانة الآن</div>
    <a class="maint-admin-link" href="#" onclick="showAdminLoginFromMaint(); return false;">🔐 دخول المشرف</a>
  </div>

  <!-- Auth Card -->
  <div class="auth-card">
    <div class="logo-box">
  <h1 style="position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0,0,0,0);margin:-1px;">Anon HT - منصة الأسئلة المجهولة العربية</h1>
  <img src="images/logo.png" alt="Anon HT - منصة الأسئلة المجهولة" width="60" height="60" loading="eager" fetchpriority="high">
</div>

    <!-- تسجيل الدخول -->
    <div id="signin-section">
      <h2 data-lang-key="signin_title">تسجيل الدخول</h2>
      <p class="subtitle" data-lang-key="signin_sub">أهلاً بك مجدداً في عالم الغموض</p>
      <div class="input-group">
        <input type="email" id="loginEmail" placeholder="البريد الإلكتروني" required maxlength="254" autocomplete="email">
      </div>
      <div class="input-group">
        <input type="password" id="loginPass" placeholder="كلمة المرور" required maxlength="128" autocomplete="current-password">
      </div>
      <button class="submit-btn" id="loginBtn" onclick="handleLogin()" data-lang-key="login_btn">دخول</button>
      <span class="forgot-link" onclick="openResetModal()" data-lang-key="forgot_pass">نسيت كلمة السر؟</span>
      <div class="switch-area">
        <span data-lang-key="new_user">مستخدم جديد؟</span>
        <b onclick="toggleAuth()" data-lang-key="create_account">أنشئ حساباً</b>
      </div>
    </div>

    <!-- إكمال البيانات -->
    <div id="complete-section" class="hidden">
      <h2 data-lang-key="complete_title">أكمل بياناتك 📋</h2>
      <p class="subtitle" data-lang-key="complete_sub">بياناتك غير مكتملة، يرجى تعبئة الحقول التالية</p>
      <div class="missing-notice" id="missingNotice">
        <div class="mn-title" data-lang-key="missing_data">⚠️ البيانات الناقصة:</div>
        <ul id="missingList"></ul>
      </div>
      <div class="input-group hidden" id="completeNameGroup">
        <input type="text" id="completeName" placeholder="الاسم الكامل" maxlength="60" autocomplete="name">
      </div>
      <div class="input-group hidden" id="completePhoneGroup">
        <div class="phone-group">
          <div class="country-selector">
            <div class="country-btn" id="countryBtn2">
              <span class="cflag" id="selectedFlag2">🇪🇬</span>
              <span class="ccode" id="selectedCode2">+20</span>
              <span class="carrow">&#9660;</span>
            </div>
            <div class="country-dropdown" id="countryDropdown2">
              <input class="country-search" id="countrySearch2" type="text" placeholder="ابحث عن دولة...">
              <div id="countryList2"></div>
            </div>
          </div>
          <input type="tel" id="completePhone" placeholder="رقم الهاتف" maxlength="15" pattern="[0-9]*" autocomplete="tel">
        </div>
      </div>
      <button class="submit-btn" id="completeBtn" onclick="handleComplete()" data-lang-key="save_continue">حفظ والمتابعة</button>
    </div>

    <!-- إنشاء حساب -->
    <div id="signup-section" class="hidden">
      <h2 data-lang-key="signup_title">حساب جديد</h2>
      <p class="subtitle" data-lang-key="signup_sub">اكتشف من يراقبك في صمت</p>
      <div class="input-group">
        <input type="text" id="regName" placeholder="الاسم الكامل" required maxlength="60" autocomplete="name">
      </div>
      <div class="input-group">
        <input type="text" id="regUser" placeholder="اسم المستخدم (4+ حروف)" required maxlength="30" autocomplete="username">
      </div>
      <div class="input-group">
        <input type="email" id="emailInput" placeholder="البريد الإلكتروني" required maxlength="254" autocomplete="email">
      </div>
      <div class="input-group">
        <input type="password" id="regPass" placeholder="كلمة المرور (8+ حروف)" required maxlength="128" autocomplete="new-password">
        <div class="strength-bar" aria-hidden="true">
          <span id="sb1"></span><span id="sb2"></span><span id="sb3"></span><span id="sb4"></span>
        </div>
        <div class="strength-label" id="strengthLabel" aria-live="polite"></div>
      </div>
      <div class="input-group">
        <div class="phone-group">
          <div class="country-selector">
            <div class="country-btn" id="countryBtn">
              <span class="cflag" id="selectedFlag">🇪🇬</span>
              <span class="ccode" id="selectedCode">+20</span>
              <span class="carrow">&#9660;</span>
            </div>
            <div class="country-dropdown" id="countryDropdown">
              <input class="country-search" id="countrySearch" type="text" placeholder="ابحث عن دولة...">
              <div id="countryList"></div>
            </div>
          </div>
          <input type="tel" id="regPhone" placeholder="رقم الهاتف (إجباري)" maxlength="15" pattern="[0-9]*" required autocomplete="tel">
        </div>
      </div>
      <div class="input-group">
  <div class="birthdate-picker" id="birthdatePicker">
