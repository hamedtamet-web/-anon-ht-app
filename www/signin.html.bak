  {name:"عمان",flag:"🇴🇲",code:"+968"},{name:"الأردن",flag:"🇯🇴",code:"+962"},
  {name:"لبنان",flag:"🇱🇧",code:"+961"},{name:"العراق",flag:"🇮🇶",code:"+964"},
  {name:"سوريا",flag:"🇸🇾",code:"+963"},{name:"فلسطين",flag:"🇵🇸",code:"+970"},
  {name:"اليمن",flag:"🇾🇪",code:"+967"},{name:"ليبيا",flag:"🇱🇾",code:"+218"},
  {name:"تونس",flag:"🇹🇳",code:"+216"},{name:"الجزائر",flag:"🇩🇿",code:"+213"},
  {name:"المغرب",flag:"🇲🇦",code:"+212"},{name:"السودان",flag:"🇸🇩",code:"+249"},
  {name:"تركيا",flag:"🇹🇷",code:"+90"},{name:"باكستان",flag:"🇵🇰",code:"+92"},
  {name:"الهند",flag:"🇮🇳",code:"+91"},{name:"المملكة المتحدة",flag:"🇬🇧",code:"+44"},
  {name:"الولايات المتحدة",flag:"🇺🇸",code:"+1"},{name:"فرنسا",flag:"🇫🇷",code:"+33"},
  {name:"المانيا",flag:"🇩🇪",code:"+49"},{name:"كندا",flag:"🇨🇦",code:"+1"},
  {name:"استراليا",flag:"🇦🇺",code:"+61"},{name:"ايطاليا",flag:"🇮🇹",code:"+39"},
  {name:"اسبانيا",flag:"🇪🇸",code:"+34"},{name:"هولندا",flag:"🇳🇱",code:"+31"},
  {name:"روسيا",flag:"🇷🇺",code:"+7"},{name:"الصين",flag:"🇨🇳",code:"+86"},
  {name:"اليابان",flag:"🇯🇵",code:"+81"},{name:"البرازيل",flag:"🇧🇷",code:"+55"},
  {name:"المكسيك",flag:"🇲🇽",code:"+52"},{name:"جنوب افريقيا",flag:"🇿🇦",code:"+27"},
  {name:"نيجيريا",flag:"🇳🇬",code:"+234"},{name:"افغانستان",flag:"🇦🇫",code:"+93"},
  {name:"ايران",flag:"🇮🇷",code:"+98"},{name:"اندونيسيا",flag:"🇮🇩",code:"+62"}
];
let selectedDial = '+20', selectedDial2 = '+20';

function renderCountries(list, containerId) {
  document.getElementById(containerId).innerHTML = list.map(c =>
    `<div class="country-item" data-flag="${escapeHtml(c.flag)}" data-code="${escapeHtml(c.code)}">
      <span class="ci-flag">${escapeHtml(c.flag)}</span>
      <span class="ci-name">${escapeHtml(c.name)}</span>
      <span class="ci-dial" dir="ltr">${escapeHtml(c.code)}</span>
    </div>`
  ).join('');
}

function setupCountrySelector(btnId, ddId, searchId, listId, flagId, codeId, isPrimary) {
  const btn = document.getElementById(btnId);
  const dd  = document.getElementById(ddId);
  btn.addEventListener('click', e => {
    e.stopPropagation();
    const open = dd.classList.contains('open');
    document.querySelectorAll('.country-dropdown').forEach(el => el.classList.remove('open'));
    document.querySelectorAll('.country-btn').forEach(el => el.classList.remove('open'));
    if (!open) {
      dd.classList.add('open'); btn.classList.add('open');
      document.getElementById(searchId).value = '';
      renderCountries(COUNTRIES, listId);
      setTimeout(() => document.getElementById(searchId).focus(), 80);
    }
  });
  document.getElementById(searchId).addEventListener('input', function() {
    const q = this.value.trim().toLowerCase();
    renderCountries(q ? COUNTRIES.filter(c => c.name.includes(q) || c.code.includes(q)) : COUNTRIES, listId);
  });
  document.getElementById(listId).addEventListener('click', e => {
    const item = e.target.closest('.country-item');
    if (!item) return;
    const code = item.dataset.code, flag = item.dataset.flag;
    if (isPrimary) selectedDial = code; else selectedDial2 = code;
    document.getElementById(flagId).textContent = flag;
    document.getElementById(codeId).textContent = code;
    dd.classList.remove('open'); btn.classList.remove('open');
  });
}

document.addEventListener('click', e => {
  if (!e.target.closest('.country-selector')) {
    document.querySelectorAll('.country-dropdown').forEach(el => el.classList.remove('open'));
    document.querySelectorAll('.country-btn').forEach(el => el.classList.remove('open'));
  }
});

setupCountrySelector('countryBtn','countryDropdown','countrySearch','countryList','selectedFlag','selectedCode', true);
setupCountrySelector('countryBtn2','countryDropdown2','countrySearch2','countryList2','selectedFlag2','selectedCode2', false);
renderCountries(COUNTRIES, 'countryList');
renderCountries(COUNTRIES, 'countryList2');

/* ══ Password Strength ══ */
let _lastPassVal = '';
function updateStrengthLabel() {
  const val = _lastPassVal;
  if (!val) { document.getElementById('strengthLabel').textContent = ''; return; }
  let score = 0;
  if (val.length >= 8) score++;
  if (/[A-Z]/.test(val)) score++;
  if (/[0-9]/.test(val)) score++;
  if (/[^A-Za-z0-9]/.test(val)) score++;
  const lang = getLang();
  const labels = { ar:['ضعيفة جداً','ضعيفة','متوسطة','قوية'], en:['Very weak','Weak','Medium','Strong'], fr:['Très faible','Faible','Moyen','Fort'] };
  const prefix = { ar:'قوة كلمة المرور: ', en:'Password strength: ', fr:'Force: ' };
  const arr = labels[lang] || labels.ar;
  document.getElementById('strengthLabel').textContent = (prefix[lang]||prefix.ar) + (arr[score-1]||arr[0]);
}
document.getElementById('regPass').addEventListener('input', function() {
  _lastPassVal = this.value;
  let score = 0;
  if (this.value.length >= 8) score++;
  if (/[A-Z]/.test(this.value)) score++;
  if (/[0-9]/.test(this.value)) score++;
  if (/[^A-Za-z0-9]/.test(this.value)) score++;
  const colors = ['#f80566','#ff6b35','#ffd166','#4ade80'];
  for (let i = 1; i <= 4; i++)
    document.getElementById('sb'+i).style.background = i <= score ? colors[score-1] : 'rgba(255,255,255,0.08)';
  updateStrengthLabel();
});

/* ══ MAINTENANCE ══ */
let _maintInterval = null, _maintEndTime = null, _maintStart = null;

async function checkMaintenanceMode() {
  try {
    const snap = await db.collection('admin').doc('settings').get();
    if (!snap.exists) return;
    const data = snap.data();
    if (!data.maintenance) { applyNormalMode(); return; }
    document.getElementById('maintTitle').textContent = data.maintenanceTitle || 'الموقع في وضع الصيانة';
    document.getElementById('maintMsg').textContent   = data.maintenanceMsg   || 'نعمل على تحسين تجربتك. سنعود قريباً!';
    const durationMin = data.maintenanceDuration || 60;
    const startedAt   = data.maintenanceStartedAt;
    if (startedAt?.toDate) {
      _maintStart   = startedAt.toDate().getTime();
      _maintEndTime = _maintStart + durationMin * 60 * 1000;
    } else {
      _maintEndTime = Date.now() + durationMin * 60 * 1000;
      _maintStart   = Date.now();
    }
    applyMaintenanceMode();
  } catch(e) {}
}

function applyMaintenanceMode() {
  document.getElementById('maintenanceBanner').classList.remove('hidden');
  ['signin-section','signup-section','complete-section','verify-waiting'].forEach(id =>
    document.getElementById(id).classList.add('hidden')
  );
  document.querySelector('.auth-card').style.display = 'none';
  startMaintCountdown();
}
function applyNormalMode() {
  document.getElementById('maintenanceBanner').classList.add('hidden');
  document.querySelector('.auth-card').style.display = '';
  if (_maintInterval) { clearInterval(_maintInterval); _maintInterval = null; }
}
function showAdminLoginFromMaint() {
  document.getElementById('maintenanceBanner').classList.add('hidden');
  document.querySelector('.auth-card').style.display = '';
  document.getElementById('signin-section').classList.remove('hidden');
  showToast('دخول المشرف — سيتم التحقق من الصلاحيات', 'info');
}
function startMaintCountdown() {
  if (_maintInterval) clearInterval(_maintInterval);
  function tick() {
    const now  = Date.now();
    const left = Math.max(0, _maintEndTime - now);
    const total = Math.max(1, _maintEndTime - _maintStart);
    document.getElementById('maintProgressFill').style.width = Math.min(100, ((total-left)/total)*100) + '%';
    document.getElementById('maintHH').textContent = String(Math.floor(left/3600000)).padStart(2,'0');
    document.getElementById('maintMM').textContent = String(Math.floor((left%3600000)/60000)).padStart(2,'0');
    document.getElementById('maintSS').textContent = String(Math.floor((left%60000)/1000)).padStart(2,'0');
    if (left <= 0) { clearInterval(_maintInterval); document.getElementById('maintTimer').innerHTML = '✅'; setTimeout(() => location.reload(), 3000); }
  }
  tick();
  _maintInterval = setInterval(tick, 1000);
}

/* ══ LOGIN ══ */
async function handleLogin() {
  const rl = RATE_LIMIT.check('login');
  if (!rl.allowed) { showToast(`تم تجاوز عدد المحاولات. حاول بعد ${rl.mins} دقيقة`, 'error', 5000); return; }
  const btn = document.getElementById('loginBtn');
  btn.disabled = true; btn.innerHTML = '<div class="loader"></div>';
  const email = document.getElementById('loginEmail').value.trim();
  const pass  = document.getElementById('loginPass').value;
  if (!isValidEmail(email)) {
    showToast(typeof LangManager !== 'undefined' ? LangManager.t('invalid_email') : 'بريد غير صالح', 'error');
    btn.disabled = false; btn.textContent = 'دخول'; return;
  }
  try {
    const maintCheck = await db.collection('admin').doc('settings').get();
    if (maintCheck.exists && maintCheck.data().maintenance) {
      const adminEmails = maintCheck.data().adminEmails || [];
      if (!adminEmails.map(e => e.toLowerCase()).includes(email.toLowerCase())) {
        showToast('الموقع في وضع الصيانة 🔧', 'error');
        btn.disabled = false; btn.textContent = 'دخول'; return;
      }
    }
    const cred = await auth.signInWithEmailAndPassword(email, pass);
    if (!cred.user.emailVerified) {
      showToast(typeof LangManager !== 'undefined' ? LangManager.t('verify_email_first') : 'يرجى تفعيل بريدك أولاً', 'info');
      await auth.signOut(); btn.disabled = false; btn.textContent = 'دخول'; return;
    }
    const userDoc  = await db.collection('users').doc(cred.user.uid).get();
    const userData = userDoc.exists ? userDoc.data() : {};

    if (userData.pendingDelete) {
        const deleteAt = userData.deleteScheduledAt?.toDate();
        const daysLeft = deleteAt
            ? Math.ceil((deleteAt - new Date()) / 86400000)
            : 0;
        if (daysLeft > 0) {
            await db.collection('users').doc(cred.user.uid).update({
                pendingDelete: false,
                deleteScheduledAt: null,
                isDeactivated: false
            });
            showToast(`تم استعادة حسابك! 🎉 كان متبقي ${daysLeft} يوم للحذف`, 'success');
        } else {
            await db.collection('users').doc(cred.user.uid).delete();
            await auth.signOut();
            showToast('تم حذف حسابك نهائياً', 'error');
            btn.disabled = false; btn.textContent = 'دخول';
            return;
        }
    }

    const missing  = [];
    if (!userData.name?.trim())  missing.push({ key:'name',  label: 'الاسم الكامل' });
    if (!userData.phone?.trim()) missing.push({ key:'phone', label: 'رقم الهاتف' });
    if (missing.length > 0) {
      _pendingUser = cred.user;
      showCompleteSection(missing);
      btn.disabled = false; btn.textContent = 'دخول'; return;
    }
    await syncUserCollections(cred.user.uid, userData);
    await db.collection('users').doc(cred.user.uid).update({
  lastLoginAt: firebase.firestore.FieldValue.serverTimestamp(),
  language: getLang()
});
RATE_LIMIT.reset('login');

if (!userData.birthdate || !userData.birthdayMMDD) {
  btn.disabled = false; btn.textContent = 'دخول';
  showBirthdateModal(cred.user.uid);
  return;
}
// ── انتهاء اشتراك عيد الميلاد ──
if (userData.premiumPlan === 'birthday' && userData.premiumUntil) {
  const expiry = userData.premiumUntil.toDate
    ? userData.premiumUntil.toDate()
    : new Date(userData.premiumUntil);
  if (new Date() > expiry) {
    await db.collection('users').doc(cred.user.uid).update({
      isPremium:    false,
      isVerified:   false,
      premiumPlan:  '',
      premiumUntil: null,
    });
  }
}
window.location.replace('index.html');
  } catch(err) {
    RATE_LIMIT.increment('login');
    showToast(typeof LangManager !== 'undefined' ? LangManager.t('wrong_credentials') : 'بريد أو كلمة مرور خاطئة', 'error');
    btn.disabled = false; btn.textContent = 'دخول';
  }
}

/* ══ COMPLETE ══ */
let _pendingUser = null, _missingKeys = [];
function showCompleteSection(missing) {
  document.getElementById('signin-section').classList.add('hidden');
  document.getElementById('complete-section').classList.remove('hidden');
  document.getElementById('missingList').innerHTML = missing.map(m => `<li>${escapeHtml(m.label)}</li>`).join('');
  missing.forEach(m => {
    if (m.key === 'name')  document.getElementById('completeNameGroup').classList.remove('hidden');
    if (m.key === 'phone') document.getElementById('completePhoneGroup').classList.remove('hidden');
  });
  _missingKeys = missing.map(m => m.key);
}
async function handleComplete() {
  if (!_pendingUser) return;
  const btn = document.getElementById('completeBtn');
  btn.disabled = true; btn.innerHTML = '<div class="loader"></div>';
  const updates = {};
  if (_missingKeys.includes('name')) {
    const name = cleanInput(document.getElementById('completeName').value);
    if (!name) { showToast('الاسم مطلوب', 'error'); btn.disabled = false; btn.textContent = 'حفظ والمتابعة'; return; }
    if (containsBadWord(name)) { showToast('⚠️ اسم غير مسموح به', 'error'); btn.disabled = false; btn.textContent = 'حفظ والمتابعة'; return; }
    updates.name = name;
  }
  if (_missingKeys.includes('phone')) {
    const raw = document.getElementById('completePhone').value.trim().replace(/\D/g,'');
    if (!raw) { showToast('رقم الهاتف مطلوب', 'error'); btn.disabled = false; btn.textContent = 'حفظ والمتابعة'; return; }
    updates.phone = selectedDial2 + raw;
  }
  try {
    updates.lastLoginAt = firebase.firestore.FieldValue.serverTimestamp();
    updates.language    = getLang();
    await db.collection('users').doc(_pendingUser.uid).update(updates);
    const snap = await db.collection('users').doc(_pendingUser.uid).get();
    await syncUserCollections(_pendingUser.uid, snap.exists ? snap.data() : {});
    RATE_LIMIT.reset('login');

// تحقق من تاريخ الميلاد
const snapData = snap.exists ? snap.data() : {};
if (!snapData.birthdate) {
    showBirthdateModal(_pendingUser.uid);
    btn.disabled = false;
    btn.textContent = 'حفظ والمتابعة';
    return;
}

window.location.replace('index.html');
  } catch(err) {
    showToast('حدث خطأ، حاول مجدداً', 'error');
    btn.disabled = false; btn.textContent = 'حفظ والمتابعة';
  }
}

/* ══ SIGNUP ══ */
async function handleSignup() {
  if (!_privacyAccepted) { showToast('يجب الموافقة على السياسة أولاً', 'error'); openPrivacyModal(null); return; }
  
  const name     = cleanInput(document.getElementById('regName').value);
  const user     = cleanInput(document.getElementById('regUser').value).toLowerCase();
  const email    = document.getElementById('emailInput').value.trim();
  const pass     = document.getElementById('regPass').value;
  const rawPhone = document.getElementById('regPhone').value.trim().replace(/\D/g,'');
  const ageVal   = getBdAge();
  const gender   = document.getElementById('regGender').value;

  if (!name)                       { showToast('الاسم مطلوب', 'error'); return; }
  if (containsBadWord(name))       { showToast('⚠️ اسم غير مسموح به', 'error'); return; }
  if (containsBadWord(user))       { showToast('⚠️ اسم مستخدم غير مسموح به', 'error'); return; }
  if (user !== 'ht' && user.length < 4)              { showToast('اسم المستخدم قصير جداً', 'error'); return; }
  if (user !== 'ht' && !/^[a-z0-9._]+$/.test(user)) { showToast('اسم المستخدم يحتوي حروفاً غير مسموح بها', 'error'); return; }
  if (!isValidEmail(email))        { showToast('بريد إلكتروني غير صالح', 'error'); return; }
  if (pass.length < 8)             { showToast('كلمة المرور قصيرة جداً (8+ حروف)', 'error'); return; }
  if (!rawPhone)                   { showToast('رقم الهاتف مطلوب', 'error'); return; }
  if (ageVal < 13 || ageVal > 110) { showToast('يرجى إدخال تاريخ ميلاد صحيح', 'error'); return; }
  if (!gender)                     { showToast('يرجى اختيار الجنس', 'error'); return; }

  await completeSignup();
}

async function completeSignup() {
  const btn          = document.getElementById('signupBtn');
  const name         = cleanInput(document.getElementById('regName').value);
  const user         = cleanInput(document.getElementById('regUser').value).toLowerCase();
  const email        = document.getElementById('emailInput').value.trim();
  const pass         = document.getElementById('regPass').value;
  const rawPhone     = document.getElementById('regPhone').value.trim().replace(/\D/g,'');
  const birthdateVal = getBirthdateString();
  const ageVal       = getBdAge();
  const gender       = document.getElementById('regGender').value;

  btn.disabled = true; btn.innerHTML = '<div class="loader"></div>';
  let cred = null;
  try {
    cred  = await auth.createUserWithEmailAndPassword(email, pass);
    await cred.user.getIdToken(true);
    const check = await db.collection('users').where('username','==',user).limit(1).get();
    if (!check.empty) {
      await cred.user.delete(); await auth.signOut();
      showToast('اسم المستخدم مأخوذ، جرب آخر', 'error');
      btn.disabled = false; btn.textContent = 'إنشاء الحساب'; return;
    }
    const now      = firebase.firestore.FieldValue.serverTimestamp();
    const todayKey = new Date().toISOString().slice(0,10);
    const lang     = localStorage.getItem('anon_lang') || getLang();
    await db.collection('users').doc(cred.user.uid).set({
      id:cred.user.uid, uid:cred.user.uid, username:user, name, email,
      phone: selectedDial + rawPhone, age: ageVal, birthdate: birthdateVal,
      birthdayMMDD: birthdateVal.slice(5).replace('-', ''), gender,
      phoneVerified: true,
      role:'user', isAdmin:false, isVIP:false, isPremium:false,
      anonCoins:10, 
      giftsReceived: 0,
      giftsSent: 0,
      totalGiftsReceived: 0,
      totalGiftsSent: 0,
      bio:"I'm new here! 🕵️", avatar:'', avatarUrl:'', coverUrl:'',
      adminPass:'', followersCount:0, likesCount:0, blockedUsers:[], lang:lang.toUpperCase(),
      language:lang, lastDailyQuestions:null, createdAt:now, lastLoginAt:now,
      isVerified:false, isBanned:false, banReason:'', banUntil:null, isDeleted:false,
      deletedAt:null, questionsReceived:0, questionsAnswered:0, questionsIgnored:0,
      profileViews:0, shareCount:0, premiumUntil:null, premiumPlan:'', totalSpent:0,
      notifNewQuestion:true, notifNewFollower:true, notifAnswers:true, fcmToken:'',
      allowAnonQuestions:true, allowLinks:false, profileIsPublic:true, sensitiveFilter:true,
      followingCount:0, following:[], mutedUsers:[], reportCount:0, lastDevice:'', lastIP:'',
      country:'', timezone:'', themeColor:'#f80566', profileLink:'',
      socialLinks:{instagram:'',twitter:'',tiktok:''}, badge:'', badgeLabel:'',
      xp:0, level:1, streak:1, lastStreakDate:now, achievements:[],
      referralCode:cred.user.uid.slice(0,8).toUpperCase(), referredBy:'', referralCount:0,
      welcomeNotifSent:true, welcomeBonusSent:true, collectionsInitialized:true,
      privacyAccepted:true, privacyAcceptedAt:now,
    });
    // notification بتتعمل في syncUserCollections تلقائياً
    await db.collection('transactions').add({
      userId:cred.user.uid, type:'bonus', amount:10.00,
      balanceBefore:0.00, balanceAfter:10.00, reason:'welcome_bonus', refId:'', createdAt:now
    });
    await db.collection('analytics').doc(`${cred.user.uid}_${todayKey}`).set({
      userId:cred.user.uid, date:todayKey, profileViews:0,
      questionsReceived:0, answersGiven:0, coinsEarned:10, loginCount:1, createdAt:now
    });
    await secureInjectQuestions(cred.user.uid);
    await handleReferralOnSignup(cred.user.uid);
    await fetch('https://my-functions-khaki.vercel.app/api/sendVerifyEmail', {
  method: 'POST',
  headers: { 'Content-Type': 'application/json' },
  body: JSON.stringify({ 
    email, 
    lang: getLang(), 
    name,
    continueUrl: 'https://anonht.com/action.html'
  })
});
    await auth.signOut();
    document.getElementById('signup-section').classList.add('hidden');
    document.getElementById('verify-waiting').classList.remove('hidden');
  } catch(err) {
    const errMap = {
      'auth/too-many-requests':     'تم تجاوز عدد المحاولات، انتظر قليلاً',
      'auth/email-already-in-use':  'البريد الإلكتروني مستخدم بالفعل',
      'auth/weak-password':         'كلمة المرور ضعيفة جداً',
      'auth/invalid-email':         'بريد إلكتروني غير صالح',
      'auth/network-request-failed':'خطأ في الاتصال، تحقق من الإنترنت',
    };
    console.error('Signup error:', err.code, err.message, err);
    if (cred) {
      try { await cred.delete(); } catch(e2) {}
      try { await auth.signOut(); } catch(e2) {}
    }
    showToast(errMap[err.code] || 'حدث خطأ، حاول مجدداً', 'error');
    btn.disabled = false; btn.textContent = 'إنشاء الحساب';
  }
}


/* ══ REFERRAL ON SIGNUP ══ */
async function getDeviceFingerprint() {
  const c = [
    navigator.userAgent, navigator.language,
    screen.width + 'x' + screen.height, screen.colorDepth,
    new Date().getTimezoneOffset(),
    navigator.hardwareConcurrency || 0,
    navigator.deviceMemory || 0,
    window.devicePixelRatio || 1,
  ];
  try {
    const canvas = document.createElement('canvas');
    const ctx = canvas.getContext('2d');
    ctx.font = '14px Arial';
    ctx.fillStyle = '#f80566';
    ctx.fillText('AnonHT', 2, 2);
    c.push(canvas.toDataURL());
  } catch(e) {}
  let hash = 0;
  const str = c.join('|');
  for (let i = 0; i < str.length; i++) {
    hash = ((hash << 5) - hash) + str.charCodeAt(i);
    hash = hash & hash;
  }
  return Math.abs(hash).toString(36);
}

async function handleReferralOnSignup(newUserId) {
  const urlRef = new URLSearchParams(window.location.search).get('ref');
  if (!urlRef) return;
  try {
    const fingerprint = await getDeviceFingerprint();
    const fpCheck = await db.collection('referral_fingerprints')
      .where('fingerprint', '==', fingerprint)
      .where('referralCode', '==', urlRef)
      .limit(1).get();
    if (!fpCheck.empty) return;

    const refSnap = await db.collection('users')
      .where('referralCode', '==', urlRef)
      .limit(1).get();
    if (refSnap.empty) return;

    const referrerId = refSnap.docs[0].id;
    if (referrerId === newUserId) return;

    await db.collection('referral_fingerprints').add({
      fingerprint, referralCode: urlRef,
      referredId: newUserId, referrerId,
      createdAt: firebase.firestore.FieldValue.serverTimestamp()
    });

    await db.collection('referrals').add({
      referrerId, referredId: newUserId,
      referralCode: urlRef, status: 'pending',
      coinsAwarded: 0, fingerprint,
      createdAt: firebase.firestore.FieldValue.serverTimestamp(),
      confirmedAt: null
    });

    await db.collection('users').doc(newUserId).update({
      referredBy: referrerId, referredByCode: urlRef
    });
  } catch(e) {
    console.error('Referral signup error:', e);
  }
}

/* ══ INJECT QUESTIONS ══ */
async function secureInjectQuestions(userId) {
  try {
    const config = await db.collection('system_settings').doc('defaults').get();
    if (!config.exists) return;
    const questions = config.data().welcome_questions;
    if (!Array.isArray(questions)) return;
    const batch = db.batch();
    questions.slice(0,20).forEach(qText => {
      if (typeof qText !== 'string') return;
      const ref = db.collection('questions').doc();
      batch.set(ref, {
        receiverId:userId, senderId:'AnonSystem',
        text:cleanInput(qText), status:'pending',
        answer:'', isAnonymous:true,
        likesCount:0, likedBy:[],
        createdAt:firebase.firestore.FieldValue.serverTimestamp()
      });
    });
    await batch.commit();
  } catch(e) {}
}

/* ══ SYNC COLLECTIONS ══ */
async function syncUserCollections(uid, userData) {
  try {
    const now     = firebase.firestore.FieldValue.serverTimestamp();
    const userRef = db.collection('users').doc(uid);
    const updates = {};
    const defaults = {
      isVerified:false, isBanned:false, banReason:'', banUntil:null, isDeleted:false,
      questionsReceived:0, questionsAnswered:0, questionsIgnored:0,
      profileViews:0, shareCount:0, premiumUntil:null, premiumPlan:'', totalSpent:0,
      notifNewQuestion:true, notifNewFollower:true, notifAnswers:true, fcmToken:'',
      allowAnonQuestions:true, allowLinks:false, profileIsPublic:true, sensitiveFilter:true,
      followingCount:0, following:[], mutedUsers:[], reportCount:0, lastDevice:'', lastIP:'',
      country:'', timezone:'', themeColor:'#f80566', profileLink:'',
      socialLinks:{instagram:'',twitter:'',tiktok:''}, badge:'', badgeLabel:'',
      xp:0, level:1, streak:0, lastStreakDate:null, achievements:[],
      referralCode:uid.slice(0,8).toUpperCase(), referredBy:'', referralCount:0,
    giftsReceived: 0, giftsSent: 0,
      totalGiftsReceived: 0, totalGiftsSent: 0,
    };
    const numericFields = ['questionsReceived','questionsAnswered','questionsIgnored','profileViews','shareCount','totalSpent','followingCount','reportCount','xp','level','streak','referralCount','anonCoins','followersCount','likesCount','giftsReceived','giftsSent','totalGiftsReceived','totalGiftsSent'];
    Object.keys(defaults).forEach(k => { if (userData[k] == null) updates[k] = defaults[k]; });
    numericFields.forEach(k => {
      const cur = userData[k];
      if (cur != null) { const s = Math.max(0, Number(cur)||0); if (s !== cur) updates[k] = s; }
    });
    const today    = new Date().toDateString();
    const lastDate = userData.lastStreakDate
      ? (userData.lastStreakDate.toDate ? userData.lastStreakDate.toDate().toDateString() : new Date(userData.lastStreakDate).toDateString())
      : null;
    if (lastDate !== today) {
      const yesterday = new Date(Date.now()-86400000).toDateString();
      updates.lastStreakDate = now;
      updates.streak = (lastDate === yesterday) ? Math.max(0,(Number(userData.streak)||0)+1) : 1;
    }
    const batch    = db.batch();
    const todayKey = new Date().toISOString().slice(0,10);
    if (!userData.collectionsInitialized) {
      batch.set(db.collection('notifications').doc(), { userId:uid, type:'system', title:'مرحباً بك في Anon! 🎉', body:'ابدأ رحلتك الغامضة', icon:'🎉', isRead:false, actionUrl:'/index.html', refId:'', createdAt:now });
      batch.set(db.collection('transactions').doc(), { userId:uid, type:'bonus', amount:10.00, balanceBefore:0.00, balanceAfter:10.00, reason:'welcome_bonus', refId:'', createdAt:now });
      batch.set(db.collection('analytics').doc(`${uid}_${todayKey}`), { userId:uid, date:todayKey, profileViews:0, questionsReceived:0, answersGiven:0, coinsEarned:10, loginCount:1, createdAt:now }, { merge:true });
      if (!userData.welcomeBonusSent) { updates.anonCoins = Math.max(0,Number(userData.anonCoins)||0)+10; updates.welcomeBonusSent = true; }
      updates.collectionsInitialized = true;
    } else {
      const aSnap = await db.collection('analytics').doc(`${uid}_${todayKey}`).get();
      if (!aSnap.exists) batch.set(db.collection('analytics').doc(`${uid}_${todayKey}`), { userId:uid, date:todayKey, profileViews:0, questionsReceived:0, answersGiven:0, coinsEarned:0, loginCount:1, createdAt:now });
      else batch.update(db.collection('analytics').doc(`${uid}_${todayKey}`), { loginCount: firebase.firestore.FieldValue.increment(1) });
    }
    if (Object.keys(updates).length > 0) batch.update(userRef, updates);

    // إضافة followedAt للمتابعين القدام اللي مش عندهم الحقل
    try {
        const followersSnap = await db.collection('users').doc(uid).collection('followers').get();
        followersSnap.forEach(function(followerDoc) {
            if (!followerDoc.data().followedAt) {
                batch.update(followerDoc.ref, {
                    followedAt: firebase.firestore.Timestamp.fromDate(new Date('2020-01-01'))
                });
            }
        });
    } catch(e) {}

    await batch.commit();
  } catch(err) {}
}

/* ══ LOAD ARTICLES ══ */
async function loadArticles() {
  try {
    const snap  = await db.collection('site_updates').limit(5).get();
    const list  = document.getElementById('articlesList');
    const badge = document.getElementById('articlesBadge');
    if (snap.empty) {
      list.innerHTML = '<div class="no-articles">📭 لا توجد تحديثات</div>';
      badge.style.display = 'none'; return;
    }
    const icons = ['🚀','✨','🔧','📢','🎉','🛡️','💎','⚡'];
    let html = '', newCount = 0, i = 0;
    snap.forEach(doc => {
      const d     = doc.data();
      const title = escapeHtml(d.title || 'تحديث جديد');
      const date  = d.createdAt ? new Date(d.createdAt.toDate()).toLocaleDateString('ar-EG', {year:'numeric',month:'long',day:'numeric'}) : '';
      const views = d.views ? (d.views > 999 ? Math.floor(d.views/1000)+'k' : d.views) : '0';
      const isNew = d.isNew === true;
      if (isNew) newCount++;
      html += `<a class="article-card" href="article.html?id=${doc.id}" target="_blank" rel="noopener">
        <div class="article-icon">${icons[i%icons.length]}</div>
        <div class="article-body">
          <div class="article-cat">${escapeHtml(d.category||'تحديث')}${isNew?' 🆕':''}</div>
          <div class="article-title">${title}</div>
          <div class="article-meta">${date?`<span>📅 ${date}</span>`:''}<span>👁️ ${views}</span></div>
        </div>
        <span class="article-arrow">›</span>
      </a>`;
      i++;
    });
    list.innerHTML = html;
    badge.textContent = newCount > 0 ? `${newCount} جديد` : `${snap.size}`;
  } catch(e) {
    document.getElementById('articlesList').innerHTML = '<div class="no-articles">⚠️ خطأ في التحميل</div>';
  }
}

/* ══ RESET PASSWORD ══ */
async function openResetModal() {
  const email = document.getElementById('loginEmail').value.trim();
  if (!email) { showToast('أدخل بريدك أولاً', 'info'); return; }
  const domain = email.split('@')[1]?.toLowerCase();
  if (BLOCKED_DOMAINS.has(domain)) { showToast('⛔ البريد المؤقت غير مسموح به', 'error', 4000); return; }
  if (!isValidEmail(email)) { showToast('⛔ يُسمح فقط بمزودي بريد موثوقين', 'error', 4000); return; }
  const rl = RATE_LIMIT.check('reset');
  if (!rl.allowed) { showToast(`انتظر ${rl.mins} دقيقة قبل المحاولة مجدداً`, 'info', 4000); return; }
  RATE_LIMIT.increment('reset');

  const lang = getLang();
  const supportedLangs = ['ar', 'en', 'fr'];
  const finalLang = supportedLangs.includes(lang) ? lang : 'ar';

  try {
    const res = await fetch('https://my-functions-khaki.vercel.app/api/sendPasswordReset', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ email, lang: finalLang, name: "" })
    });
    if (res.ok) {
      showToast('تم إرسال رابط الاسترداد ✉️', 'success');
    } else {
      showToast('إذا كان البريد مسجلاً ستصله رسالة قريباً', 'info');
    }
  } catch(e) {
    showToast('إذا كان البريد مسجلاً ستصله رسالة قريباً', 'info');
  }
}

document.getElementById('loginPass').addEventListener('keydown', e => { if (e.key === 'Enter') handleLogin(); });

/* ══ LANG SWITCHER ══ */
function toggleLangMenu() {
  const menu = document.getElementById('langMenu');
  const btn  = document.getElementById('langActiveBtn');
  const open = menu.classList.contains('open');
  menu.classList.toggle('open', !open);
  btn.classList.toggle('open', !open);
}
function selectLang(lang) {
  document.getElementById('langMenu').classList.remove('open');
  document.getElementById('langActiveBtn').classList.remove('open');
  if (typeof LangManager !== 'undefined') LangManager.set(lang);
  const sel = document.getElementById('regLang');
  if (sel) sel.value = lang;
}
document.addEventListener('click', e => {
  if (!e.target.closest('.lang-switcher')) {
    document.getElementById('langMenu')?.classList.remove('open');
    document.getElementById('langActiveBtn')?.classList.remove('open');
  }
});

/* ══ LIVE ANSWERS ══ */
function timeAgo(date) {
  if (!date) return '';
  const diff = Math.floor((Date.now() - date.getTime()) / 1000);
  if (diff < 60)   return 'الآن';
  if (diff < 3600) return `منذ ${Math.floor(diff/60)} د`;
  if (diff < 86400) return `منذ ${Math.floor(diff/3600)} س`;
  return `منذ ${Math.floor(diff/86400)} يوم`;
}

async function loadLiveAnswers() {
  const feed = document.getElementById('answerFeed');
  try {
    const snap = await db.collection('answers')
      .orderBy('likesCount', 'desc')
      .limit(10)
      .get();

    const docs = snap.docs.filter(d => {
      const data = d.data();
      return (data.reply || data.answer || data.text) &&
             (data.likesCount > 0 || (Array.isArray(data.likedBy) && data.likedBy.length > 0));
    }).slice(0, 5);

    if (!docs.length) return loadLiveAnswersFallback();

    const userIds = [...new Set(docs.map(d => (d.data().userId || d.data().receiverId)).filter(Boolean))];
    const userMap = {};
    await Promise.all(userIds.map(async uid => {
      try {
        const u = await db.collection('users').doc(uid).get();
        if (u.exists) userMap[uid] = u.data();
      } catch(e) {}
    }));

    const rankEmojis = ['🥇', '🥈', '🥉'];
    let html = '';

    docs.forEach((doc, index) => {
      const d     = doc.data();
      const uid   = d.userId || d.receiverId;
      const user  = userMap[uid] || {};
      const name  = escapeHtml(user.name || 'مستخدم');
      const uname = escapeHtml(user.username || '');
      const avatar = user.avatarUrl || user.avatar || '';
      const avatarHtml = avatar
        ? `<img src="${escapeHtml(avatar)}" alt="${name}" loading="lazy" onerror="this.parentElement.innerHTML='🕵️'">`
        : '🕵️';
      const question  = escapeHtml((d.questionText || d.question || '').slice(0, 80));
      const answerTxt = escapeHtml((d.reply || d.text || d.answer || '').slice(0, 160));
      const likedBy   = Array.isArray(d.likedBy) ? d.likedBy.length : 0;
      const likes     = Math.max(d.likesCount || 0, likedBy);
      const ago       = (d.answeredAt || d.createdAt) ? timeAgo((d.answeredAt || d.createdAt).toDate()) : '';
      const rank      = index + 1;
      const rankIcon  = rank <= 3 ? rankEmojis[rank - 1] : `#${rank}`;
      const rankClass = rank <= 3 ? `rank-${rank}` : '';
      const isVerified = user.isVerified || user.isPremium;
      const verifiedBadge = isVerified
        ? `<img src="images/verified-logo.png" style="width:14px;height:14px;vertical-align:middle;margin-inline-start:3px;" alt="">`
        : '';

      html += `
      <div class="answer-card" onclick="redirectToSignin('${escapeHtml(uname)}')">
        <div class="answer-card-top">
          <div class="answer-rank-badge ${rankClass}">${rankIcon}</div>
          <div class="answer-avatar">${avatarHtml}</div>
          <div class="answer-user-info">
            <div class="answer-username">${name}${verifiedBadge}</div>
            <div class="answer-time">${uname ? '@' + uname : ''} · ${ago}</div>
          </div>
          <div class="answer-likes-big">
            ❤️
            <div style="display:flex;flex-direction:column;align-items:flex-end;gap:1px;">
              <div>${likes.toLocaleString()}</div>
              <span style="font-size:10px;color:#555;font-weight:700;">إعجاب</span>
            </div>
          </div>
        </div>
        ${question ? `<div class="answer-question">${question}</div>` : ''}
        <div class="answer-text">${answerTxt || '...'}</div>
        <div class="answer-card-footer">
          <div class="answer-likes">🔥 <span style="color:#aaa;">الأكثر تفاعلاً</span></div>
          <div class="answer-join-hint">✨ انضم وتفاعل</div>
        </div>
      </div>`;
    });

    feed.innerHTML = html || '<div class="no-answers">💬 لا توجد إجابات</div>';

  } catch(e) {
    console.log('Top answers error:', e);
    loadLiveAnswersFallback();
  }
}

async function loadLiveAnswersFallback() {
  const feed = document.getElementById('answerFeed');
  try {
    const snap = await db.collection('answers')
      .orderBy('createdAt', 'desc')
      .limit(15)
      .get();

    const docs = snap.docs.filter(d => {
      const data = d.data();
      return data.reply || data.answer || data.text;
    }).slice(0, 5);

    if (!docs.length) {
      feed.innerHTML = '<div class="no-answers">💬 لا توجد إجابات بعد</div>';
      return;
    }

    const userIds = [...new Set(docs.map(d => (d.data().userId || d.data().receiverId)).filter(Boolean))];
    const userMap = {};
    await Promise.all(userIds.map(async uid => {
      try {
        const u = await db.collection('users').doc(uid).get();
        if (u.exists) userMap[uid] = u.data();
      } catch(e) {}
    }));

    let html = '';
    docs.forEach(doc => {
      const d     = doc.data();
      const uid   = d.userId || d.receiverId;
      const user  = userMap[uid] || {};
      const name  = escapeHtml(user.name || 'مستخدم');
      const uname = escapeHtml(user.username || '');
      const avatar = user.avatarUrl || user.avatar || '';
      const avatarHtml = avatar
        ? `<img src="${escapeHtml(avatar)}" alt="${name}" loading="lazy" onerror="this.parentElement.innerHTML='🕵️'">`
        : '🕵️';
      const question  = escapeHtml((d.questionText || d.question || '').slice(0, 80));
      const answerTxt = escapeHtml((d.reply || d.text || d.answer || '').slice(0, 160));
      const likedBy   = Array.isArray(d.likedBy) ? d.likedBy.length : 0;
      const likes     = Math.max(d.likesCount || 0, likedBy);
      const ago       = (d.answeredAt || d.createdAt) ? timeAgo((d.answeredAt || d.createdAt).toDate()) : '';

      html += `
      <div class="answer-card" onclick="redirectToSignin('${escapeHtml(uname)}')">
        <div class="answer-card-top">
          <div class="answer-avatar">${avatarHtml}</div>
          <div class="answer-user-info">
            <div class="answer-username">${name}</div>
            <div class="answer-time">${uname ? '@' + uname : ''} · ${ago}</div>
          </div>
          <div class="answer-likes-big">
            ❤️
            <div style="display:flex;flex-direction:column;align-items:flex-end;gap:1px;">
              <div>${likes.toLocaleString()}</div>
              <span style="font-size:10px;color:#555;font-weight:700;">إعجاب</span>
            </div>
          </div>
        </div>
        ${question ? `<div class="answer-question">${question}</div>` : ''}
        <div class="answer-text">${answerTxt || '...'}</div>
        <div class="answer-card-footer">
          <div class="answer-likes">⏰ <span style="color:#aaa;">الأحدث</span></div>
          <div class="answer-join-hint">✨ انضم وتفاعل</div>
        </div>
      </div>`;
    });

    feed.innerHTML = html || '<div class="no-answers">💬 لا توجد إجابات</div>';
  } catch(e) {
    feed.innerHTML = '<div class="no-answers">⚠️ خطأ في التحميل</div>';
  }
}

function redirectToSignin(username) {
  // لو في username يروح لصفحة البروفايل بعد الدخول
  const next = username ? `?next=profile&u=${encodeURIComponent(username)}` : '';
  document.querySelector('.auth-card')?.scrollIntoView({ behavior: 'smooth', block: 'center' });
  showToast('سجل دخولك أو أنشئ حساب للتفاعل 🔐', 'info', 3000);
}

