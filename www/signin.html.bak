function openPrivacyModal(e) {
  if (e) e.preventDefault();
  const lang = getLang();
  const pc = PRIVACY_CONTENT[lang] || PRIVACY_CONTENT['ar'];
  document.getElementById('privacyModalTitle').textContent = pc.title;
  document.getElementById('privacyModalBody').innerHTML = pc.body;
  document.getElementById('privacyAcceptBtn').textContent = pc.accept;
  document.getElementById('privacyModal').classList.add('open');
  document.body.style.overflow = 'hidden';
}
function closePrivacyModal() {
  document.getElementById('privacyModal').classList.remove('open');
  document.body.style.overflow = '';
}
function acceptPrivacy() {
  _privacyAccepted = true;
  document.getElementById('privacyCb').classList.add('checked');
  document.getElementById('privacyWrap').classList.add('checked');
  document.getElementById('privacyWrap').setAttribute('aria-checked','true');
  const btn = document.getElementById('signupBtn');
  if (btn) btn.disabled = false;
  closePrivacyModal();
  showToast(typeof LangManager !== 'undefined' ? LangManager.t('privacy_accepted') : 'تم القبول ✅', 'success', 2000);
}
function togglePrivacyCheck() {
  if (!_privacyAccepted) { openPrivacyModal(null); return; }
  _privacyAccepted = !_privacyAccepted;
  document.getElementById('privacyCb').classList.toggle('checked', _privacyAccepted);
  document.getElementById('privacyWrap').classList.toggle('checked', _privacyAccepted);
  document.getElementById('privacyWrap').setAttribute('aria-checked', String(_privacyAccepted));
  const btn = document.getElementById('signupBtn');
  if (btn) btn.disabled = !_privacyAccepted;
}
document.getElementById('privacyModal').addEventListener('click', e => { if (e.target === e.currentTarget) closePrivacyModal(); });
document.getElementById('privacyWrap').addEventListener('keydown', e => { if (e.key === ' ' || e.key === 'Enter') { e.preventDefault(); togglePrivacyCheck(); } });

/* ══ Rate Limit ══ */
const RATE_LIMIT = {
  maxAttempts: 5, windowMs: 15*60*1000,
  getKey: a => 'rl_' + a,
  check(a) {
    const key = this.getKey(a);
    let d = JSON.parse(localStorage.getItem(key) || '{"count":0,"resetAt":0}');
    const now = Date.now();
    if (now > d.resetAt) d = { count:0, resetAt: now + this.windowMs };
    if (d.count >= this.maxAttempts) return { allowed:false, mins: Math.ceil((d.resetAt-now)/60000) };
    return { allowed:true };
  },
  increment(a) {
    const key = this.getKey(a);
    let d = JSON.parse(localStorage.getItem(key) || '{"count":0,"resetAt":0}');
    const now = Date.now();
    if (now > d.resetAt) d = { count:0, resetAt: now + this.windowMs };
    d.count++;
    localStorage.setItem(key, JSON.stringify(d));
  },
  reset: a => localStorage.removeItem('rl_' + a)
};

/* ══ Countries ══ */
