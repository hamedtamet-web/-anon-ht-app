<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="preconnect" href="https://www.gstatic.com">
<link rel="preconnect" href="https://firestore.googleapis.com">
<link rel="dns-prefetch" href="https://cdnjs.cloudflare.com">
<link rel="preload" as="image" href="images/bg.webp" fetchpriority="high" imagesrcset="images/bg.webp 480w, images/bg.webp 1200w" imagesizes="100vw">
<link rel="preload" as="image" href="images/logo.png" fetchpriority="high">

<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;700;900&display=swap" media="print" onload="this.media='all'">
<noscript><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;700;900&display=swap"></noscript>
<style>
/* ══════════════════════════════════════
   RESET & VARIABLES
══════════════════════════════════════ */
:root {
  --primary: #f80566;
  --primary-dim: rgba(248,5,102,0.12);
  --primary-glow: rgba(248,5,102,0.25);
  --overlay: rgba(0,0,0,0.88);
  --card-bg: rgba(12,12,16,0.82);
  --border: rgba(255,255,255,0.08);
  --border-hover: rgba(248,5,102,0.35);
  --input-bg: rgba(255,255,255,0.05);
  --text-main: #f0f0f0;
  --text-sub: #aaa;
  --text-muted: #555;
  --radius-card: 28px;
  --radius-input: 18px;
  --radius-btn: 22px;
  --max-w: 440px;
  --transition: 0.25s cubic-bezier(0.4,0,0.2,1);
}

*, *::before, *::after {
  box-sizing: border-box;
  margin: 0; padding: 0;
  -webkit-tap-highlight-color: transparent;
}

html { scroll-behavior: smooth; font-size: 16px; }

body, html {
  width: 100%; min-height: 100%;
  font-family: 'Cairo', sans-serif;
  overflow-x: hidden;
  display: flex; flex-direction: column; align-items: center;
  background: #050505;
  background-image: image-set(url('images/bg.webp') 1x);;
  background-position: center;
  background-size: cover;
  background-attachment: scroll;
  color: var(--text-main);
}

body::before {
  content: ''; position: fixed; inset: 0;
  background: var(--overlay); z-index: -1;
}

/* ══════════════════════════════════════
   LAYOUT
══════════════════════════════════════ */
.main-wrapper {
  display: flex; flex-direction: column; align-items: center;
  width: 100%; flex: 1;
  padding: 16px 16px 32px;
  gap: 20px; z-index: 1;
}

.ad-slot {
  width: 100%; max-width: 728px;
  overflow: hidden;
}

/* ══════════════════════════════════════
   LANG BAR
══════════════════════════════════════ */
.lang-bar {
  width: 100%; max-width: var(--max-w);
  display: flex; justify-content: flex-end;
  padding: 0 4px;
  position: relative; z-index: 999;
}

.lang-switcher { position: relative; }

.lang-active-btn {
  display: flex; align-items: center; gap: 7px;
  background: rgba(255,255,255,0.06);
  border: 1px solid var(--border);
  color: #fff; padding: 8px 14px 8px 12px;
  border-radius: 50px; font-size: 13px; font-weight: 700;
  cursor: pointer; font-family: 'Cairo', sans-serif;
  transition: var(--transition);
  backdrop-filter: blur(10px);
  box-shadow: 0 2px 12px rgba(0,0,0,0.3);
  outline: none;
}
.lang-active-btn:hover,
.lang-active-btn.open {
  border-color: var(--primary);
  background: var(--primary-dim);
  box-shadow: 0 4px 18px var(--primary-glow);
}

.lang-globe { font-size: 16px; line-height: 1; }
.lang-current { font-size: 12px; letter-spacing: 1px; color: #eee; }
.lang-chevron {
  font-size: 11px; color: #888;
  transition: transform 0.3s; display: inline-block; line-height: 1;
}
.lang-active-btn.open .lang-chevron { transform: rotate(180deg); }

.lang-menu {
  position: absolute; top: calc(100% + 8px);
  background: rgba(14,14,14,0.98);
  border: 1px solid rgba(255,255,255,0.1);
  border-radius: 18px; overflow-y: auto;
  min-width: 160px; z-index: 9999;
  max-height: 340px;
  scrollbar-width: thin; scrollbar-color: var(--primary) transparent;
  box-shadow: 0 16px 40px rgba(0,0,0,0.7);
  opacity: 0; pointer-events: none;
  transform: translateY(-8px) scale(0.97);
  transition: all 0.22s cubic-bezier(0.34,1.3,0.64,1);
  backdrop-filter: blur(20px);
}
html[dir="rtl"] .lang-menu { left: 0; }
html[dir="ltr"] .lang-menu { right: 0; }
.lang-menu.open { opacity: 1; pointer-events: auto; transform: translateY(0) scale(1); }

.lang-option {
  display: flex; align-items: center; gap: 10px;
  padding: 11px 16px; cursor: pointer;
  transition: background 0.18s; color: #ccc; font-size: 13px;
  font-family: 'Cairo', sans-serif;
  border-bottom: 1px solid rgba(255,255,255,0.05);
}
.lang-option:last-child { border-bottom: none; }
.lang-option:hover { background: var(--primary-dim); color: #fff; }
.lang-opt-flag { font-size: 18px; line-height: 1; }
.lang-opt-name { flex: 1; font-weight: 600; }
html[dir="rtl"] .lang-opt-name { text-align: right; }
html[dir="ltr"] .lang-opt-name { text-align: left; }
.lang-opt-check { color: var(--primary); font-size: 14px; font-weight: 900; min-width: 16px; text-align: center; }

/* ══════════════════════════════════════
   AUTH CARD
══════════════════════════════════════ */
.auth-card {
  background: var(--card-bg);
  backdrop-filter: blur(28px);
  -webkit-backdrop-filter: blur(28px);
  border: 1px solid var(--border);
  border-radius: var(--radius-card);
  padding: 36px 28px;
  text-align: center;
  width: 100%; max-width: var(--max-w);
  box-shadow: 0 32px 64px rgba(0,0,0,0.6), 0 0 0 1px rgba(255,255,255,0.03);
  position: relative; overflow: hidden;
}
.auth-card::before {
  content: ''; position: absolute;
  top: -80px; right: -80px;
  width: 220px; height: 220px;
  background: radial-gradient(circle, var(--primary-dim), transparent 70%);
  pointer-events: none;
}

.logo-box img {
  width: 60px; height: 60px;
  filter: drop-shadow(0 0 14px var(--primary));
  margin-bottom: 18px;
}

h2 {
  color: #fff; margin-bottom: 6px;
  font-size: clamp(20px, 5vw, 26px);
  font-weight: 900; line-height: 1.3;
}

.subtitle {
  color: var(--text-sub); font-size: 13px;
  margin-bottom: 22px; line-height: 1.7;
}

/* ══════════════════════════════════════
   INPUTS
══════════════════════════════════════ */
.input-group {
  width: 100%; margin-bottom: 13px;
  position: relative;
}

.input-group input,
.gender-select {
  width: 100%; padding: 14px 18px;
  background: var(--input-bg);
  border: 1px solid var(--border);
  border-radius: var(--radius-input);
  color: #fff; outline: none;
  font-family: 'Cairo', sans-serif;
  font-size: 14px; transition: var(--transition);
}
html[dir="rtl"] .input-group input,
html[dir="rtl"] .gender-select { text-align: right; }
html[dir="ltr"] .input-group input,
html[dir="ltr"] .gender-select { text-align: left; }

.input-group input::placeholder { color: #555; }
.input-group input:focus,
.gender-select:focus {
  border-color: var(--primary);
  background: rgba(255,255,255,0.08);
  box-shadow: 0 0 0 3px var(--primary-dim);
}

/* ══════════════════════════════════════
   GENDER SELECT
══════════════════════════════════════ */
.gender-select {
  cursor: pointer; appearance: none; -webkit-appearance: none;
}
.gender-select option { background: #111; color: #fff; }
.gender-select option:disabled { color: #555; }
.select-wrapper { position: relative; }
.select-wrapper::after {
  content: '▾'; position: absolute; top: 50%;
  transform: translateY(-50%);
  color: #666; font-size: 14px; pointer-events: none;
}
html[dir="rtl"] .select-wrapper::after { left: 18px; }
html[dir="ltr"] .select-wrapper::after { right: 18px; }

/* ══════════════════════════════════════
   PASSWORD STRENGTH
══════════════════════════════════════ */
.strength-bar {
  display: flex; gap: 4px;
  margin-top: 6px; padding: 0 4px;
}
.strength-bar span {
  flex: 1; height: 4px; border-radius: 4px;
  background: rgba(255,255,255,0.08);
  transition: background 0.3s;
}
.strength-label {
  font-size: 11px; color: #666;
  margin-top: 3px; padding: 0 4px;
}
html[dir="rtl"] .strength-label { text-align: right; }
html[dir="ltr"] .strength-label { text-align: left; }

/* ══════════════════════════════════════
   PHONE / COUNTRY
══════════════════════════════════════ */
.phone-group { display: flex; gap: 8px; align-items: stretch; }
.phone-group input { flex: 1; }

.country-selector { position: relative; flex-shrink: 0; }

.country-btn {
  display: flex; align-items: center; gap: 5px;
  cursor: pointer; height: 100%;
  padding: 0 12px;
  background: var(--input-bg);
  border: 1px solid var(--border);
  border-radius: var(--radius-input);
  color: #fff; font-family: 'Cairo', sans-serif;
  font-size: 13px; white-space: nowrap;
  transition: var(--transition); user-select: none;
  min-height: 48px;
}
.country-btn:hover { border-color: var(--primary); background: rgba(255,255,255,0.08); }
.country-btn .cflag { font-size: 18px; line-height: 1; }
.country-btn .ccode { font-size: 12px; color: #ccc; }
.country-btn .carrow { font-size: 9px; color: #666; transition: 0.3s; display: inline-block; }
.country-btn.open .carrow { transform: rotate(180deg); }

.country-dropdown {
  position: absolute; top: calc(100% + 6px);
  width: 260px; max-height: 200px; overflow-y: auto;
  background: rgba(16,16,16,0.99);
  border: 1px solid rgba(255,255,255,0.1);
  border-radius: 18px; z-index: 9999;
  display: none;
  box-shadow: 0 20px 40px rgba(0,0,0,0.8);
  scrollbar-width: thin; scrollbar-color: var(--primary) transparent;
}
html[dir="rtl"] .country-dropdown { right: 0; }
html[dir="ltr"] .country-dropdown { left: 0; }
.country-dropdown.open { display: block; animation: dropIn 0.18s ease; }

@keyframes dropIn {
  from { opacity:0; transform:translateY(-6px); }
  to   { opacity:1; transform:translateY(0); }
}

.country-search {
  width: 100%; padding: 11px 14px;
  background: rgba(255,255,255,0.05);
  border: none; border-bottom: 1px solid rgba(255,255,255,0.07);
  color: #fff; font-family: 'Cairo', sans-serif;
  font-size: 13px; outline: none;
  border-radius: 18px 18px 0 0;
}
html[dir="rtl"] .country-search { text-align: right; }
html[dir="ltr"] .country-search { text-align: left; }

.country-item {
  display: flex; align-items: center; gap: 10px;
  padding: 10px 14px; cursor: pointer;
  transition: background 0.15s; font-size: 13px; color: #ccc;
}
.country-item:hover { background: var(--primary-dim); color: #fff; }
.country-item .ci-flag { font-size: 18px; }
.country-item .ci-name { flex: 1; }
html[dir="rtl"] .country-item .ci-name { text-align: right; }
html[dir="ltr"] .country-item .ci-name { text-align: left; }
.country-item .ci-dial { color: #555; font-size: 12px; direction: ltr; }

/* ══════════════════════════════════════
   PRIVACY
══════════════════════════════════════ */
.privacy-wrap {
  display: flex; align-items: flex-start; gap: 10px;
  background: var(--primary-dim);
  border: 1px solid rgba(248,5,102,0.18);
  border-radius: 16px; padding: 12px 14px;
  margin-bottom: 14px; cursor: pointer;
  transition: border-color 0.3s, background 0.3s;
}
html[dir="rtl"] .privacy-wrap { text-align: right; }
html[dir="ltr"] .privacy-wrap { text-align: left; }
.privacy-wrap:hover { border-color: var(--border-hover); background: rgba(248,5,102,0.1); }
.privacy-wrap.checked { border-color: rgba(248,5,102,0.5); background: rgba(248,5,102,0.1); }

.custom-cb {
  width: 22px; height: 22px; min-width: 22px;
  border-radius: 8px;
  border: 2px solid rgba(255,255,255,0.2);
  background: rgba(255,255,255,0.04);
  display: flex; align-items: center; justify-content: center;
  transition: all 0.25s cubic-bezier(0.34,1.56,0.64,1);
  margin-top: 2px; cursor: pointer; flex-shrink: 0;
}
.custom-cb.checked {
  background: var(--primary); border-color: var(--primary);
  box-shadow: 0 0 14px var(--primary-glow);
}
.custom-cb .cb-check {
  opacity: 0; transform: scale(0) rotate(-45deg);
  transition: all 0.25s cubic-bezier(0.34,1.56,0.64,1);
  color: #fff; font-size: 13px; font-weight: 900; line-height: 1;
}
.custom-cb.checked .cb-check { opacity: 1; transform: scale(1) rotate(0deg); }

.privacy-text { flex: 1; font-size: 12px; color: #999; line-height: 1.8; }
.privacy-text a {
  color: var(--primary); text-decoration: none; font-weight: 700;
  border-bottom: 1px dashed rgba(248,5,102,0.4);
  transition: border-color 0.2s;
}
.privacy-text a:hover { border-color: var(--primary); }

/* ══════════════════════════════════════
   BUTTONS
══════════════════════════════════════ */
.submit-btn {
  width: 100%; padding: 15px;
  background: linear-gradient(135deg, var(--primary), #c4024e);
  color: #fff; border: none;
  border-radius: var(--radius-btn);
  font-weight: 800; font-size: 16px;
  cursor: pointer; transition: var(--transition);
  font-family: 'Cairo', sans-serif;
  box-shadow: 0 8px 24px var(--primary-glow);
  position: relative; overflow: hidden;
}
.submit-btn::after {
  content: ''; position: absolute; inset: 0;
  background: linear-gradient(135deg, rgba(255,255,255,0.1), transparent);
  pointer-events: none;
}
.submit-btn:hover:not(:disabled) {
  transform: translateY(-2px);
  box-shadow: 0 12px 32px rgba(248,5,102,0.45);
}
.submit-btn:active:not(:disabled) { transform: scale(0.98); }
.submit-btn:disabled {
  opacity: 0.4; cursor: not-allowed;
  transform: none; box-shadow: none; filter: grayscale(0.3);
}

.forgot-link {
  display: block; margin-top: 12px;
  color: #666; font-size: 12px; cursor: pointer;
  transition: color 0.2s;
}
.forgot-link:hover { color: var(--primary); }

.switch-area { margin-top: 22px; color: #888; font-size: 13px; }
.switch-area b {
  color: var(--primary); cursor: pointer;
  transition: opacity 0.2s;
}
.switch-area b:hover { opacity: 0.8; }
html[dir="rtl"] .switch-area b { margin-right: 5px; }
html[dir="ltr"] .switch-area b { margin-left: 5px; }

/* ══════════════════════════════════════
   LOADER
══════════════════════════════════════ */
.loader {
  width: 24px; height: 24px;
  border: 3px solid rgba(255,255,255,0.1);
  border-top-color: #fff;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
  margin: 0 auto;
}
@keyframes spin { 100% { transform: rotate(360deg); } }

/* ══════════════════════════════════════
   MISSING NOTICE
══════════════════════════════════════ */
.missing-notice {
  background: var(--primary-dim);
  border: 1px solid rgba(248,5,102,0.3);
  border-radius: 16px; padding: 14px 16px;
  margin-bottom: 16px;
}
html[dir="rtl"] .missing-notice { text-align: right; }
html[dir="ltr"] .missing-notice { text-align: left; }
.missing-notice .mn-title {
  color: var(--primary); font-size: 13px;
  font-weight: 800; margin-bottom: 8px;
}
.missing-notice ul { list-style: none; }
.missing-notice ul li {
  color: #ccc; font-size: 13px; padding: 3px 0;
  display: flex; align-items: center; gap: 7px;
}
.missing-notice ul li::before { content: '⚠️'; font-size: 12px; }

/* ══════════════════════════════════════
   ABOUT SECTION
══════════════════════════════════════ */
.about-section {
  width: 100%; max-width: var(--max-w);
  background: rgba(12,12,16,0.7);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  border: 1px solid var(--border);
  border-radius: var(--radius-card);
  overflow: hidden;
}

.about-banner {
  background: linear-gradient(135deg, rgba(248,5,102,0.14), rgba(100,0,50,0.1));
  border-bottom: 1px solid rgba(248,5,102,0.1);
  padding: 20px; display: flex; align-items: center; gap: 14px;
}
html[dir="rtl"] .about-banner { text-align: right; }
html[dir="ltr"] .about-banner { text-align: left; }

.about-banner-icon {
  width: 50px; height: 50px; min-width: 50px;
  background: var(--primary-dim);
  border: 1px solid rgba(248,5,102,0.2);
  border-radius: 15px;
  display: flex; align-items: center; justify-content: center;
  font-size: 22px; flex-shrink: 0;
}
.about-banner-title { color: #fff; font-size: 15px; font-weight: 900; margin-bottom: 3px; }
.about-banner-sub { color: var(--text-sub); font-size: 12px; line-height: 1.6; }

.about-stats { display: flex; border-bottom: 1px solid var(--border); }
.stat-item {
  flex: 1; padding: 15px 8px; text-align: center;
  border-inline-start: 1px solid var(--border);
  transition: background 0.2s;
}
.stat-item:first-child { border-inline-start: none; }
.stat-item:hover { background: var(--primary-dim); }
.stat-num {
  color: var(--primary); font-size: 17px; font-weight: 900;
  display: block; line-height: 1; margin-bottom: 5px;
}
.stat-label { color: #555; font-size: 10px; }

.about-features {
  display: flex; flex-wrap: wrap; gap: 7px;
  padding: 14px 16px;
}
.feat-pill {
  display: flex; align-items: center; gap: 5px;
  background: rgba(255,255,255,0.03);
  border: 1px solid var(--border);
  border-radius: 50px; padding: 6px 12px;
  font-size: 11px; color: #bbb; white-space: nowrap;
  transition: border-color 0.2s;
}
.feat-pill:hover { border-color: rgba(248,5,102,0.3); }

/* ══════════════════════════════════════
   UPDATES SECTION
══════════════════════════════════════ */
.updates-section {
  width: 100%; max-width: var(--max-w);
  background: rgba(12,12,16,0.7);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  border: 1px solid var(--border);
  border-radius: var(--radius-card);
  padding: 22px 20px 18px;
  overflow: hidden;
}

.updates-header {
  display: flex; align-items: center;
  justify-content: space-between;
  margin-bottom: 16px; gap: 10px;
}
.updates-title {
  display: flex; align-items: center; gap: 9px;
  color: #fff; font-size: 14px; font-weight: 800;
}
.updates-title .u-icon {
  width: 30px; height: 30px;
  background: var(--primary-dim); border-radius: 10px;
  display: flex; align-items: center; justify-content: center;
  font-size: 14px;
}
.updates-badge {
  background: var(--primary); color: #fff;
  font-size: 10px; font-weight: 800;
  padding: 3px 9px; border-radius: 50px;
}

.article-list { display: flex; flex-direction: column; gap: 9px; }

.article-card {
  background: rgba(255,255,255,0.02);
  border: 1px solid var(--border);
  border-radius: 18px; padding: 13px 15px;
  display: flex; align-items: flex-start; gap: 12px;
  transition: border-color 0.25s, background 0.25s;
  cursor: pointer; text-decoration: none;
}
.article-card:hover {
  border-color: rgba(248,5,102,0.3);
  background: var(--primary-dim);
}
.article-icon {
  width: 38px; height: 38px; min-width: 38px;
  border-radius: 12px; background: var(--primary-dim);
  display: flex; align-items: center; justify-content: center;
  font-size: 17px; flex-shrink: 0;
}
.article-body { flex: 1; min-width: 0; }
html[dir="rtl"] .article-body { text-align: right; }
html[dir="ltr"] .article-body { text-align: left; }
.article-cat {
  font-size: 10px; color: var(--primary);
  font-weight: 700; letter-spacing: 0.8px; margin-bottom: 3px;
}
.article-title {
  color: #e0e0e0; font-size: 13px; font-weight: 700;
  line-height: 1.5; margin-bottom: 5px;
  white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
}
.article-meta {
  color: #555; font-size: 11px;
  display: flex; gap: 10px; align-items: center; flex-wrap: wrap;
}
.article-arrow {
  color: #444; font-size: 14px;
  margin-top: 2px; transition: color 0.2s; flex-shrink: 0;
}
.article-card:hover .article-arrow { color: var(--primary); }
.no-articles { text-align: center; color: #555; font-size: 13px; padding: 20px 0; }

/* ══════════════════════════════════════
   MAINTENANCE
══════════════════════════════════════ */
.maintenance-banner {
  width: 100%; max-width: var(--max-w);
  background: rgba(244,63,94,0.07);
  border: 1px solid rgba(244,63,94,0.28);
  border-radius: var(--radius-card);
  padding: 28px 22px; text-align: center;
  animation: maintPulse 3s ease-in-out infinite;
}
@keyframes maintPulse {
  0%,100% { box-shadow: 0 0 0 0 rgba(244,63,94,0); }
  50%      { box-shadow: 0 0 30px rgba(244,63,94,0.15); }
}
.maint-icon {
  font-size: 48px; margin-bottom: 14px; display: block;
  animation: maintRock 4s linear infinite;
}
@keyframes maintRock {
  0%,100% { transform: rotate(-5deg); }
  50%      { transform: rotate(5deg); }
}
.maint-title  { color: #f43f5e; font-size: 20px; font-weight: 900; margin-bottom: 9px; }
.maint-msg    { color: #ccc; font-size: 13px; line-height: 1.8; margin-bottom: 18px; }
.maint-timer-label { color: #666; font-size: 11px; font-weight: 700; letter-spacing: 2px; text-transform: uppercase; margin-bottom: 8px; }
.maint-timer  { font-size: clamp(36px,10vw,52px); font-weight: 900; color: #fff; letter-spacing: 2px; line-height: 1; margin-bottom: 6px; text-shadow: 0 0 30px rgba(244,63,94,0.4); }
.maint-timer span { color: #f43f5e; }
.maint-timer-sub { color: #555; font-size: 11px; margin-bottom: 18px; }
.maint-progress { width: 100%; height: 4px; background: rgba(255,255,255,0.06); border-radius: 4px; overflow: hidden; margin-bottom: 16px; }
.maint-progress-fill { height: 100%; background: linear-gradient(90deg,#f43f5e,var(--primary)); border-radius: 4px; transition: width 1s linear; }
.maint-badge {
  display: inline-flex; align-items: center; gap: 6px;
  background: rgba(244,63,94,0.1); border: 1px solid rgba(244,63,94,0.25);
  border-radius: 50px; padding: 6px 14px;
  font-size: 12px; font-weight: 700; color: #f43f5e;
}
.maint-badge-dot { width: 7px; height: 7px; border-radius: 50%; background: #f43f5e; animation: maintRock 1s infinite; }
.maint-admin-link { display: block; margin-top: 14px; color: #555; font-size: 12px; cursor: pointer; text-decoration: underline; transition: color 0.2s; }
.maint-admin-link:hover { color: #f43f5e; }

/* ══════════════════════════════════════
   MODAL
══════════════════════════════════════ */
.modal-overlay {
  position: fixed; inset: 0;
  background: rgba(0,0,0,0.88);
  backdrop-filter: blur(12px);
  z-index: 99990;
  display: flex; align-items: flex-end; justify-content: center;
  opacity: 0; pointer-events: none; transition: opacity 0.3s;
}
.modal-overlay.open { opacity: 1; pointer-events: auto; }

.modal-sheet {
  width: 100%; max-width: 560px; max-height: 85vh;
  background: #0e0e0e; border: 1px solid rgba(255,255,255,0.08);
  border-radius: 28px 28px 0 0; overflow: hidden;
  display: flex; flex-direction: column;
  transform: translateY(100%);
  transition: transform 0.38s cubic-bezier(0.34,1.1,0.64,1);
}
.modal-overlay.open .modal-sheet { transform: translateY(0); }

.modal-handle {
  width: 40px; height: 4px;
  background: rgba(255,255,255,0.12);
  border-radius: 4px; margin: 12px auto 0;
  flex-shrink: 0;
}
.modal-head {
  padding: 16px 22px 14px;
  border-bottom: 1px solid var(--border);
  display: flex; align-items: center; justify-content: space-between;
  flex-shrink: 0;
}
.modal-head h3 { color: #fff; font-size: 15px; font-weight: 800; }
.modal-close {
  width: 32px; height: 32px; border-radius: 10px;
  background: rgba(255,255,255,0.06);
  border: none; color: #aaa; font-size: 16px; cursor: pointer;
  display: flex; align-items: center; justify-content: center;
  transition: 0.2s;
}
.modal-close:hover { background: var(--primary-dim); color: var(--primary); }
.modal-body {
  padding: 18px 22px; overflow-y: auto; flex: 1;
  scrollbar-width: thin; scrollbar-color: var(--primary) transparent;
}
html[dir="rtl"] .modal-body { text-align: right; }
html[dir="ltr"] .modal-body { text-align: left; }
.modal-body h4 { color: var(--primary); font-size: 13px; font-weight: 800; margin: 16px 0 7px; }
.modal-body h4:first-child { margin-top: 0; }
.modal-body p, .modal-body li { color: #aaa; font-size: 12.5px; line-height: 1.85; }
.modal-body ul { margin: 6px 0; }
html[dir="rtl"] .modal-body ul { padding-right: 16px; }
html[dir="ltr"] .modal-body ul { padding-left: 16px; }
.modal-body ul li { margin-bottom: 4px; }
.modal-footer-btn { padding: 14px 22px; border-top: 1px solid var(--border); flex-shrink: 0; }
.modal-accept-btn {
  width: 100%; padding: 13px;
  background: linear-gradient(135deg, var(--primary), #c4024e);
  color: #fff; border: none;
  border-radius: 16px; font-family: 'Cairo', sans-serif;
  font-size: 14px; font-weight: 800; cursor: pointer; transition: 0.3s;
}
.modal-accept-btn:hover { box-shadow: 0 8px 20px var(--primary-glow); transform: translateY(-1px); }

/* ══════════════════════════════════════
   TOAST
══════════════════════════════════════ */
#toast {
  position: fixed; top: 20px; left: 50%;
  transform: translateX(-50%) translateY(-80px);
  background: rgba(16,16,16,0.97);
  backdrop-filter: blur(20px);
  border-radius: 18px; padding: 13px 20px;
  display: flex; align-items: center; gap: 11px;
  font-family: 'Cairo', sans-serif; font-size: 13px; font-weight: 600;
  color: #fff; z-index: 99999;
  min-width: 240px; max-width: min(340px, calc(100vw - 32px));
  box-shadow: 0 12px 40px rgba(0,0,0,0.6);
  border: 1px solid rgba(255,255,255,0.07);
  transition: transform 0.4s cubic-bezier(0.34,1.56,0.64,1), opacity 0.3s;
  opacity: 0; pointer-events: none;
}
#toast.show { transform: translateX(-50%) translateY(0); opacity: 1; pointer-events: auto; }
#toast .t-icon-wrap {
  width: 34px; height: 34px; border-radius: 11px;
  flex-shrink: 0; display: flex; align-items: center; justify-content: center; font-size: 17px;
}
#toast .t-text { flex: 1; line-height: 1.5; }
html[dir="rtl"] #toast .t-text { text-align: right; }
html[dir="ltr"] #toast .t-text { text-align: left; }
#toast.t-error   { border-color: rgba(248,5,102,0.35); }
#toast.t-success { border-color: rgba(74,222,128,0.3); }
#toast.t-info    { border-color: rgba(96,165,250,0.3); }
#toast.t-error   .t-icon-wrap { background: var(--primary-dim); }
#toast.t-success .t-icon-wrap { background: rgba(74,222,128,0.1); }
#toast.t-info    .t-icon-wrap { background: rgba(96,165,250,0.1); }
#toast .t-bar {
  position: absolute; bottom: 0;
  height: 3px; border-radius: 0 0 18px 18px;
  background: var(--primary);
  animation: shrink linear forwards;
}
html[dir="rtl"] #toast .t-bar { right: 0; }
html[dir="ltr"] #toast .t-bar { left: 0; }
@keyframes shrink { from{width:100%} to{width:0%} }

/* ══════════════════════════════════════
   FOOTER
══════════════════════════════════════ */
.page-footer {
  width: 100%; max-width: var(--max-w);
  padding: 14px 10px 28px; text-align: center;
  color: #333; font-size: 12px; line-height: 2.2;
}
.page-footer a {
  color: #555; text-decoration: none;
  transition: color 0.2s; margin: 0 5px;
}
.page-footer a:hover { color: var(--primary); }
.footer-divider { color: #2a2a2a; margin: 0 3px; }

/* ══ BIRTHDATE PICKER ══ */
.birthdate-picker {
  width: 100%;
  background: var(--input-bg);
  border: 1px solid var(--border);
  border-radius: var(--radius-input);
  padding: 10px 14px;
  transition: var(--transition);
  display: flex; align-items: center; gap: 8px;
}
.birthdate-picker:focus-within {
  border-color: var(--primary);
  background: rgba(255,255,255,0.08);
  box-shadow: 0 0 0 3px var(--primary-dim);
}
.bd-col {
  display: flex; flex-direction: column; align-items: center;
  gap: 2px; flex: 1;
}
.bd-col.year-col { flex: 1.4; }
.bd-arrow {
  width: 100%; height: 24px;
  background: rgba(255,255,255,0.06);
  border: 1px solid rgba(255,255,255,0.1);
  border-radius: 8px;
  color: #aaa; font-size: 12px;
  cursor: pointer; display: flex; align-items: center; justify-content: center;
  transition: all 0.2s; user-select: none;
}
.bd-arrow:hover { background: var(--primary-dim); border-color: var(--primary); color: var(--primary); }
.bd-arrow:active { transform: scale(0.92); }
.bd-val {
  font-size: 16px; font-weight: 800; color: #fff;
  font-family: 'Cairo', sans-serif;
  min-width: 32px; text-align: center;
  padding: 3px 0; line-height: 1.4;
}
.bd-val.year-val { min-width: 46px; font-size: 15px; }
.bd-sep { color: #444; font-size: 20px; font-weight: 300; align-self: center; }
.bd-age-label {
  font-size: 11px; margin-top: 5px; padding: 0 4px;
  font-family: 'Cairo', sans-serif;
}
html[dir="rtl"] .bd-age-label { text-align: right; }
html[dir="ltr"] .bd-age-label { text-align: left; }

/* ══════════════════════════════════════
   LIVE ANSWERS SECTION
══════════════════════════════════════ */
.answers-section {
  width: 100%; max-width: var(--max-w);
  background: rgba(12,12,16,0.7);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  border: 1px solid var(--border);
  border-radius: var(--radius-card);
  padding: 22px 20px 18px;
  overflow: hidden;
}

.answers-header {
  display: flex; align-items: center;
  justify-content: space-between;
  margin-bottom: 16px; gap: 10px;
}
.answers-title {
  display: flex; align-items: center; gap: 9px;
  color: #fff; font-size: 14px; font-weight: 800;
}
.answers-title .a-icon {
  width: 30px; height: 30px;
  background: var(--primary-dim); border-radius: 10px;
  display: flex; align-items: center; justify-content: center;
  font-size: 14px;
}
.answers-live-badge {
  display: flex; align-items: center; gap: 5px;
  background: rgba(248,5,102,0.1);
  border: 1px solid rgba(248,5,102,0.25);
  border-radius: 50px; padding: 4px 10px;
  font-size: 10px; font-weight: 800; color: var(--primary);
}
.answers-live-dot {
  width: 6px; height: 6px; border-radius: 50%;
  background: var(--primary);
  animation: livePulse 1.2s ease-in-out infinite;
}
@keyframes livePulse {
  0%,100% { opacity: 1; transform: scale(1); }
  50%      { opacity: 0.4; transform: scale(0.7); }
}

.answer-feed { display: flex; flex-direction: column; gap: 10px; }

.answer-card {
  background: linear-gradient(145deg, rgba(248,5,102,0.04), rgba(12,12,16,0.8));
  border: 1px solid rgba(248,5,102,0.15);
  border-radius: 18px; padding: 14px 15px;
  cursor: pointer;
  transition: all 0.3s cubic-bezier(0.4,0,0.2,1);
  position: relative; overflow: hidden;
  box-shadow: 0 4px 20px rgba(248,5,102,0.06);
}
.answer-card::before {
  content: ''; position: absolute;
  inset: 0; opacity: 0;
  background: radial-gradient(circle at 50% 50%, rgba(248,5,102,0.1), transparent 70%);
  transition: opacity 0.3s; pointer-events: none;
}
.answer-card:hover {
  border-color: rgba(248,5,102,0.35);
  box-shadow: 0 8px 30px rgba(248,5,102,0.18);
  transform: translateY(-2px);
}
.answer-card:hover::before { opacity: 1; }

.answer-card-top {
  display: flex; align-items: center; gap: 10px;
  margin-bottom: 10px;
}
.answer-avatar {
  width: 36px; height: 36px; min-width: 36px;
  border-radius: 50%; background: var(--primary-dim);
  border: 2px solid rgba(248,5,102,0.2);
  display: flex; align-items: center; justify-content: center;
  font-size: 15px; overflow: hidden; flex-shrink: 0;
}
.answer-avatar img {
  width: 100%; height: 100%; object-fit: cover; border-radius: 50%;
}
.answer-user-info { flex: 1; min-width: 0; }
html[dir="rtl"] .answer-user-info { text-align: right; }
html[dir="ltr"] .answer-user-info { text-align: left; }
.answer-username {
  color: #e0e0e0; font-size: 13px; font-weight: 800;
  white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
}
.answer-time { color: #555; font-size: 11px; margin-top: 2px; }

.answer-question {
  background: rgba(248,5,102,0.06);
  border: 1px solid rgba(248,5,102,0.12);
  border-radius: 12px; padding: 9px 12px;
  margin-bottom: 8px;
  color: #999; font-size: 12px; line-height: 1.7;
  position: relative;
}
html[dir="rtl"] .answer-question { text-align: right; }
html[dir="ltr"] .answer-question { text-align: left; }
.answer-question::before {
  content: '❓'; font-size: 11px; margin-inline-end: 5px;
}

.answer-text {
  color: #ddd; font-size: 13px; line-height: 1.75;
  display: -webkit-box; -webkit-line-clamp: 3;
  -webkit-box-orient: vertical; overflow: hidden;
}
html[dir="rtl"] .answer-text { text-align: right; }
html[dir="ltr"] .answer-text { text-align: left; }

.answer-card-footer {
  display: flex; align-items: center; justify-content: space-between;
  margin-top: 10px; padding-top: 10px;
  border-top: 1px solid rgba(255,255,255,0.04);
}
.answer-likes {
  display: flex; align-items: center; gap: 5px;
  color: #555; font-size: 12px;
}
.answer-likes span { color: #444; }
.answer-join-hint {
  display: flex; align-items: center; gap: 5px;
  background: var(--primary-dim);
  border: 1px solid rgba(248,5,102,0.2);
  border-radius: 50px; padding: 5px 12px;
  font-size: 11px; font-weight: 700; color: var(--primary);
  transition: background 0.2s;
}
.answer-card:hover .answer-join-hint {
  background: rgba(248,5,102,0.18);
}

.no-answers { text-align: center; color: #555; font-size: 13px; padding: 20px 0; }

.answer-rank-badge {
  display: flex; align-items: center; justify-content: center;
  width: 24px; height: 24px; border-radius: 8px;
  font-size: 12px; font-weight: 900; flex-shrink: 0;
  background: rgba(255,255,255,0.06); color: #555;
}
.answer-rank-badge.rank-1 { background: rgba(255,215,0,0.15); color: #FFD700; }
.answer-rank-badge.rank-2 { background: rgba(192,192,192,0.15); color: #C0C0C0; }
.answer-rank-badge.rank-3 { background: rgba(205,127,50,0.15); color: #CD7F32; }
.answer-likes-big {
  display: flex; align-items: center; gap: 5px;
  font-size: 14px; font-weight: 900; color: var(--primary);
  margin-inline-start: auto; flex-shrink: 0;
}

/* ══ TOP ANSWERS SECTION ══ */
.answers-section .section-subtitle {
  font-size: 11px;
  color: #555;
  font-weight: 700;
  margin-bottom: 14px;
  display: flex;
  align-items: center;
  gap: 6px;
}
.answer-rank-badge {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 24px; height: 24px;
  border-radius: 8px;
  font-size: 12px;
  font-weight: 900;
  flex-shrink: 0;
  background: rgba(255,255,255,0.06);
  color: #555;
}
.answer-rank-badge.rank-1 { background: rgba(255,215,0,0.15); color: #FFD700; }
.answer-rank-badge.rank-2 { background: rgba(192,192,192,0.15); color: #C0C0C0; }
.answer-rank-badge.rank-3 { background: rgba(205,127,50,0.15); color: #CD7F32; }
.answer-likes-big {
  display: flex;
  align-items: center;
  gap: 4px;
  font-size: 14px;
  font-weight: 900;
  color: var(--primary);
}
.answer-likes-big span { font-size: 11px; color: #555; font-weight: 700; }

@media (max-width: 480px) {
  .answers-section { border-radius: 22px; padding: 18px 15px 15px; }
  .answer-card { padding: 12px 13px; }
}
@media (min-width: 768px) {
  .answers-section { border-radius: 30px; }
}

/* ══════════════════════════════════════
   UTILITIES
══════════════════════════════════════ */
.hidden { display: none !important; }

/* ══════════════════════════════════════
   RESPONSIVE
══════════════════════════════════════ */
@media (max-width: 480px) {
  .auth-card { padding: 28px 18px; border-radius: 22px; }
  .about-section, .updates-section { border-radius: 22px; }
  .about-banner { padding: 16px; gap: 12px; }
  .about-banner-icon { width: 44px; height: 44px; font-size: 20px; }
  .about-banner-title { font-size: 14px; }
  .stat-label { font-size: 9px; }
  .updates-section { padding: 18px 15px 15px; }
  .article-card { padding: 11px 13px; gap: 10px; }
  .article-icon { width: 34px; height: 34px; font-size: 15px; }
  .country-dropdown { width: 230px; }
  .main-wrapper { padding: 12px 12px 28px; gap: 16px; }
}

@media (max-width: 360px) {
  h2 { font-size: 19px; }
  .auth-card { padding: 22px 14px; }
  .submit-btn { font-size: 15px; padding: 13px; }
  .about-stats .stat-num { font-size: 14px; }
}

@media (min-width: 768px) {
  .auth-card { padding: 44px 40px; }
  .about-section, .updates-section { border-radius: 30px; }
  .main-wrapper { padding: 24px 20px 40px; gap: 22px; }
}

@media (min-width: 1024px) {
  .main-wrapper { padding: 28px 24px 48px; }
}

/* ══════════════════════════════════════
   DESKTOP LAYOUT (≥ 1100px)
══════════════════════════════════════ */
@media (min-width: 1100px) {
  body { align-items: flex-start; }

  .main-wrapper { display: none !important; }

  .page-footer {
    position: fixed; bottom: 0; left: 0; right: 0;
    background: rgba(5,5,5,0.9);
    backdrop-filter: blur(10px);
    border-top: 1px solid var(--border);
    padding: 10px 20px; z-index: 100; margin: 0;
  }

  #desktopLayout {
    flex-direction: row !important;
    align-items: stretch;
    min-height: 100vh;
    width: 100%;
  }

  .desktop-right-panel {
    flex: 1; min-height: 100vh;
    display: flex; flex-direction: column;
    align-items: center; justify-content: center;
    padding: 40px 0px 40px 40px;
    position: relative; overflow: visible;
  }

  .desktop-right-panel::before { display: none; }
  .logo-ring, .float-dot { display: none; }

  .desktop-logo-big {
    animation: none;
    position: relative;
    z-index: 1;
    align-items: center;
    display: flex;
    flex-direction: column;
    gap: 20px;
    margin-inline-end: -80px;
  }

  .desktop-logo-big img {
    width: 180px; height: 180px;
    filter: drop-shadow(0 0 60px var(--primary)) drop-shadow(0 0 120px rgba(248,5,102,0.5));
    border-radius: 40px;
  }

  .desktop-logo-tagline {
    font-size: 24px; font-weight: 900;
    color: #fff; text-align: center;
    line-height: 1.5;
    text-shadow: 0 0 30px rgba(248,5,102,0.5);
    margin-top: 16px;
  }

  .desktop-logo-tagline span { color: var(--primary); }

  .desktop-logo-sub {
    font-size: 13px; color: #666;
    text-align: center; line-height: 1.8;
    max-width: 240px; margin-top: 8px;
  }

  .desktop-center-panel {
    width: 480px; min-width: 440px;
    min-height: 100vh;
    display: flex; flex-direction: column;
    align-items: center; justify-content: center;
    padding: 24px 0 40px;
    gap: 20px; z-index: 2;
    position: relative;
  }

  .desktop-left-panel {
    flex: 1; min-height: 100vh;
    display: flex; flex-direction: column;
    align-items: center; justify-content: center;
    padding: 40px 40px 40px 0px;
    position: relative; overflow: hidden;
  }

  .desktop-left-panel::before { display: none; }

  .desktop-ad-panel {
    display: flex; flex-direction: column;
    align-items: center; gap: 20px;
    z-index: 2; width: 100%;
    max-width: 200px;
    margin-inline-start: -60px;
  }

  .desktop-ad-box {
    width: 100%;
    background: rgba(12,12,16,0.7);
    border: 1px solid var(--border);
    border-radius: 24px; padding: 16px;
    backdrop-filter: blur(20px);
    display: flex; align-items: center;
    justify-content: center;
    min-height: 620px;
    position: relative; overflow: hidden;
    transition: border-color 0.3s;
  }

  .desktop-ad-box:hover { border-color: rgba(248,5,102,0.2); }

  .desktop-ad-box::before {
    content: '';
    position: absolute; inset: 0;
    background: radial-gradient(circle at 50% 0%, rgba(248,5,102,0.05), transparent 70%);
    pointer-events: none;
  }
}

</style>
