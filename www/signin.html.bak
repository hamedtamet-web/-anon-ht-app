<script>
'use strict';
firebase.initializeApp(APP_CONFIG.firebase);
const db   = firebase.firestore();
const auth = firebase.auth();

/* ══ Lang helpers ══ */
function getLang() { return document.documentElement.lang || 'ar'; }

function getVerifyTemplateId() {
  const map = { ar:'verify-email', en:'verify-email-en', fr:'verify-email-fr' };
  return map[getLang()] || 'verify-email';
}
function getResetTemplateId() {
  const map = { ar:'reset-password-ar', en:'reset-password-en', fr:'reset-password-fr' };
  return map[getLang()] || 'reset-password-ar';
}

document.addEventListener('langChanged', () => {
  const go  = { label:'gender_label', male:'gender_male', female:'gender_female', other:'gender_other' };
  const ids = { label:'genderLabelOpt', male:'genderMaleOpt', female:'genderFemaleOpt', other:'genderOtherOpt' };
  Object.keys(go).forEach(k => {
    const el = document.getElementById(ids[k]);
    if (el) el.textContent = LangManager.t(go[k]);
  });
  const lang = getLang();
  const ph = lang === 'en' ? 'Search country...' : lang === 'fr' ? 'Rechercher un pays...' : 'ابحث عن دولة...';
  document.querySelectorAll('.country-search').forEach(el => el.placeholder = ph);
  updateStrengthLabel();
});

/* ══ BIRTHDATE MODAL ══ */
function showBirthdateModal(uid) {
    const maxDate = new Date();
    maxDate.setFullYear(maxDate.getFullYear() - 13);
    const maxStr = maxDate.toISOString().split('T')[0];

    const overlay = document.createElement('div');
    overlay.id = 'birthdateOverlay';
    overlay.style.cssText = `
        position:fixed;inset:0;z-index:999999;
        background:rgba(0,0,0,0.92);
        backdrop-filter:blur(12px);
        display:flex;align-items:center;justify-content:center;
        padding:20px;font-family:'Cairo',sans-serif;
    `;
    overlay.innerHTML = `
        <div style="
            background:linear-gradient(145deg,#0e0e0e,#1a0010);
            border:1px solid rgba(248,5,102,0.3);
            border-radius:28px;padding:32px 24px 28px;
            text-align:center;max-width:340px;width:100%;
            box-shadow:0 0 60px rgba(248,5,102,0.15);
            position:relative;overflow:hidden;
        ">
            <div style="position:absolute;inset:0;background:radial-gradient(circle at 50% 0%,rgba(248,5,102,0.08),transparent 65%);pointer-events:none;"></div>
            <div style="font-size:52px;margin-bottom:14px;">🎂</div>
            <div style="font-size:18px;font-weight:900;color:#fff;margin-bottom:8px;">
                أكمل بياناتك
            </div>
            <div style="font-size:13px;color:#888;line-height:1.8;margin-bottom:22px;">
                نحتاج تاريخ ميلادك لإكمال ملفك الشخصي<br>
                <span style="color:#f80566;font-size:11px;">يجب أن تكون 13 سنة أو أكثر</span>
            </div>
            <input type="date" id="modalBirthdate" max="${maxStr}"
                style="
                    width:100%;padding:13px 16px;
                    background:rgba(255,255,255,0.05);
                    border:1px solid rgba(255,255,255,0.1);
                    border-radius:16px;color:#fff;
                    font-family:'Cairo',sans-serif;font-size:14px;
                    outline:none;margin-bottom:8px;
                    color-scheme:dark;
                    transition:border-color 0.25s;
                "
                oninput="checkModalAge(this)"
            >
            <div id="modalAgeLabel" style="font-size:11px;color:#666;margin-bottom:18px;min-height:16px;"></div>
            <button onclick="saveBirthdate('${uid}')"
                id="saveBirthdateBtn"
                style="
                    width:100%;padding:14px;
                    background:linear-gradient(135deg,#f80566,#c4024e);
                    color:#fff;border:none;border-radius:50px;
                    font-family:'Cairo',sans-serif;font-size:15px;
                    font-weight:800;cursor:pointer;
                    box-shadow:0 6px 20px rgba(248,5,102,0.35);
                    opacity:0.4;pointer-events:none;
                    transition:opacity 0.25s;
                ">
                حفظ والمتابعة 🎉
            </button>
        </div>
    `;
    document.body.appendChild(overlay);
}

function checkModalAge(input) {
    const birth = new Date(input.value);
    const today = new Date();
    let age = today.getFullYear() - birth.getFullYear();
    const m = today.getMonth() - birth.getMonth();
    if (m < 0 || (m === 0 && today.getDate() < birth.getDate())) age--;
    const label = document.getElementById('modalAgeLabel');
    const btn   = document.getElementById('saveBirthdateBtn');
    if (!input.value || isNaN(age)) {
        label.textContent = '';
        btn.style.opacity = '0.4';
        btn.style.pointerEvents = 'none';
        return;
    }
    if (age < 13) {
        label.textContent = '⚠️ يجب أن تكون 13 سنة أو أكثر';
        label.style.color = '#f80566';
        btn.style.opacity = '0.4';
        btn.style.pointerEvents = 'none';
    } else {
        label.textContent = `✅ عمرك ${age} سنة`;
        label.style.color = '#4ade80';
        btn.style.opacity = '1';
        btn.style.pointerEvents = 'auto';
    }
}

async function saveBirthdate(uid) {
    const input = document.getElementById('modalBirthdate');
    const btn   = document.getElementById('saveBirthdateBtn');
    if (!input.value) return;
    btn.innerHTML = '<div class="loader" style="width:20px;height:20px;border-width:2px;"></div>';
    btn.style.pointerEvents = 'none';
    try {
        await db.collection('users').doc(uid).update({
    birthdate: input.value,
    birthdayMMDD: input.value.slice(5).replace('-', ''),
    birthdateAddedAt: firebase.firestore.FieldValue.serverTimestamp()
});
        const overlay = document.getElementById('birthdateOverlay');
        overlay.style.opacity = '0';
        overlay.style.transition = 'opacity 0.3s';
        setTimeout(() => {
            overlay.remove();
            // ── Streak Toast ──
const streakVal = updates.streak || userData.streak || 1;
if (streakVal >= 2) {
  const msgs = {
    2:  '🔥 يومان متتاليان! استمر!',
    3:  '🔥 3 أيام streak! أنت على الطريق!',
    7:  '🔥 أسبوع كامل! مذهل!',
    14: '🔥 14 يوم متواصل! أنت نجم!',
    30: '🔥 شهر كامل! أسطورة!',
  };
  const msg = msgs[streakVal] || `🔥 أنت على streak ${streakVal} أيام، لا تكسره!`;
  localStorage.setItem('pendingStreakToast', msg);
}
window.location.replace('index.html');
        }, 300);
    } catch(e) {
        showToast('حدث خطأ، حاول مجدداً', 'error');
        btn.textContent = 'حفظ والمتابعة 🎉';
        btn.style.pointerEvents = 'auto';
    }
}

/* ══ BAD WORDS ══ */
let _badWords = [];
async function loadBadWords() {
  try {
    const results = await Promise.all(
      ['ar','en','fr'].map(l => fetch(`bad_words/${l}.txt`).then(r => r.ok ? r.text() : '').catch(() => ''))
    );
    _badWords = results.join('\n').split('\n').map(w => w.trim().toLowerCase()).filter(Boolean);
  } catch(e) {}
}
function containsBadWord(text) {
  if (!text || !_badWords.length) return false;
  const lower = text.toLowerCase();
  return _badWords.some(w => lower.includes(w));
}

/* ══ Helpers ══ */
const cleanInput = v => typeof v !== 'string' ? '' : v.trim().slice(0,200).replace(/[<>'"\\\/\x00-\x1F\x7F]/g,'');
const escapeHtml = s => String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;').replace(/'/g,'&#039;');
const toggleAuth = () => {
  document.getElementById('signin-section').classList.toggle('hidden');
  document.getElementById('signup-section').classList.toggle('hidden');
};

const BLOCKED_DOMAINS = new Set(['mailinator.com','guerrillamail.com','guerrillamail.net','guerrillamail.org','guerrillamail.biz','guerrillamail.de','guerrillamail.info','sharklasers.com','grr.la','guerrillamailblock.com','spam4.me','trashmail.com','trashmail.me','trashmail.net','trashmail.org','trashmail.io','trashmail.at','trashmail.xyz','tempmail.com','temp-mail.org','temp-mail.io','tempinbox.com','tempr.email','dispostable.com','mailnull.com','spamgourmet.com','spamgourmet.net','yopmail.com','yopmail.fr','fakeinbox.com','mailnesia.com','maildrop.cc','getnada.com','mailsac.com','mohmal.com','mintemail.com','10minutemail.com','10minutemail.net','10minutemail.org','throwaway.email','throwam.com','discard.email','discardmail.com','spamspot.com']);

const ALLOWED_DOMAINS = new Set(['gmail.com','googlemail.com','outlook.com','outlook.sa','outlook.ae','outlook.fr','outlook.de','hotmail.com','hotmail.co.uk','hotmail.fr','hotmail.de','hotmail.it','hotmail.es','live.com','live.co.uk','live.fr','live.de','msn.com','yahoo.com','yahoo.co.uk','yahoo.co.in','yahoo.com.ar','yahoo.com.au','yahoo.com.br','yahoo.fr','yahoo.de','ymail.com','rocketmail.com','icloud.com','me.com','mac.com','proton.me','protonmail.com','protonmail.ch','pm.me','zoho.com','zohomail.com','mail.ru','inbox.ru','bk.ru','yandex.ru','yandex.com','ya.ru','gmx.com','gmx.net','gmx.de','web.de','freenet.de','t-online.de','laposte.net','orange.fr','free.fr','sfr.fr','libero.it','mail.com','email.com','aol.com','cox.net','comcast.net','att.net','verizon.net','qq.com','163.com','126.com','sina.com','naver.com','tutanota.com','tutamail.com','tuta.io','fastmail.com','fastmail.fm','mailfence.com','startmail.com','maktoob.com']);

function isValidEmail(e) {
  if (!e || e.length > 254) return false;
  if (!/^[^\s@]{1,64}@[^\s@]{1,253}\.[^\s@]{2,}$/.test(e)) return false;
  const domain = e.split('@')[1]?.toLowerCase();
  if (!domain) return false;
  if (BLOCKED_DOMAINS.has(domain)) return false;
  if (!ALLOWED_DOMAINS.has(domain)) return false;
  return true;
}

/* ══ Toast ══ */
let _toastTimer = null;
function showToast(msg, type = 'error', duration = 3000) {
  const icons  = { error:'⛔', success:'✅', info:'💡' };
  const colors = { error:'#f80566', success:'#4ade80', info:'#60a5fa' };
  const toast  = document.getElementById('toast');
  toast.className = `show t-${type}`;
  document.getElementById('toastText').textContent = msg;
  document.querySelector('#toast .t-icon').textContent = icons[type] || 'ℹ️';
  const bar = document.getElementById('toastBar');
  bar.style.background = colors[type] || '#f80566';
  bar.style.animation  = 'none';
  bar.offsetHeight;
  bar.style.animation  = `shrink ${duration/1000}s linear forwards`;
  if (_toastTimer) clearTimeout(_toastTimer);
  _toastTimer = setTimeout(() => toast.classList.remove('show'), duration);
}

/* ══ BIRTHDATE PICKER ══ */
let _bdDay = 1, _bdMonth = 1, _bdYear = 2000;

function bdPad(n) { return String(n).padStart(2,'0'); }

function bdDaysInMonth(m, y) { return new Date(y, m, 0).getDate(); }

function bdChange(field, delta) {
  const maxYear = new Date().getFullYear() - 13;
  if (field === 'day') {
    const maxDay = bdDaysInMonth(_bdMonth, _bdYear);
    _bdDay += delta;
    if (_bdDay < 1) _bdDay = maxDay;
    if (_bdDay > maxDay) _bdDay = 1;
  } else if (field === 'month') {
    _bdMonth += delta;
    if (_bdMonth < 1) _bdMonth = 12;
    if (_bdMonth > 12) _bdMonth = 1;
    const maxDay = bdDaysInMonth(_bdMonth, _bdYear);
    if (_bdDay > maxDay) _bdDay = maxDay;
  } else if (field === 'year') {
    _bdYear += delta;
    if (_bdYear < 1950) _bdYear = 1950;
    if (_bdYear > maxYear) _bdYear = maxYear;
    const maxDay = bdDaysInMonth(_bdMonth, _bdYear);
    if (_bdDay > maxDay) _bdDay = maxDay;
  }
  document.getElementById('bdDay').textContent   = bdPad(_bdDay);
  document.getElementById('bdMonth').textContent = bdPad(_bdMonth);
  document.getElementById('bdYear').textContent  = _bdYear;
  updateBdAgeLabel();
}

function getBdAge() {
  const today = new Date();
  let age = today.getFullYear() - _bdYear;
  const m = today.getMonth() + 1 - _bdMonth;
  if (m < 0 || (m === 0 && today.getDate() < _bdDay)) age--;
  return age;
}

function getBirthdateString() {
  return `${_bdYear}-${bdPad(_bdMonth)}-${bdPad(_bdDay)}`;
}

function updateBdAgeLabel() {
  const age = getBdAge();
  const lang = getLang();
  const el = document.getElementById('bdAgeLabel');
  if (!el) return;
  if (age < 13) {
    const msgs = { ar:'⚠️ يجب أن تكون 13 سنة أو أكثر', en:'⚠️ Must be at least 13 years old', fr:'⚠️ Vous devez avoir au moins 13 ans' };
    el.textContent = msgs[lang] || msgs.ar;
    el.style.color = '#f80566';
  } else {
    const msgs = { ar:`✅ عمرك ${age} سنة`, en:`✅ Age: ${age}`, fr:`✅ Âge: ${age}` };
    el.textContent = msgs[lang] || msgs.ar;
    el.style.color = '#4ade80';
  }
}

/* ══ Privacy Modal ══ */
let _privacyAccepted = false;
const PRIVACY_CONTENT = {
  ar: {
    title: "🔒 سياسة الخصوصية والشروط",
    accept: "✅ أوافق على السياسة",
    body: `
      <h4>📋 مقدمة</h4>
      <p>مرحباً بك في منصة <strong style="color:#fff">Anon HT</strong>. باستخدامك للمنصة فأنت توافق على هذه السياسة وشروط الاستخدام.</p>
      <h4>📦 البيانات التي نجمعها</h4>
      <ul>
        <li>الاسم الكامل وعنوان البريد الإلكتروني</li>
        <li>رقم الهاتف (للتحقق من الهوية فقط)</li>
        <li>تاريخ الميلاد والجنس (لتخصيص التجربة)</li>
        <li>بيانات الاستخدام وتفضيلات التطبيق</li>
        <li>عنوان IP والجهاز المستخدم (لأغراض الأمان)</li>
        <li>ملفات الكوكيز وبيانات التتبع من Google وFirebase</li>
      </ul>
      <h4>🔐 كيف نحمي بياناتك</h4>
      <p>تُحفظ جميع بياناتك مشفرة على خوادم Firebase الآمنة من Google. نستخدم Cloudinary لتخزين الصور بأمان. لا نبيع بياناتك لأي طرف ثالث.</p>
      <h4>🍪 الكوكيز والتتبع</h4>
