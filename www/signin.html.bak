<script>
window.addEventListener('load', function() {
  setTimeout(function() {
    var ads = [
      { id: 'header-ad-placeholder', slot: '5299327669' },
      { id: 'footer-ad-placeholder', slot: '5299327669' },
      { id: 'ad1', slot: '5299327669' },
      { id: 'ad2', slot: '5299327669' },
      { id: 'ad3', slot: '5299327669' }
    ];
    ads.forEach(function(ad) {
      var slot = document.getElementById(ad.id);
      if (!slot) return;
      slot.style.display = 'none';
      var ins = document.createElement('ins');
      ins.className = 'adsbygoogle';
      ins.style.cssText = 'display:block;width:100%;';
      ins.setAttribute('data-ad-client', 'ca-pub-9442350195298931');
      ins.setAttribute('data-ad-slot', ad.slot);
      ins.setAttribute('data-ad-format', 'auto');
      ins.setAttribute('data-full-width-responsive', 'true');
      slot.appendChild(ins);
      try { (window.adsbygoogle = window.adsbygoogle || []).push({}); } catch(e) {}
      var checks = 0;
      var observer = setInterval(function() {
        checks++;
        var filled = ins.getAttribute('data-ad-status') === 'filled' || ins.offsetHeight > 10;
        var unfilled = ins.getAttribute('data-ad-status') === 'unfilled' || checks > 20;
        if (filled) { slot.style.display = 'block'; slot.style.margin = '8px auto'; clearInterval(observer); }
        else if (unfilled) { slot.style.display = 'none'; clearInterval(observer); }
      }, 500);
    });
  }, 500);
});
/* ══ DESKTOP LAYOUT INIT ══ */
function initDesktopLayout() {
  const isDesktop = window.innerWidth >= 1100;
  const layout = document.getElementById('desktopLayout');
  if (!layout) return;
  layout.style.display = isDesktop ? 'flex' : 'none';
  if (isDesktop) {
    layout.style.flexDirection = 'row';
    layout.style.width = '100%';
    layout.style.minHeight = '100vh';
    layout.style.alignItems = 'stretch';
    // تفعيل إعلانات الـ desktop
    setTimeout(() => {
      document.querySelectorAll('#desktopAdBox1 ins').forEach(ins => {
        try { (window.adsbygoogle = window.adsbygoogle || []).push({}); } catch(e) {}
      });
    }, 1000);
  }
}

/* دوال الـ desktop auth */
function toggleAuthD() {
  const signinD = document.getElementById('d-signin-section');
  const isHidden = signinD.classList.contains('hidden');
  if (!isHidden) {
    signinD.classList.add('hidden');
    document.querySelector('.main-wrapper').style.display = 'flex';
    document.getElementById('signin-section').classList.add('hidden');
    document.getElementById('signup-section').classList.remove('hidden');
    document.getElementById('signup-section').scrollIntoView({behavior:'smooth', block:'center'});
  } else {
    signinD.classList.remove('hidden');
    document.getElementById('signup-section').classList.add('hidden');
    document.getElementById('signin-section').classList.remove('hidden');
    document.querySelector('.main-wrapper').style.display = 'none';
  }
}

async function handleLoginD() {
  // نسخ نفس منطق handleLogin بس بـ ids تبدأ بـ d-
  const email = document.getElementById('d-loginEmail').value.trim();
  const pass  = document.getElementById('d-loginPass').value;
  const btn   = document.getElementById('d-loginBtn');

  // نفّذ نفس الـ handleLogin الأصلي بعد وضع القيم في الـ fields الأصلية
  document.getElementById('loginEmail').value = email;
  document.getElementById('loginPass').value  = pass;
  handleLogin();

  // sync حالة الزر
  const originalBtn = document.getElementById('loginBtn');
  const observer = new MutationObserver(() => {
    btn.disabled  = originalBtn.disabled;
    btn.innerHTML = originalBtn.innerHTML;
  });
  observer.observe(originalBtn, { attributes: true, childList: true });
  setTimeout(() => observer.disconnect(), 10000);
}

async function openResetModalD() {
  const email = document.getElementById('d-loginEmail').value.trim();
  document.getElementById('loginEmail').value = email;
  openResetModal();
}

function toggleLangMenuD() {
  const menu = document.getElementById('langMenuD');
  const btn  = document.getElementById('langActiveBtnD');
  const open = menu.classList.contains('open');
  menu.classList.toggle('open', !open);
  btn.classList.toggle('open', !open);
}

function selectLangD(lang) {
  document.getElementById('langMenuD').classList.remove('open');
  document.getElementById('langActiveBtnD').classList.remove('open');
  if (typeof LangManager !== 'undefined') LangManager.set(lang);
  const sel = document.getElementById('regLang');
  if (sel) sel.value = lang;
  // sync checks
  ['ar','en','fr','es','tr'].forEach(l => {
    const el = document.getElementById('dcheck-' + l);
    if (el) el.textContent = l === lang ? '✓' : '';
  });
  const label = document.getElementById('langCurrentLabelD');
  if (label) label.textContent = lang.toUpperCase();
}

document.addEventListener('click', e => {
  if (!e.target.closest('#langSwitcherD')) {
    document.getElementById('langMenuD')?.classList.remove('open');
    document.getElementById('langActiveBtnD')?.classList.remove('open');
  }
});
</script>
